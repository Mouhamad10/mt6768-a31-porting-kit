diff --git a/arch/arm64/configs/a31_defconfig b/arch/arm64/configs/a31_defconfig
index 968f3fe4e..2e4a7cb8c 100644
--- a/arch/arm64/configs/a31_defconfig
+++ b/arch/arm64/configs/a31_defconfig
@@ -1443,7 +1443,6 @@ CONFIG_MTK_STATIC_POWER=y
