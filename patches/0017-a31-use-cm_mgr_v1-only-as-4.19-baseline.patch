---
 arch/arm64/configs/a31_4.19.fragment | 1 +
 arch/arm64/configs/a31_defconfig     | 2 +-
 2 files changed, 2 insertions(+), 1 deletion(-)

diff --git a/arch/arm64/configs/a31_4.19.fragment b/arch/arm64/configs/a31_4.19.fragment
index 82a590af5..3dc51ea24 100644
--- a/arch/arm64/configs/a31_4.19.fragment
+++ b/arch/arm64/configs/a31_4.19.fragment
