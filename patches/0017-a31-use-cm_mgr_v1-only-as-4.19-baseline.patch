 # CONFIG_MTK_SLBC is not set
 # CONFIG_MTK_SLBC_MMSRAM is not set
-CONFIG_MTK_CM_MGR=y
 # CONFIG_MTK_SWPM is not set
 # CONFIG_MTK_QOS_FRAMEWORK is not set
 CONFIG_MTK_QOS_V1=y
@@ -6044,3 +6043,4 @@ CONFIG_STACKPROTECTOR_STRONG=y
 CONFIG_A31_LEGACY_TIMER_API=y
 # CONFIG_MTK_EMMC_HW_CQ is not set
 # CONFIG_SEC_DEBUG_AUTO_COMMENT is not set
+# CONFIG_MTK_CM_MGR is not set
