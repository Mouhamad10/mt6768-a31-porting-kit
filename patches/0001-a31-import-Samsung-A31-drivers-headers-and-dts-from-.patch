+#if (TEMP_COMPEN) || (BATCAP_LEARN)
+	bool bat_charging; /* battery is charging */
+#endif
+#if (TEMP_COMPEN) && (BATCAP_LEARN)
+	int fcc;
+	int rmc;
+#endif
+#if (TEMP_COMPEN)
+	bool vm_status; /* Now voltage mode or not */
