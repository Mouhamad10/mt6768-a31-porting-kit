+		if (tx[0] == 0xAA) {
+			pr_info("tx[0] == 0xAA, try_time = %d\n", try_time);
+			break;
+		}
+		usleep_range(10, 20);
+		try_time++;
+	}
+	if (try_time >= 2000)
+		pr_err("-------------    try_time >= 2000    ---------------\n");
+
+	return retval;
