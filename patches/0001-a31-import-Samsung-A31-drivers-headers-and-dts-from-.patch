+	UH_APP_RKP = UH_APPID(APP_RKP),
+	UH_APP_KDP = UH_APPID(APP_KDP),
+	UH_APP_HDM = UH_APPID(APP_HDM),
+};
+#else
+enum __UH_APP_ID {
+	UH_APP_INIT     = UH_APPID(APP_INIT),
+	UH_APP_SAMPLE   = UH_APPID(APP_SAMPLE),
+	UH_APP_RKP      = UH_APPID(APP_RKP),
+	UH_APP_HDM	= UH_APPID(APP_HDM)
