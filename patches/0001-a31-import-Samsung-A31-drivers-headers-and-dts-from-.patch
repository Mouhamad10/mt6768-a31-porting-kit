+	if (++data->diff_cnt >= ISG5320A_DIFF_AVR_CNT) {
+		data->diff_avg = data->diff_sum / ISG5320A_DIFF_AVR_CNT;
+		data->cdc_avg = data->cdc_sum / ISG5320A_DIFF_AVR_CNT;
+		data->diff_cnt = 0;
+	}
