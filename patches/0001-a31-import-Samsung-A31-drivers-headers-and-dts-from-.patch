+	sec_cmd_set_cmd_result(sec, buf, strnlen(buf, sizeof(buf)));
+	sec->cmd_state = SEC_CMD_STATUS_OK;
+
+	input_info(true, &data->client->dev, "%s: %s(%d)\n", __func__, buf,
+			strnlen(buf, sizeof(buf)));
