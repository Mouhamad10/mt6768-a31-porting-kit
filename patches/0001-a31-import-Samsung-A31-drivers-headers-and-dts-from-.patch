+	PM_WATER_SEN_CNT_MAX,
+};
+
+#define HYST_LEV_VCHGIN_SHIFT	4
+#define HYST_LEV_VCHGIN_MASK	0x70
+
+enum {
+	HYST_LEV_VCHGIN_80mV	=	0x1,
+	HYST_LEV_VCHGIN_160mV	=	0x2,
+	HYST_LEV_VCHGIN_320mV	=	0x3,
+	HYST_LEV_VCHGIN_640mV	=	0x4,
