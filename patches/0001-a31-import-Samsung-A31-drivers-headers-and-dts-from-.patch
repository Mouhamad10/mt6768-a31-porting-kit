+#elif IS_ENABLED(CONFIG_PDIC_S2MU205)
+	struct s2mu205_usbpd_data *pdic_data = pd_data->phy_driver_data;;
+#elif IS_ENABLED(CONFIG_PDIC_S2MU107)
+	struct s2mu107_usbpd_data *pdic_data = pd_data->phy_driver_data;;
+#endif
+
+	/**********************************************
+	Actions on entry:
+	Request DPM to evaluate request to enter a Mode
+	**********************************************/
+
+	dev_info(pd_data->dev, "khos %s\n", __func__);
+
+	usbpd_manager_enter_mode(pd_data);
+	if (manager->Standard_Vendor_ID == SAMSUNG_VENDOR_ID) {
+		/* Standard Vendor ID */
+		pdic_event_work(pdic_data, PDIC_NOTIFY_DEV_ALL,
+			PDIC_NOTIFY_ID_SVID_INFO, manager->Standard_Vendor_ID/*Standard Vendor ID*/, 0, 0);
+	}
+
+	/* Certification: Ellisys: TD.PD.VDMU.E15.Applicability */
+	if (usbpd_manager_get_svids(pd_data) == 0)
+		return PE_UFP_VDM_Mode_Entry_ACK;
+	else
+		return PE_UFP_VDM_Mode_Entry_NAK;
+
+	/* Todo
+	check DPM evaluate request to enter a mode
+	*/
+/*
+	if (usbpd_manager_enter_mode(pd_data, mode_pos,
+				mode_vdo) == 0)
+		return PE_UFP_VDM_Mode_Entry_ACK;
+	else
+		return PE_UFP_VDM_Mode_Entry_NAK;
+*/
+	return PE_UFP_VDM_Evaluate_Mode_Entry;
+}
