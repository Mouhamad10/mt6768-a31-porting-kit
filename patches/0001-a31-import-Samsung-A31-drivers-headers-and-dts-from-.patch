@@ -0,0 +1,57 @@
+#ifndef __UH_H__
+#define __UH_H__
+
+#ifndef __ASSEMBLY__
+
+/* For uH Command */
+#ifdef CONFIG_RUSTUH_RKP
+#define APP_INIT	0
+#define APP_RKP		1
+#define APP_KDP		2
+#define APP_HDM		6
+#else
+#define	APP_INIT	0
+#define	APP_SAMPLE	1
+#define APP_RKP		2
+#define APP_HDM		6
+#endif
+
+#define UH_PREFIX  UL(0x83000000)
+#define UH_APPID(APP_ID)  (((UL(APP_ID) << 8) & UL(0xFF00)) | UH_PREFIX)
+
+#define GZ_HVC_TEST    0x70
+#define GZ_MM_MAP_TEST     0x71
+#define GZ_MM_UNMAP_TEST     0x72
+
+#ifdef CONFIG_RUSTUH_RKP
+enum __UH_APP_ID {
