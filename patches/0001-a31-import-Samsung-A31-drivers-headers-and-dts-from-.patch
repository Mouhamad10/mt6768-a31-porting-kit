+#ifdef ENABLE_SENSORS_FPRINT_SECURE
+	if (clk_setting->enabled_clk) {
+		clk_disable_unprepare(clk_setting->fp_spi_sclk);
+		__pm_relax(clk_setting->spi_wake_lock);
+		clk_setting->enabled_clk = false;
+		pr_debug("DISABLE_SPI_CLOCK\n");
+	}
+#endif
+
+	return 0;
+}
