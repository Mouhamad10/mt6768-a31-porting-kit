+int et7xx_io_transfer_command(struct et7xx_data *etspi, u8 *tx, u8 *rx,
+								u32 size)
+{
+#ifdef ENABLE_SENSORS_FPRINT_SECURE
+	return 0;
+#else
+	int retval = 0;
+	struct spi_message m;
