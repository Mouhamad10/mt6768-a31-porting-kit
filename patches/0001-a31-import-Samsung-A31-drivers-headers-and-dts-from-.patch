+	u8 temp1, temp2;
+
+	isg5320a_i2c_read(data, ISG5320A_ANALOG_GAIN, &buff, 1);
+	temp1 = (buff & 0x38) >> 3;
+	temp2 = (buff & 0x07);
+
+	return snprintf(buf, PAGE_SIZE, "%d/%d\n", (int)temp2 + 1, (int)temp1 + 1);
+}
