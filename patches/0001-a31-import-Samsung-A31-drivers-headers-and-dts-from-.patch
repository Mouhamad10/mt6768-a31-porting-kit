+
+#if LINUX_VERSION_CODE < KERNEL_VERSION(5, 11, 0)
+static u64 bdev_nr_sectors(struct block_device *bdev)
+{
+	struct hd_struct *part = bdev->bd_part;
+
+	if (!part)
+		return 0;
+
+	return (u64)(part->nr_sects);
+}
+#endif
