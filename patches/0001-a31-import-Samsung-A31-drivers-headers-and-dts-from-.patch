+int ist40xx_check_valid_ch(struct ist40xx_data *data, int ch_tx, int ch_rx)
+{
+	TSP_INFO *tsp = &data->tsp_info;
+
+	if ((ch_tx < 0) || (ch_tx >= tsp->ch_num.tx) || (ch_rx < 0) ||
+			(ch_rx >= tsp->ch_num.rx))
+		return TSP_CH_UNKNOWN;
+
+	return TSP_CH_USED;
+}
