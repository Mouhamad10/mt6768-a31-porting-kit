+		return ret;
+	}
+
+	data->grip_raw_2ch = (r_buf[0] << 8) | r_buf[1];
+	data->grip_raw_d_2ch = (r_buf[2] << 8) | r_buf[3];
+
+	GRIP_INFO("2ch grip_raw = %d\n", data->grip_raw_2ch);
+
+	return ret;
+}
