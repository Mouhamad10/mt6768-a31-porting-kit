diff --git a/drivers/security/samsung/icdrv/qsee_oemflag.c b/drivers/security/samsung/icdrv/qsee_oemflag.c
new file mode 100644
index 000000000..92ef7fd02
--- /dev/null
+++ b/drivers/security/samsung/icdrv/qsee_oemflag.c
@@ -0,0 +1,86 @@
+/*
+ * Set OEM flags
+ *
+ * Copyright (C) 2018 Samsung Electronics, Inc.
+ * Jonghun Song, <justin.song@samsung.com>
+ * Egor Ulesykiy, <e.uelyskiy@samsung.com>
+ *
