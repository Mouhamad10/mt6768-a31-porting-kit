+	PDIC_NOTIFY_EVENT_PDIC_ATTACH,
+	PDIC_NOTIFY_EVENT_PD_SINK,
+	PDIC_NOTIFY_EVENT_PD_SOURCE,
+	PDIC_NOTIFY_EVENT_PD_SINK_CAP,
