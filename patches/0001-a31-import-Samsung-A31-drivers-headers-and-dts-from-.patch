+static void __sdfat_do_truncate(struct inode *inode, loff_t old, loff_t new)
+{
+	down_write(&SDFAT_I(inode)->truncate_lock);
+	truncate_setsize(inode, new);
+	sdfat_truncate(inode, old);
+	up_write(&SDFAT_I(inode)->truncate_lock);
