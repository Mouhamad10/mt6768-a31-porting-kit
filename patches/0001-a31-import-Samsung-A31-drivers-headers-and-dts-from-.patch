+	target_count = &usblog_root.usblog_vm_buffer->pcm_count;
+	target_index = &usblog_root.usblog_vm_buffer->pcm_index;
+	pcm_buffer = &usblog_root.usblog_vm_buffer->pcm_buffer[*target_index];
