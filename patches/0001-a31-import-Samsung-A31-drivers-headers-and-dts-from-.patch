+		}
+	} else if (battery->chg_limit && is_hv_wire_type(battery->cable_type) &&
+			(battery->chg_temp <= battery->pdata->chg_high_temp_recovery)) {
+		sec_vote(battery->fcc_vote, VOTER_AFC_TEMP, false, 0);
