+
+choice
+    prompt "IC Secure OS"
+    depends on TZIC
+    default TZIC_USE_QSEECOM if QSEECOM
+    default TZIC_USE_TZDEV if TZDEV
+    default TZIC_USE_TRUSTONIC if TRUSTONIC_TEE || TRUSTONIC_TEE_SUPPORT
