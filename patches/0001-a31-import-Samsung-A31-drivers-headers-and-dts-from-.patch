+			GRIP_ERR("failed to load firmware (%d)\n",
+				data->firmware_count);
+			schedule_delayed_work(&data->firmware_work,
+					msecs_to_jiffies(1000));
+			return;
+		}
+		GRIP_ERR("final retry failed\n");
+	} else {
+		GRIP_INFO("fw check success\n");
+	}
+}
