+#define S2MU106_REG_PD_PU_LPM_CTRL_DIS_MASK \
+	(0x1 << S2MU106_REG_PD_PU_LPM_CTRL_DIS_SHIFT)
+#define S2MU106_REG_PD2_RS_SW_ON_MASK    (0x1 << S2MU106_REG_PD2_RS_SW_ON_SHIFT)
