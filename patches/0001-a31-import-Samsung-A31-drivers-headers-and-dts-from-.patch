+	if (reserve_bootmem(base, size, BOOTMEM_EXCLUSIVE)) {
+#endif
+		/* size is not match with -size and size + sizeof(...) */
+		pr_err("%s: failed to reserve size:0x%lx at base 0x%lx\n",
