+			bias-pull-down;
+			output-low;
+			drive-strength = <1>;
+		};
+	};
+	spi1_clr_clk: clr_clk {
+		pins_cmd_dat{
+			pinmux = <MTK_PINMUX(SEC_GPIO_NUM(AP,pio,88), 0)>;
