+
+	muic_if->afc_water_disable = pnoti->attach ? true:false;
+	if (muic_if->set_water_detect)
+		muic_if->set_water_detect(muic_if->muic_data, muic_if->afc_water_disable);
+
+	pr_info("%s: Water detect : %s\n", __func__, pnoti->attach ? "en":"dis");
+
+	return 0;
+}
