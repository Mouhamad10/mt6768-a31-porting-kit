+		break;
+	case USB_CERTI_HOST_RESOURCE_EXCEED:
+		words = "WORDS=host_resource_exceed";
+		break;
+	case USB_CERTI_WARM_RESET:
+		if (!__ratelimit(&rs_warm_reset))
