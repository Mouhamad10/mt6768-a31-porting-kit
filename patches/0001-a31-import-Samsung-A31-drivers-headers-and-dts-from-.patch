+	return sprintf(buf, "%d%02d,%d,%d,%d,%d\n", (data->fine_coarse & 0xFF),
+		       ((data->fine_coarse >> 8) & 0x3F), data->cdc,
+		       data->fine_coarse, data->diff, data->base);
