+static int check_hallic_state(char *file_path, unsigned char hall_ic_status[])
+{
+	int ret = 0;
+	mm_segment_t old_fs;
+	struct file *filep;
+	u8 hall_sysfs[5];
+
+	old_fs = get_fs();
+	set_fs(KERNEL_DS);
+
+	filep = filp_open(file_path, O_RDONLY, 0440);
+	if (IS_ERR(filep)) {
+		ret = PTR_ERR(filep);
+		set_fs(old_fs);
+		goto exit;
+	}
+
+	ret = vfs_read(filep, hall_sysfs, sizeof(hall_sysfs),
+		       &filep->f_pos);
+
+	if (ret != sizeof(hall_sysfs))
+		ret = -EIO;
+	else
+		strncpy(hall_ic_status, hall_sysfs, sizeof(hall_sysfs));
+
+	filp_close(filep, current->files);
+	set_fs(old_fs);
+
+exit:
+	return ret;
+}
