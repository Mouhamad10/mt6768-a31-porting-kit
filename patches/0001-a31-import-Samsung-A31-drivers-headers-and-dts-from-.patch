+static ssize_t grip_reg_show(struct device *dev,
+	struct device_attribute *attr, char *buf)
+{
+	u8 val = 0;
+	int offset = 0, i = 0;
+	struct a96t3x6_data *data = dev_get_drvdata(dev);
