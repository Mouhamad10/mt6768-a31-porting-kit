+					VIRT_EVENT(NOTIFY_EVENT_HOST_RELOAD));
+			send_otg_notify(n,
+				VIRT_EVENT(NOTIFY_EVENT_HOST_RELOAD), 1);
+		}
+		break;
+	case NOTIFY_MDM_TYPE_OFF:
+		send_otg_notify(n, NOTIFY_EVENT_MDM_ON_OFF, 0);
+		break;
+	}
+}
