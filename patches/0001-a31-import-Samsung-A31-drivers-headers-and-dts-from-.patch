+		pp_data->water = PP_DRY;
+		PDIC_POLICY_SEND_NOTI(pp_data, PDIC_NOTIFY_DEV_BATT, PDIC_NOTIFY_ID_WATER,
+			0/*attach*/, 0, 0);
