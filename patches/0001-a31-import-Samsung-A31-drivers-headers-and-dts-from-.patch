+static int mtk_set_peripheral(bool enable)
+{
+	pr_info("%s enable %d +\n", __func__, enable);
+#if !IS_ENABLED(CONFIG_USB_MU3D_DRV)
+#if IS_ENABLED(CONFIG_MACH_MT6768) || IS_ENABLED(CONFIG_MACH_MT6739)
+	if (enable)
