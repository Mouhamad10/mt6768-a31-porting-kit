+static void a96t3x6_firmware_work_func(struct work_struct *work)
+{
+	struct a96t3x6_data *data = container_of((struct delayed_work *)work,
+		struct a96t3x6_data, firmware_work);
+
+	int ret;
+
+	GRIP_INFO("called\n");
