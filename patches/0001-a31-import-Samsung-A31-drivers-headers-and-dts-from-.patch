+					val = cmcs_buf->slope[jj * tsp->ch_num.rx + ii];
+				else if (type == LOG_CS)
+					val = cmcs_buf->cs[jj * tsp->ch_num.rx + ii];
+				else if (type == LOG_MISCAL)
+					val = node->miscal[jj * tsp->ch_num.rx + ii];
