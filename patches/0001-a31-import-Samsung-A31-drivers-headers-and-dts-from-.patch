+	pr_info("write_len = %d addrH = %x addrL = %x data = %x buf = %p\n",
+		write_len, val[0], val[1], val[2], buf);
+
+	tx[2] = val[0];
+	tx[3] = val[1];
+	tx[4] = val[2];
+	tx[5] = tx[0] + tx[1] + tx[2] + tx[3] + tx[4];
