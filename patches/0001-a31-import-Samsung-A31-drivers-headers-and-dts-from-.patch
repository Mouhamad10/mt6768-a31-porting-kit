+	return 0;
+}
+
+early_param("androidboot.revision", sec_hw_param_get_hw_rev);
+
+static int __init sec_hw_param_get_dram_info(char *arg)
+{
+	unsigned long dram_RevID1, dram_RevID2, dram_size;
