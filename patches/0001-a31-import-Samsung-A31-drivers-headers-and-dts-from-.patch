+
+	memset(auto_comment_info, 0, sizeof(struct sec_debug_auto_comment));
+
+	register_set_auto_comm_buf(sec_debug_hook_auto_comm);
+
+	pr_info("%s: done\n", __func__);
+
+	return 1;
+}
+
+#if 0
