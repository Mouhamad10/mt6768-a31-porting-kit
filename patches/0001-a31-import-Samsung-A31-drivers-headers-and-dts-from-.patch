+
+ /* usb notify layer v3.6 */
+
+ #define pr_fmt(fmt) "usb_notify: " fmt
+
+#include <linux/types.h>
+#include <linux/errno.h>
+#include <linux/time.h>
+#include <linux/ktime.h>
+#include <linux/rtc.h>
+#include <linux/kernel.h>
