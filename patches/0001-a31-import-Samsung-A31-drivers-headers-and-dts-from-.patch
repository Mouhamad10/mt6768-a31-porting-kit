+/*************************
+ * POWER DTSI File
+ *************************/
+/ {
+	fragment@smd {
+		target-path = "/";
+		__overlay__ {
+			fixed_regulator_grip_ldo {
+				compatible = "regulator-fixed";
+				regulator-name = "grip_ldo";
+				gpio = <&pio 43 0>;
+				enable-active-high;
+				skip-gpio-request;
+			};
+
+			fixed_regulator_sensor_ldo {
+				compatible = "regulator-fixed";
+				regulator-name = "sensor_ldo";
+				gpio = <&pio 178 0>;
+				enable-active-high;
+				skip-gpio-request;
+			};
+
+			fixed_regulator_btp_ldo {
+				compatible = "regulator-fixed";
+				regulator-name = "btp_ldo";
+				gpio = <&pio 77 0>;
+				enable-active-high;
+				skip-gpio-request;
+			};
+
+			fixed_regulator_rcam1_ldo {
+				compatible = "regulator-fixed";
+				regulator-name = "rcam1_ldo";
+				gpio = <&pio 98 0>;
+				enable-active-high;
+				skip-gpio-request;
+			};
+
+			fixed_regulator_lcd_en_3p0_ldo {
+				compatible = "regulator-fixed";
+				regulator-name = "lcd_en_3p0_ldo";
+				gpio = <&pio 153 0>;
+				enable-active-high;
+				skip-gpio-request;
