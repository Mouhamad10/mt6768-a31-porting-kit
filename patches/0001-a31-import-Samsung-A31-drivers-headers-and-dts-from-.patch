new file mode 100644
index 000000000..2c003e729
--- /dev/null
+++ b/drivers/samsung/debug/sec_debug_extra_info.c
@@ -0,0 +1,467 @@
+/*
+ *sec_debug_extrainfo.c
+ *
+ * Copyright (c) 2016 Samsung Electronics Co., Ltd
