+		pr_err("retval = %d\n", retval);
+		goto out;
+	}
+
+	if (copy_to_user(rx, (const u8 __user *)(uintptr_t)tr, size)) {
+		pr_err("buffer copy_to_user fail. tr(%p) rx(%p)\n", tr,
+		       rx);
+		retval = -EFAULT;
+		goto out;
+	}
+
+out:
+	kfree(tr);
+	return retval;
+#endif
