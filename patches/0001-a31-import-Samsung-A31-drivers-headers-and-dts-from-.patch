+	usblog_get_rt(&pcm_buffer->rt);
+	pcm_buffer->ts_nsec = local_clock();
+	pcm_buffer->type = type;
+	pcm_buffer->enable = *param1;
+
+	*target_index = (*target_index+1)%USBLOG_PCM_BUFFER_SIZE;
