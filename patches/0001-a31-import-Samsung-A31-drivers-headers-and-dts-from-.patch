+			break;
+		ms = usbpd_check_time1(pd_data);
+		if (pd_data->phy_ops.get_status(pd_data, MSG_GOODCRC)) {
+			ret = PE_SNK_Ready;
+			break;
+		}
+
+		if (ms >= 10) {
+			ret = PE_SNK_Send_Soft_Reset;
+			break;
