+
+	if (fg_reset)
+		sec_bat_set_current_event(battery, SEC_BAT_CURRENT_EVENT_FG_RESET,
+			SEC_BAT_CURRENT_EVENT_FG_RESET);
+
+	if (battery->pdata->charger_name == NULL)
