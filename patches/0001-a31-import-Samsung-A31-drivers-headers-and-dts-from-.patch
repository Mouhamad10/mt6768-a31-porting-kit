+
+/**
+ * Length/Value structure
+ */
+struct lv {
+	uint16_t length;
+	uint8_t value[];
+} __packed;
+
+/**
+ * Returns the next element from the chain of LV (length/value) data.
+ * Returns NULL in a case of memory limits violation
