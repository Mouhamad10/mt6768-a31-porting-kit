+{
+#if IS_ENABLED(CONFIG_MUIC_NOTIFIER)
+	muic_notifier_unregister(&dock_notifier_block);
+#endif /* CONFIG_MUIC_NOTIFIER */
+
+	pr_info("%s: done\n", __func__);
+}
