+static int lis2ds_set_tilt_degree(struct lis2ds_data *cdata) {
+	u8 value = 0x00;
+
+	if (cdata->tilt_delay == PROTOS_MOTION_MAGIC_CODE) {
+		SENSOR_INFO("tilt degree : protos motion(12)\n");
+		// Set 12 degree
+		value = 0x7D;
+	} else if ((cdata->tilt_degree < TILT_DEGREE_25) || (cdata->tilt_degree > TILT_DEGREE_45)) {
+		SENSOR_INFO("tilt degree : default(35)\n");
+		// Set 35 degree
+		value = 0x69;
+	} else
+		value = degree_tb[cdata->tilt_degree - TILT_DEGREE_TB_BASE];
+
+	return value;
+}
+
+static int lis2ds_set_tilt_variant(struct lis2ds_data *cdata) {
+	int err;
+	u8 data = 0;
+
+	// using hidden register
+	err = cdata->tf->read(cdata, 0x21, 1, &data, true);
+	//SENSOR_INFO("tilt varian(%d): read 0x21: 0x%02x\n", err, data);
+	data |= 0x10;
+	cdata->tf->write(cdata, 0x21, 1, &data, true);
+	//SENSOR_INFO("tilt varian(%d): write 0x21: 0x%02x\n", err, data);
+
+	// Minimum angle is 12 degree. value is 0x7D.
+	err = cdata->tf->read(cdata, 0x36, 1, &data, true);
+	//SENSOR_INFO("tilt varian(%d): read 0x36: 0x%02x\n", err, data);
+	data = lis2ds_set_tilt_degree(cdata);
+	cdata->tf->write(cdata, 0x36, 1, &data, true);
+	//SENSOR_INFO("tilt varian(%d): write 0x36: 0x%02x\n", err, data);
+
+	// latency set to 40ms
+	err = cdata->tf->read(cdata, 0x37, 1, &data, true);
+	//SENSOR_INFO("tilt varian(%d): read 0x37: 0x%02x\n", err, data);
+	if (cdata->tilt_delay == PROTOS_MOTION_MAGIC_CODE)
+		data = 0x00;
+	else
+		data = 0x32;
+	cdata->tf->write(cdata, 0x37, 1, &data, true);
+	//SENSOR_INFO("tilt varian(%d): write 0x37: 0x%02x\n", err, data);
+
+	err = cdata->tf->read(cdata, 0x3F, 1, &data, true);
+	//SENSOR_INFO("tilt varian(%d): read 0x3F: 0x%02x\n", err, data);
+	data &= 0xEF;
+	cdata->tf->write(cdata, 0x3F, 1, &data, true);
+	//SENSOR_INFO("tilt varian(%d): write 0x3F: 0x%02x\n", err, data);
+	SENSOR_INFO("tilt varian done\n");
+
+	return err;
+}
