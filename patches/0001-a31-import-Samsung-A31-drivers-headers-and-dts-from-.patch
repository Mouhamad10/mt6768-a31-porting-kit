+			drive-strength = <4>;
+		};
+	};
+	spi1_set_clk: set_clk {
+		pins_cmd_dat{
+			pinmux = <MTK_PINMUX(SEC_GPIO_NUM(AP,pio,88), 1)>;
+			drive-strength = <4>;
