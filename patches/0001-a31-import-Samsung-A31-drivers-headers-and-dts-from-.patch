+	/* DTS or update by shell script */
+	int battery_table3[88]; // evt2
+	int battery_table4[22]; // evt2
+	int soc_arr_val[22];
+	int ocv_arr_val[22];
+
+	int batcap[4];
+	int accum[2];
+#endif
+};
+#if defined(CONFIG_BATTERY_AGE_FORECAST)
+struct fg_age_data_info {
