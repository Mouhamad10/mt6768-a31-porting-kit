+static int __init init_five(void)
+{
+	int error;
+
+	g_five_workqueue = alloc_workqueue("%s", WQ_FREEZABLE | WQ_MEM_RECLAIM,
+						0, "five_wq");
+	if (!g_five_workqueue)
+		return -ENOMEM;
+
+	hash_setup(CONFIG_FIVE_DEFAULT_HASH);
+	error = five_init();
+	if (error)
+		return error;
+
+	error = five_hook_wq_init();
+	if (error)
+		return error;
+
+	error = register_reboot_notifier(&five_reboot_nb);
