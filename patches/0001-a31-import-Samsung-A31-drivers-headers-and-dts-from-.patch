+
+#define HYST_LEV_VGPADC_SHIFT	4
+#define HYST_LEV_VGPADC_MASK	0x70
+#define HYST_LEV_VGPADC_DEFALUT HYST_LEV_VGPADC_640mV
+#define HYST_LEV_VGPADC_MAX	HYST_LEV_VGPADC_2560mV
+
+enum {
