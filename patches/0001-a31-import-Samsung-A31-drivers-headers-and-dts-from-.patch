+static int zero_out(char *buf, unsigned int len) {
+	char zero = 0;
+	int retry_cnt = 3;
+	int i;
+
+	retry:
+	if(retry_cnt > 0) {
+		memset((void *)buf, zero, len);
+		for (i = 0; i < len; ++i) {
+			zero |= buf[i];
+			if (zero) {
+				DEK_LOGE("the memory was not properly zeroed\n");
+				retry_cnt--;
+				goto retry;
+			}
+		}
+	} else {
+		DEK_LOGE("FATAL : can't zero out!!\n");
+		return -1;
+	}
+
+	return 0;
+}
