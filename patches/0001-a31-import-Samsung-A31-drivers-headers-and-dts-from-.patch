+		status = "disabled";
+	};
+};
+
+&i2c0 {
+	status = "okay";
+	id = <18>;
+	clock-frequency = <400000>;
+	#address-cells = <1>;
+	#size-cells = <0>;
+
+	sma1303_amp: sma1303@1e {
+		#sound-dai-cells = <0>;
+
+		compatible = "siliconmitus,sma1303";
+		reg = <0x1e>;
