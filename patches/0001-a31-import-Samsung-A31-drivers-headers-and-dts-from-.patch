+	cdata->accel_data_identical_count = ACCEL_IDENTICAL_DATA_CHECK_TIME_MS / delay_ms;
+	SENSOR_INFO("accel data identical count = %d\n", cdata->accel_data_identical_count);
+	
+	mutex_unlock(&cdata->mutex_enable);
+
+	SENSOR_INFO("new_delay = %lld\n", ktime_to_ns(cdata->acc_delay));
+
+	return count;
