+static ssize_t sec_tsp_log_read(struct file *file, char __user *buf,
+					size_t len, loff_t *offset)
+{
+	loff_t pos = *offset;
+	ssize_t count;
+
+	if (!sec_tsp_log_buf)
+		return 0;
+
+	if (pos >= sec_tsp_log_index)
+		return 0;
+
+	count = min(len, (size_t)(sec_tsp_log_index - pos));
+	if (copy_to_user(buf, sec_tsp_log_buf + pos, count))
+		return -EFAULT;
+	*offset += count;
+	return count;
+}
