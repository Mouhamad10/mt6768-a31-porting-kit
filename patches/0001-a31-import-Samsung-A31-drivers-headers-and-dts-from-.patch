+
+			pr_info("%s: Wire Count : %d\n", __func__, x);
+			pcisd->data[CISD_DATA_WIRE_COUNT] = x;
+			pcisd->data[CISD_DATA_WIRE_COUNT_PER_DAY]++;
+		}
+		ret = count;
+		break;
+	case CISD_WC_DATA:
