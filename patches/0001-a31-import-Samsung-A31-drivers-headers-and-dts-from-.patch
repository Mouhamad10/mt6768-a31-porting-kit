+	int id;
+	struct regulator_init_data *initdata;
+	struct device_node *reg_node;
+};
+
+struct s2mu005_platform_data {
+	/* IRQ */
+	int irq_base;
+	int irq_gpio;
+	bool wakeup;
+
+	int num_regulators;
