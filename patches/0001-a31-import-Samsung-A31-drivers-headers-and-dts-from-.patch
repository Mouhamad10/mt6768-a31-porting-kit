+void usbpd_cancel_policy_work(struct device *dev)
+{
+	struct usbpd_data *pd_data = dev_get_drvdata(dev);
+
+	if (pd_data->policy_wqueue)
+		flush_workqueue(pd_data->policy_wqueue);
+}
+EXPORT_SYMBOL(usbpd_cancel_policy_work);
