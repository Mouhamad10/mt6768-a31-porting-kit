+		a96t3x6_i2c_write(grip_data->client, REG_TSPTA, &cmd);
+		GRIP_INFO("TA/USB is removed\n");
+		break;
+	default:
+		GRIP_INFO("vbus skip attach = %d\n", vbus_type);
+		break;
+	}
+
+	vbus_pre_attach = vbus_type;
+	return 0;
+}
