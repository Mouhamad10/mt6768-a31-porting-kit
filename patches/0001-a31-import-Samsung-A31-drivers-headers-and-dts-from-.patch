@@ -0,0 +1,60 @@
+/*
+ * Set OEM flags
+ *
+ * Copyright (C) 2018 Samsung Electronics, Inc.
+ * Jonghun Song, <justin.song@samsung.com>
+ * Egor Ulesykiy, <e.uelyskiy@samsung.com>
+ *
