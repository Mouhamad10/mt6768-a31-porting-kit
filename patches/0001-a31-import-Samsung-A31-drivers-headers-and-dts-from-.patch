+static ssize_t isg5320a_sampling_freq_show(struct device *dev,
+					   struct device_attribute *attr, char *buf)
+{
+	struct isg5320a_data *data = dev_get_drvdata(dev);
+	u8 buff;
+	int sampling_freq;
