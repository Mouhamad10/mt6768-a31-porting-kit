+	sec_cmd_set_cmd_result(sec, buf, strnlen(buf, sizeof(buf)));
+
+	if (sec->cmd_all_factory_state == SEC_CMD_STATUS_RUNNING) {
+		sec_cmd_set_cmd_result_all(sec, buf, strnlen(buf, sizeof(buf)),
+					   "FW_VER_BIN");
