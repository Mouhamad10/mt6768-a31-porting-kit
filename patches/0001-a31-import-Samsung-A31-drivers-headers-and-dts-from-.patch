+	buf = kzalloc(2048, GFP_KERNEL);
+	if (buf == NULL)
+	return;
+	buf[0] = '\0';
+
+	if (tsp->dir.swap_xy) {
+		for (ii = tsp->ch_num.rx - 1; ii >= 0; ii--) {
+			for (jj = tsp->ch_num.tx - 1; jj >= 0; jj--) {
+				if (type == LOG_LOFS)
+					val = node->lofs[jj * tsp->ch_num.rx + ii];
+				else if (type == LOG_CM)
