+static inline int __do_dfr_map_cluster(struct inode *inode, u32 clu_offset, unsigned int *clus_ptr)
+{
+#ifdef	CONFIG_SDFAT_DFR
+	return fsapi_dfr_map_clus(inode, clu_offset, clus_ptr);
