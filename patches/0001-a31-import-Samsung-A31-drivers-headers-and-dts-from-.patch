+static inline int _s2mu106_muic_get_vbus_state(struct s2mu106_muic_data *muic_data)
+{
+	return (s2mu106_i2c_read_byte(muic_data->i2c, S2MU106_REG_DEVICE_APPLE)
+		& S2MU106_VBUS_WAKEUP_MASK) >> S2MU106_VBUS_WAKEUP_SHIFT;
