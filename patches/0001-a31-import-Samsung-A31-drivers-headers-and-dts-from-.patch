+		 (temp_adc - temp_adc_table[high].adc)) /
+		(temp_adc_table[low].adc - temp_adc_table[high].adc);
+
+temp_to_adc_goto:
+	return (temp == 25000 ? temp : temp * 100);
+}
+EXPORT_SYMBOL(sec_bat_convert_adc_to_temp);
