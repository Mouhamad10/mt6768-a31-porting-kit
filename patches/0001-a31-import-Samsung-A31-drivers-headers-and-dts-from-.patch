+
+	if (data->irq_count) {
+		ret = -1;
+		max_diff_val = data->max_diff;
+	} else {
+		max_diff_val = data->max_normal_diff;
+	}
+
+	pr_info("[SX9360_SUB]: %s - called\n", __func__);
