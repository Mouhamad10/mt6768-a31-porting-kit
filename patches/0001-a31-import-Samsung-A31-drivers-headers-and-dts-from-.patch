+		words = "WORDS=no_response";
+		break;
+	case USB_CERTI_HUB_DEPTH_EXCEED:
+		words = "WORDS=hub_depth_exceed";
+		break;
+	case USB_CERTI_HUB_POWER_EXCEED:
