new file mode 100644
index 000000000..1e565c91c
--- /dev/null
+++ b/drivers/battery/common/sec_battery_thermal.c
@@ -0,0 +1,979 @@
+/*
+ * sec_battery_thermal.c
+ * Samsung Mobile Battery Driver
+ *
+ * Copyright (C) 2019 Samsung Electronics
+ *
