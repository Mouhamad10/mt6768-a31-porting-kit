+static void get_checksum_data(void *dev_data)
+{
+	char buf[16] = { 0 };
+	u32 chksum = 0;
+	struct sec_cmd_data *sec = (struct sec_cmd_data *)dev_data;
+	struct ist40xx_data *data = container_of(sec, struct ist40xx_data, sec);
+
+	sec_cmd_set_default_result(sec);
