+static u16 cal_cp_value[IST40XX_MAX_NODE_NUM];
+static u16 cal_self_cp_value[IST40XX_MAX_SELF_NODE_NUM];
+static u16 cal_prox_cp_value[IST40XX_MAX_SELF_NODE_NUM];
