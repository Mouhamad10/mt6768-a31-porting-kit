+static void process_policy_vbus(struct pdic_policy *pp_data, int msg)
+{
+	if (msg == MSG_VBUSON)
+		pp_data->vbus = PP_VBUSON;		
+	else
+		pp_data->vbus = PP_VBUSOFF;
+
+	vbus_turn_on_ctrl(pp_data, pp_data->vbus);
+}
