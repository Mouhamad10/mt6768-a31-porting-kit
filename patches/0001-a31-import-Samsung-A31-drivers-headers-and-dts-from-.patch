+					PDIC_DOCK_DETACHED);
+			manager->acc_type = PDIC_DOCK_DETACHED;
+			manager->Vendor_ID = 0;
+			manager->Product_ID = 0;
+			manager->is_samsung_accessory_enter_mode = false;
