+static int sx9360_check_chip_id(struct sx9360_p *data)
+{
+	int ret;
+	u8 value = 0;
+	
+	ret = sx9360_i2c_read(data, SX9360_WHOAMI_REG, &value);
+	if (ret < 0) {
+		pr_err("[SX9360]: whoami[0x%x] read failed %d\n", value, ret);
+		return ret;
+	}
+	if(value != WHO_AM_I)
+	{
+		pr_err("[SX9360]: invalid whoami(%x)\n", value);
+		return -1;
+	}
+
+	return 0;
+}
