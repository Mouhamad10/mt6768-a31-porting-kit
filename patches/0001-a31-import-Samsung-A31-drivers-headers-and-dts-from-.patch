+static ssize_t sx9360_noti_enable_store(struct device *dev,
+				     struct device_attribute *attr, const char *buf, size_t size)
+{
+	int ret;
+	u8 enable;
+	struct sx9360_p *data = dev_get_drvdata(dev);
