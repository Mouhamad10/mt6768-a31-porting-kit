+};
+
+#define UH_LOG_START	(0xD0100000)
+#define UH_LOG_SIZE		(0x40000)
+
+unsigned long _uh_call(u64 app_id, u64 command, u64 arg0, u64 arg1, u64 arg2, u64 arg3);
