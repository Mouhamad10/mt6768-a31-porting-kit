+void sdio_autok_wait_dvfs_ready(void)
+{
+#ifdef CONFIG_MTK_SDIO_SUPPORT
+	int dvfs;
+
+	dvfs = is_vcorefs_can_work();
+
+	/* DVFS not ready, just wait */
+	while (dvfs == 0) {
+		pr_notice("DVFS not ready\n");
+		msleep(100);
+		dvfs = is_vcorefs_can_work();
+	}
+
+	if (dvfs == -1)
+		pr_notice("DVFS feature not enable\n");
+
+	if (dvfs == 1)
+		pr_notice("DVFS ready\n");
+#endif
+}
