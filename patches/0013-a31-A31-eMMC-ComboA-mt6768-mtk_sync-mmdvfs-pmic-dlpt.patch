+		MSDC_SET_FIELD(r0_addr[i], r0_mask[i], orig_r0);
+		MSDC_SET_FIELD(r1_addr[i], r1_mask[i], orig_r1);
+	}
+
+	return 0;
+
+SET_BAD_CARD:
+	msdc_set_bad_card_and_remove(host);
