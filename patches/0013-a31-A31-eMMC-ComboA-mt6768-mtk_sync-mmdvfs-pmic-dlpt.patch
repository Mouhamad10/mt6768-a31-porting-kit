+	MSDC_SET_FIELD(MSDC_CFG, MSDC_CFG_CKMOD, 0);
+	MSDC_SET_FIELD(MSDC_CFG, MSDC_CFG_CKDIV, 5);
+	msdc_retry(!(MSDC_READ32(MSDC_CFG) & MSDC_CFG_CKSTB),
+		retry, cnt, host->id);
