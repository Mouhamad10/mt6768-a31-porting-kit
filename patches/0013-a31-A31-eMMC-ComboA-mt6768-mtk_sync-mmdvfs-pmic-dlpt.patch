+		clk_disable_unprepare(host->clk_ctl); \
+		if (host->aes_clk_ctl) \
+			clk_disable_unprepare(host->aes_clk_ctl); \
+		if (host->hclk_ctl) \
+			clk_disable_unprepare(host->hclk_ctl); \
+	} while (0)
+#else
