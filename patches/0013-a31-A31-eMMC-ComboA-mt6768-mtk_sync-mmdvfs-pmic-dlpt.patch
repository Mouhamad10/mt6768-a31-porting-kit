+			host->autok_res[i][11]);
+		SPREAD_PRINTF(buff, size, m,
+			"[AUTOK]DS  [DLY1:%d DLY2:%d DLY3:%d]\r\n",
+			host->autok_res[i][14], host->autok_res[i][16],
+			host->autok_res[i][18]);
+		SPREAD_PRINTF(buff, size, m, "[AUTOK]DAT [TX SEL:%d]\r\n",
+			host->autok_res[i][20]);
+	}
+}
