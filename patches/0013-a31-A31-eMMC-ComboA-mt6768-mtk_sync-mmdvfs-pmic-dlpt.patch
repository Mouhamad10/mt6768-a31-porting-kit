+#if defined(VCOREFS_READY)
+static int autok_opp[AUTOK_VCORE_NUM] = {
+	VCORE_DVFS_OPP_2, /* 0.825V, OPP_0 is invalid */
+
+	VCORE_DVFS_OPP_6, /* 0.725V */
+	VCORE_DVFS_OPP_9, /* 0.65V */
+};
