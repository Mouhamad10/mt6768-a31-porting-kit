+	ret = msdc_io_rw_direct_host(mmc, 0, 1, 0x11C, 0, &data);
+	pr_notice("0x11C data: %x , ret: %x\n", data, ret);
+
+	ret = msdc_io_rw_direct_host(mmc, 0, 1, 0x124, 0, &data);
+	pr_notice("0x124 data: %x , ret: %x\n", data, ret);
