+	ret = msdc_io_rw_direct_host(mmc, 1, 1, 0x128, 0x87, 0);
+	ret = msdc_io_rw_direct_host(mmc, 1, 1, 0x129, 0x87, 0);
+	ret = msdc_io_rw_direct_host(mmc, 1, 1, 0x12A, 0x87, 0);
+	ret = msdc_io_rw_direct_host(mmc, 1, 1, 0x12B, 0x87, 0);
