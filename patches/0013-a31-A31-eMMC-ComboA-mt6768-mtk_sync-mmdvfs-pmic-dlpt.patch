@@ -0,0 +1,13 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/* A31 port: 4.14 MTK sched_ctl API on top of the 4.19 sched extension */
+#ifndef _A31_SCHED_CTL_SHIM_H
+#define _A31_SCHED_CTL_SHIM_H
+
+extern int set_sched_boost_type(int type);
+
+/* 4.14: 0 = no boost, 1 = all boost, 2 = fg boost (4.19 has no fg level) */
+static inline int set_sched_boost(unsigned int val)
+{
+	return set_sched_boost_type(val ? 1 : 0);
+}
+#endif
