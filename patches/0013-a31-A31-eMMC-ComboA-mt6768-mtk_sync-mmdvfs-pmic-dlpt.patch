+static void msdc_dump_clock_sts_core(char **buff, unsigned long *size,
+	struct seq_file *m, struct msdc_host *host)
+{
+	char buffer[1024];
+	char *buf_ptr = buffer;
+
+	if (topckgen_base) {
+		buf_ptr += sprintf(buf_ptr,
+		" topckgen [0x%p]=0x%x(EMMC:should bit[1:0]=01b, bit[7]=0, bit[10:8]=001b, bit[15]=0) SD: bit[18:16]=001b, bit[23]=0\n",
+			topckgen_base + 0x70,
+			MSDC_READ32(topckgen_base + 0x70));
+
+#if defined(CONFIG_MTK_HW_FDE) || defined(CONFIG_MMC_CRYPTO)
+		buf_ptr += sprintf(buf_ptr,
+		" topckgen [0x%p]=0x%x(AES:should bit[26:24]=001b, bit[31]=0)\n",
+			topckgen_base + 0xa0,
+			MSDC_READ32(topckgen_base + 0xa0));
+#endif
+	}
+	if (infracfg_ao_base) {
+		buf_ptr += sprintf(buf_ptr,
+		" infracfg_ao [0x%p]=0x%x(EMMC:should bit[2]=0b,SD:bit[4]=0b)\n",
+			infracfg_ao_base + 0x94,
+			MSDC_READ32(infracfg_ao_base + 0x94));
+
+#if defined(CONFIG_MTK_HW_FDE) || defined(CONFIG_MMC_CRYPTO)
+		buf_ptr += sprintf(buf_ptr,
+		" infracfg_ao [0x%p]=0x%x(should bit[29]=0b)\n",
+			infracfg_ao_base + 0xac,
+			MSDC_READ32(infracfg_ao_base + 0xac));
+#endif
+		buf_ptr += sprintf(buf_ptr,
+		" infracfg_ao [0x%p]=0x%x(EMMC:should bit[9]=0b, SD:bit[9]=0b)\n",
+			infracfg_ao_base + 0xc8,
+			MSDC_READ32(infracfg_ao_base + 0xc8));
+	}
+
+	*buf_ptr = '\0';
+	SPREAD_PRINTF(buff, size, m, "%s", buffer);
+}
