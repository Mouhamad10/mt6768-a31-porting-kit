+		buf[j] = '\0';
+		SPREAD_PRINTF(buff, size, m,
+			"[AUTOK]Host   Data TX \t: %s\r\n", buf);
+
+		SPREAD_PRINTF(buff, size, m,
+			"[AUTOK]CMD [EDGE:%d CMD_FIFO_EDGE:%d DLY1:%d DLY2:%d]\r\n",
