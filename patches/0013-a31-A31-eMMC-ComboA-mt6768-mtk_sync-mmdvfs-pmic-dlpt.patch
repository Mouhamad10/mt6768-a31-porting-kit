+		MSDC1_R1_DAT0_ADDR_A,
+		MSDC1_R1_DAT0_ADDR_A
+	};
+	u32 pupd_mask[3] = {
+		MSDC1_PUPD_DAT0_MASK_A,
+		MSDC1_PUPD_DAT1_MASK_A,
+		MSDC1_PUPD_DAT2_MASK_A
+	};
+	u32 r0_mask[3] = {
+		MSDC1_R0_DAT0_MASK_A,
+		MSDC1_R0_DAT1_MASK_A,
