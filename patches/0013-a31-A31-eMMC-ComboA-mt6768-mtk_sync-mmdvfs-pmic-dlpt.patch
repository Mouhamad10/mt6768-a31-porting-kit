+
+	ret = msdc_io_rw_direct_host(mmc, 1, 1, 0x11C, 0x90, 0);
+
+#if 0 /* Device data RX window cover by host data TX */
+	ret = msdc_io_rw_direct_host(mmc, 1, 1, 0x124, 0x87, 0);
+	ret = msdc_io_rw_direct_host(mmc, 1, 1, 0x125, 0x87, 0);
