 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/drivers/samsung/misc/sec_log.c b/drivers/samsung/misc/sec_log.c
index fb816b403..20135ac82 100644
--- a/drivers/samsung/misc/sec_log.c
+++ b/drivers/samsung/misc/sec_log.c
@@ -249,7 +249,7 @@ static int __init sec_log_buf_init(void)
 
 	return 0;
 }
-arch_initcall(sec_log_buf_init);
+early_initcall(sec_log_buf_init); /* A31 port: as early as possible to catch early crashes */
 
 #ifdef CONFIG_SEC_LOG_HOOK_PMSG
 static int sec_log_combine_pmsg(char *buffer, size_t count, unsigned int level)
