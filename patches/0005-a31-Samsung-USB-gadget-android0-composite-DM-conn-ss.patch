+static char *get_usb_speed(enum usb_device_speed	speed)
+{
+	switch (speed) {
+	case USB_SPEED_HIGH:
+		return "HS";
+	case USB_SPEED_SUPER:
+		return "SS";
+	case USB_SPEED_SUPER_PLUS:
+		return "PSS";
+	case USB_SPEED_FULL:
+		return "FS";
+	case USB_SPEED_UNKNOWN:
+		return "UN";
+	case USB_SPEED_LOW:
+		return "LS";
+	case USB_SPEED_WIRELESS:
+		return "WS";
+	default:
+		return "ERR";
+	}
+}
+#endif
