+		etspi-chipid = "ET713";
+		etspi-modelinfo = "A315";
+		etspi-position = "8.97,0.00,9.10,9.10,14.80,14.80,12.00,12.00,5.00";
+		etspi-rb = "525,-1,-1";
+		controller-data {
+			mediatek,tckdly = <1>;
+		};
+	};
