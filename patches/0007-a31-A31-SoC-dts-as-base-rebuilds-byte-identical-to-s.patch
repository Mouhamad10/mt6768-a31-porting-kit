+
+			fixed_regulator_ois_mcu_ldo {
+				compatible = "regulator-fixed";
+				regulator-name = "ois_mcu_ldo";
+				gpio = <&pio 70 0>;
+				enable-active-high;
+				skip-gpio-request;
+			};
+
+			fixed_regulator_rcam1_avdd2_ldo {
+				compatible = "regulator-fixed";
+				regulator-name = "rcam1_avdd2_ldo";
+				gpio = <&pio 160 0>;
+				enable-active-high;
+				skip-gpio-request;
+			};
+
+			fixed_regulator_lcd_en_3p0_ldo {
+				compatible = "regulator-fixed";
+				regulator-name = "lcd_en_3p0_ldo";
+				gpio = <&pio 153 0>;
+				enable-active-high;
+				skip-gpio-request;
+			};
+
+			fixed_regulator_lcd_en_1p8_ldo {
