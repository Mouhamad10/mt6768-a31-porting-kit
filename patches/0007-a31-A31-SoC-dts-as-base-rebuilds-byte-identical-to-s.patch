+					"regulator,enable",	"gpio_lcd_rst",
+					"delay,usleep",	"2000",
+					"regulator,disable",	"gpio_lcd_rst",
+					"delay,usleep",	"2000",
+					"regulator,enable",	"gpio_lcd_rst",
+					"delay,msleep",	"20";
+				};
+				panel_reset_disable {
+					type =
+					"delay,msleep",	"70",
+					"regulator,disable",	"gpio_lcd_rst",
+					"delay,usleep",	"10000";
