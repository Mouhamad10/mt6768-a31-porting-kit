+			drive-strength = <0>;
+		};
+	};
+	camera0_mclk_4mA: camera0_mclk_4mA@gpio99 {
+		pins_cmd_dat {
+			pinmux = <PINMUX_GPIO99__FUNC_CMMCLK0>;
+			drive-strength = <1>;
