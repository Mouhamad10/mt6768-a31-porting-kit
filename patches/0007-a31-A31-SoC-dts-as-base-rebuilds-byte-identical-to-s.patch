+				thermistor_name = "sec-pa-thermistor";
+				id = <1>;
+
+				io-channels = <&auxadc 0>;
+				io-channel-names = "pa_therm";
+				io-channel-ranges;
+				use_iio_processed;
+
+				adc_array = <111 134 187 221 263 308 362 432 514 570
