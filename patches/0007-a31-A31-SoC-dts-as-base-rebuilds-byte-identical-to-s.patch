+					};
+				};
+			};
+
+			usb_notifier {
+				compatible = "samsung,usb-notifier";
+			};
+
+			usb_tuning: usb_tuning {
+				compatible = "mediatek,phy_tuning";
+
+				tune@1 {
+					label = "term_vref_sel";
+					offset = <0x4>;
+					shift = <8>;
+					mask = <0x7>;
+					value = <0x2>;
+				};
+				tune@2 {
+					label = "vrt_ref_sel";
+					offset = <0x4>;
+					shift = <12>;
+					mask = <0x7>;
+					value = <0x3>;
+				};
+				tune@3 {
+					label = "intr_cal";
+					offset = <0x4>;
+					shift = <19>;
+					mask = <0x1f>;
+					value = <0x19>;
+				};
+				tune@4 {
+					label = "hstx_srctrl";
+					offset = <0x14>;
+					shift = <12>;
+					mask = <0x7>;
+					value = <0x1>;
+				};
+				tune@5 {
+					label = "hstx_srcal_en";
+					offset = <0x14>;
+					shift = <15>;
+					mask = <0x1>;
+					value = <0x0>;
+				};
+				tune@6 {
+					label = "sqth";
+					offset = <0x18>;
+					shift = <0>;
+					mask = <0xf>;
+					value = <0x2>;
+				};
+				tune@7 {
+					label = "discth";
+					offset = <0x18>;
+					shift = <4>;
+					mask = <0xf>;
+					value = <0x7>;
+				};
+				tune@8 {
+					label = "enhance";
+					offset = <0x18>;
+					shift = <30>;
+					mask = <0x3>;
+					value = <0x3>;
+				};
+			};
+		};
+	};
+};
