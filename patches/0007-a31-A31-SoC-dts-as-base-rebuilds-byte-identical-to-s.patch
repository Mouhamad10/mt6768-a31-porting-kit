+				enable-active-high;
+				skip-gpio-request;
+			};
+
+			fixed_regulator_rcam1_dvdd_1p05_ldo {
+				compatible = "regulator-fixed";
+				regulator-name = "rcam1_dvdd_1p05_ldo";
