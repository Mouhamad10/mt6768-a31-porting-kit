+/ {
+	fragment@lcd {
+		target-path = "/";
+		__overlay__ {
+			panel {
+				compatible = "samsung,mtk-dsi-panel";
+				smcdsd_panel = <&ea8076>;
+			};
+
+			lcd_fixed_regulator: lcd_fixed_regulator {
+				compatible = "simple-bus";
+
