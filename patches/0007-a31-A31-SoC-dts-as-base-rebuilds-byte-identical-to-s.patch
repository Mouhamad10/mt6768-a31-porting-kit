+	interrupts = <0 IRQ_TYPE_LEVEL_LOW>;
+	status = "okay";
+};
+
+&msdc1_ins {
+	interrupt-parent = <&pio>;
+	interrupts = <3 IRQ_TYPE_LEVEL_LOW>;
+	status = "okay";
+};
+
+&subpmic_pmu_eint {
+	interrupt-parent = <&pio>;
+	interrupts = <4 IRQ_TYPE_EDGE_FALLING>;
+	status = "okay";
+};
+
+&irq_nfc {
+	interrupt-parent = <&pio>;
+	interrupts = <8 IRQ_TYPE_LEVEL_HIGH>;
+	status = "okay";
+};
+
+&touch_panel {
+	interrupt-parent = <&pio>;
+	interrupts = <14 IRQ_TYPE_LEVEL_LOW>;
+	status = "okay";
