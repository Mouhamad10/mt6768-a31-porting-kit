+		.owner	= THIS_MODULE,
+		.of_match_table = of_match_ptr(sec_audio_sysfs_of_match),
+	},
+
+	.probe		= sec_audio_sysfs_probe,
+	.remove		= sec_audio_sysfs_remove,
+};
