From efca598aa04a06dd75a8f6ea22c5385a8e967e02 Mon Sep 17 00:00:00 2001
From: a31port <a31port@local>
Date: Fri, 13 Nov 2026 10:02:42 +0000
Subject: [PATCH 15/29] a31: eMMC driver 4.19 fixes (mtk pm_qos vcore, claimer
 ctx, MTK mmc header extras)

---
 drivers/mmc/host/mediatek/ComboA/dbg.c               | 12 ++++++------
 drivers/mmc/host/mediatek/ComboA/mt6765/autok_dvfs.c | 11 ++++++-----
 drivers/mmc/host/mediatek/ComboA/mt6833/autok_dvfs.c | 11 ++++++-----
 drivers/mmc/host/mediatek/ComboA/mt6853/autok_dvfs.c | 11 ++++++-----
 drivers/mmc/host/mediatek/ComboA/mt6853/msdc_cust.c  |  5 +++--
 drivers/mmc/host/mediatek/ComboA/mt6877/autok_dvfs.c | 11 ++++++-----
 drivers/mmc/host/mediatek/ComboA/mt6885/autok_dvfs.c | 11 ++++++-----
 drivers/mmc/host/mediatek/ComboA/mt6893/autok_dvfs.c | 11 ++++++-----
 drivers/mmc/host/mediatek/ComboA/mtk_sd.h            |  3 ++-
 drivers/mmc/host/mediatek/ComboA/sd.c                |  8 ++++----
 include/linux/mmc/host.h                             |  3 +++
 include/linux/mmc/mmc.h                              |  1 +
 12 files changed, 55 insertions(+), 43 deletions(-)

diff --git a/drivers/mmc/host/mediatek/ComboA/dbg.c b/drivers/mmc/host/mediatek/ComboA/dbg.c
index f99209975..48293e6ca 100644
--- a/drivers/mmc/host/mediatek/ComboA/dbg.c
+++ b/drivers/mmc/host/mediatek/ComboA/dbg.c
@@ -660,8 +660,8 @@ void mmc_cmd_dump(char **buff, unsigned long *size, struct seq_file *m,
 	SPREAD_PRINTF(buff, size, m,
 		"claimed(%d), claim_cnt(%d), claimer pid(%d), comm %s\n",
 		mmc->claimed, mmc->claim_cnt,
-		mmc->claimer ? mmc->claimer->pid : 0,
-		mmc->claimer ? mmc->claimer->comm : "NULL");
+		mmc->claimer ? (mmc->claimer->task ? task_pid_nr(mmc->claimer->task) : 0) : 0,
+		mmc->claimer ? (mmc->claimer->task ? mmc->claimer->task->comm : "NULL") : "NULL");
 }
 
 void sd_cmd_dump(char **buff, unsigned long *size, struct seq_file *m,
@@ -706,8 +706,8 @@ void sd_cmd_dump(char **buff, unsigned long *size, struct seq_file *m,
 	SPREAD_PRINTF(buff, size, m,
 		"claimed(%d), claim_cnt(%d), claimer pid(%d), comm %s\n",
 		mmc->claimed, mmc->claim_cnt,
-		mmc->claimer ? mmc->claimer->pid : 0,
-		mmc->claimer ? mmc->claimer->comm : "NULL");
+		mmc->claimer ? (mmc->claimer->task ? task_pid_nr(mmc->claimer->task) : 0) : 0,
+		mmc->claimer ? (mmc->claimer->task ? mmc->claimer->task->comm : "NULL") : "NULL");
 }
 
 void msdc_dump_host_state(char **buff, unsigned long *size,
@@ -882,9 +882,9 @@ void msdc_cmdq_status_print(struct msdc_host *host, struct seq_file *m)
 	seq_printf(m, "host claim cnt : %d\n",
 		mmc->claim_cnt);
 	seq_printf(m, "host claimer pid : %d\n",
-		mmc->claimer ? mmc->claimer->pid : 0);
+		mmc->claimer ? (mmc->claimer->task ? task_pid_nr(mmc->claimer->task) : 0) : 0);
 	seq_printf(m, "host claimer comm : %s\n",
-		mmc->claimer ? mmc->claimer->comm : "NULL");
+		mmc->claimer ? (mmc->claimer->task ? mmc->claimer->task->comm : "NULL") : "NULL");
 
 
 #if defined(CONFIG_MTK_EMMC_HW_CQ)
diff --git a/drivers/mmc/host/mediatek/ComboA/mt6765/autok_dvfs.c b/drivers/mmc/host/mediatek/ComboA/mt6765/autok_dvfs.c
index c5392cdbc..4bec56d53 100644
--- a/drivers/mmc/host/mediatek/ComboA/mt6765/autok_dvfs.c
+++ b/drivers/mmc/host/mediatek/ComboA/mt6765/autok_dvfs.c
@@ -12,6 +12,7 @@
  */
 
 #include <asm/segment.h>
+#include <linux/soc/mediatek/mtk-pm-qos.h>
 #include <linux/uaccess.h>
 #include <linux/buffer_head.h>
 #include <linux/delay.h>
@@ -872,7 +873,7 @@ int emmc_autok(void)
 	 * Static variable required by vcore dvfs module, otherwise deadlock
 	 * happens.
 	 */
-	static struct pm_qos_request autok_force;
+	static struct mtk_pm_qos_request autok_force;
 
 	if (!host || !host->mmc) {
 		pr_notice("eMMC device not ready\n");
@@ -893,11 +894,11 @@ int emmc_autok(void)
 	base = host->base;
 	mmc_claim_host(host->mmc);
 
-	pm_qos_add_request(&autok_force, PM_QOS_VCORE_DVFS_FORCE_OPP,
-			PM_QOS_VCORE_DVFS_FORCE_OPP_DEFAULT_VALUE);
+	mtk_pm_qos_add_request(&autok_force, MTK_PM_QOS_VCORE_DVFS_FORCE_OPP,
+			MTK_PM_QOS_VCORE_DVFS_FORCE_OPP_DEFAULT_VALUE);
 
 	for (i = 0; i < AUTOK_VCORE_NUM; i++) {
-		pm_qos_update_request(&autok_force, autok_opp[i]);
+		mtk_pm_qos_update_request(&autok_force, autok_opp[i]);
 		/* vcore = 0.51875V + 6.25mV * vcore_step2 */
 		vcore_step2 = pmic_get_register_value(PMIC_RG_BUCK_VCORE_VOSEL);
 		pr_notice("msdc fix vcore, PMIC_RG_BUCK_VCORE_VOSEL: %d\n",
@@ -945,7 +946,7 @@ int emmc_autok(void)
 		host->lock_vcore = 1;
 	}
 
-	pm_qos_remove_request(&autok_force);
+	mtk_pm_qos_remove_request(&autok_force);
 
 	mmc_release_host(host->mmc);
 #endif
