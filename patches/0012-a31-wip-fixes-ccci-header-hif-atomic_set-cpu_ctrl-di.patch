+/* A31 port: 4.19 has no arch_get_nr_clusters(); same helper as perf resym */
+static int a31_nr_clusters(void)
+{
+	int cpu, nr = 0, prev = -1;
+
+	for_each_possible_cpu(cpu) {
+		int id = topology_physical_package_id(cpu);
+
+		if (id != prev) {
+			nr++;
+			prev = id;
+		}
+	}
+	return nr;
+}
