-void m4u_larb0_enable(char *name)
-{
-	M4UMSG("%s, refcnt: %d, %s\n", __func__, larb0_cnt, name);
-
-	mutex_lock(&m4u_larb0_mutex);
-	larb_clock_on(0, 1);
-	if (larb0_cnt == 0)
-		larb_restore(0);
-
-	larb0_cnt++;
-	mutex_unlock(&m4u_larb0_mutex);
-}
-
-void m4u_larb0_disable(char *name)
-{
-	M4UMSG("%s, refcnt: %d, %s\n", __func__, larb0_cnt, name);
-
-	mutex_lock(&m4u_larb0_mutex);
-	larb0_cnt--;
-	if (larb0_cnt == 0)
-		larb_backup(0);
-
-	larb_clock_off(0, 1);
-	mutex_unlock(&m4u_larb0_mutex);
-}
