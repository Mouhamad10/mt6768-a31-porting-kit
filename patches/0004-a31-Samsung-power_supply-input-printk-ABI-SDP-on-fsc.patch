-		ret = 0;
-
-	x0 = 0;
-	x1 = FRAME_WIDTH - 1;
-
-	x0_MSB = ((x0 >> 8) & 0xFF);
-	x0_LSB = (x0 & 0xFF);
-	x1_MSB = ((x1 >> 8) & 0xFF);
-	x1_LSB = (x1 & 0xFF);
