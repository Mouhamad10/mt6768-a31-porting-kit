-static void read_imx499_LRC(void)
-{
-	char pu_send_cmd[2] = { (char)(LRC_ADDR >> 8),
-		(char)(LRC_ADDR & 0xFF) };
-
-	if (Is_Read_LRC_Data == 1)
-		return;
-	iReadRegI2C(pu_send_cmd, 2, imx499_LRC_data, 140, 0xa0);
-	Is_Read_LRC_Data = 1;
-}
