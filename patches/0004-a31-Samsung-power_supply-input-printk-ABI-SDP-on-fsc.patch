+static void gc5035b_otp_read_sensor_info(void)
+{
+	kal_uint8 flag_dd = 0;
+	kal_uint16 temp = 0, i = 0, j = 0;
+
+
+	/* DPC */
+	flag_dd = gc5035b_otp_read_byte(DPC_FLAG_OFFSET);
+	LOG_INF("flag_dd = 0x%x\n", flag_dd);
+	switch (flag_dd & 0x03) {
+	case 0x00:
+		LOG_INF("DD is empty !!\n");
+		gc5035b_otp_data.dd_flag = 0x00;
+		break;
+	case 0x01:
+		LOG_INF("DD is valid!!\n");
+		gc5035b_otp_data.dd_num = gc5035b_otp_read_byte(DPC_TOTAL_NUMBER_OFFSET)
+						+ gc5035b_otp_read_byte(DPC_ERROR_NUMBER_OFFSET);
+		gc5035b_otp_data.dd_flag = 0x01;
+		LOG_INF("total_num = %d\n", gc5035b_otp_data.dd_num);
+		break;
+	case 0x02:
+	case 0x03:
+		LOG_INF("DD is invalid !!\n");
+		gc5035b_otp_data.dd_flag = 0x02;
+		break;
+	default:
+		break;
+	}
+
+	/*Register Update*/
+	gc5035b_otp_data.reg_flag = gc5035b_otp_read_byte(REG_INFO_FLAG_OFFSET);
+	LOG_INF("Register value flag = 0x%x\n", gc5035b_otp_data.reg_flag);
+	if ((gc5035b_otp_data.reg_flag & 0x03) == 0x01)
+		for (i = 0; i < REG_INFO_SIZE; i++) {
+			temp = gc5035b_otp_read_byte(REG_INFO_PAGE_OFFSET + REG_INFO_SIZE * 8 * i);
+			for (j = 0; j < 2; j++) {
+				if (((temp >> (4 * j + 3)) & 0x01) == 0x01) {// check
+					gc5035b_otp_data.regs[gc5035b_otp_data.reg_num][0] =
+						(temp >> (4 * j)) & 0x07;// page
+					gc5035b_otp_data.regs[gc5035b_otp_data.reg_num][1] =
+						gc5035b_otp_read_byte(REG_INFO_ADDR_OFFSET + REG_INFO_SIZE * 8 * i + 0x10 * j);
+					gc5035b_otp_data.regs[gc5035b_otp_data.reg_num][2] =
+						gc5035b_otp_read_byte(REG_INFO_VALUE_OFFSET + REG_INFO_SIZE * 8 * i + 0x10 * j);
+					gc5035b_otp_data.reg_num++;
+				}
+			}
+		}
+}
+
+static void gc5035b_otp_update_dd(void)
+{
+	kal_uint8 state = 0;
+	kal_uint8 n = 0;
+
+	if (gc5035b_otp_data.dd_flag == 0x01) {
+		LOG_INF("DD auto load start!\n");
+		write_cmos_sensor(0xfe, 0x02);
+		write_cmos_sensor(0xbe, 0x00);//allow DD write
+		write_cmos_sensor(0xa9, 0x01);// clear sram
+		write_cmos_sensor(0x09, 0x33);
+		write_cmos_sensor(0x01, (gc5035b_otp_data.dd_num >> 8) & 0x07);
+		write_cmos_sensor(0x02, gc5035b_otp_data.dd_num & 0xff);
+		write_cmos_sensor(0x03, 0x00);
+		write_cmos_sensor(0x04, 0x80);//otp bad pixel start pos
+		write_cmos_sensor(0x95, 0x0a);
+		write_cmos_sensor(0x96, 0x30);
+		write_cmos_sensor(0x97, 0x0a);
+		write_cmos_sensor(0x98, 0x32);
+		write_cmos_sensor(0x99, 0x07);
+		write_cmos_sensor(0x9a, 0xa9);
+		write_cmos_sensor(0xf3, 0x80);// auto load start pulse
+		while (n < 3) {
+			state = read_cmos_sensor(0x06);
+			if ((state | 0xfe) == 0xff)
+				usleep_range(10000, 10100);
+			else
+				n = 3;
+			n++;
+		}
+		write_cmos_sensor(0xbe, 0x01);
+		write_cmos_sensor(0x09, 0x00);//close auto load
+		write_cmos_sensor(0xfe, 0x01);
+		write_cmos_sensor(0x80, 0x02);/* [1]DD_EN */
+		write_cmos_sensor(0xfe, 0x00);
+	}
+}
+
+static void gc5035b_otp_update_reg(void)
+{
+	kal_uint8 i = 0;
+
+	LOG_INF("register update start!");
+
+	/* Register Update */
+
+	if ((gc5035b_otp_data.reg_flag & 0x03) == 0x01) {
+		for (i = 0; i < gc5035b_otp_data.reg_num; i++) {
+			write_cmos_sensor(0xfe, gc5035b_otp_data.regs[i][0]);
+			write_cmos_sensor(gc5035b_otp_data.regs[i][1], gc5035b_otp_data.regs[i][2]);
+		}
+	}
+	LOG_INF("register update finish!");
+
+}
