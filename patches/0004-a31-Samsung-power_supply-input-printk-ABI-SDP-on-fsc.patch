-
-	if (cfg->layer_disable_by_partial_update) {
-		update = 0;
-		trans_en = 0;
-		cnst_en = 0;
-	}
-
-	data->pre_addr = cfg->real_addr;
-	data->dst_x = cfg->real_dst_x;
-	data->dst_y = cfg->real_dst_y;
-	data->dst_w = cfg->real_dst_w;
-	data->dst_h = cfg->real_dst_h;
