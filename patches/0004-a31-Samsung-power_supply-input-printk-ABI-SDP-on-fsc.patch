-
-int external_display_lowpower_init(void)
-{
-	/* init idlemgr */
-	if (disp_helper_get_option(DISP_OPT_IDLE_MGR)
-		/* get_boot_mode() == NORMAL_BOOT */
-		)
-		external_display_idlemgr_init();
