-
-	if (pgc->state == DISP_SLEPT) {
-		DISPCHECK("Sleep State clk change invalid\n");
-		return 0;
-	}
-
-	_primary_path_lock(__func__);
-
-	if (!primary_display_is_video_mode()) {
