+
+	for (i = 0; i < count; i++) {
+		unsigned cmd;
+
+		cmd = table[i].cmd;
+		switch (cmd) {
+		case REGFLAG_DELAY:
+#ifdef BUILD_LK
+			dprintf(0, "[LK]REGFLAG_DELAY\n");
+#endif
+			MDELAY(table[i].count);
+			break;
+		case REGFLAG_END_OF_TABLE:
+#ifdef BUILD_LK
+			dprintf(0, "[LK]push_table end\n");
+#endif
+			break;
+		default:
+			dsi_set_cmdq_V22(cmdq, cmd, table[i].count,
+				table[i].para_list, force_update);
+		}
+	}
+}
