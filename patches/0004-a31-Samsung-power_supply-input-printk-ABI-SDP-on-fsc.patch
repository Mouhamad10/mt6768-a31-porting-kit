-			DISP_REG_MASK(handle,
-				      DISP_REG_CONFIG_MUTEX_MOD0(mutex_id),
-				      0, value);
-			ret = 1;
-		}
-	} else if (module == DISP_MODULE_DSIDUAL) {
-		value = (1 << module_mutex_map[DISP_MODULE_DSI0].bit);
