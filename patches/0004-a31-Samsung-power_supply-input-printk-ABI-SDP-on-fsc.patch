+			"mtkfb_update_buf_state return MVA=0x0 mtkfb_query_buf_mva layer_id %d !!!!!!(Warning)\n",
+			layer_id);
+		return mva;
+	}
+
+	session_info = _get_session_sync_info(session_id);
+	layer_info = &(session_info->session_layer_info[layer_id]);
