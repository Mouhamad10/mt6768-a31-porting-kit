+UINT32 S5K2X5SP13_MIPI_RAW_SensorInit(struct SENSOR_FUNCTION_STRUCT **pfFunc)
+{
+	/* To Do : Check Sensor status here */
+	if (pfFunc != NULL)
+		*pfFunc = &sensor_func;
+	return ERROR_NONE;
+}
