+	dev_info(&lcd->ld->dev, "%s: %u(%u)\n", __func__, lcd->fac_info, value);
+
+	mutex_lock(&lcd->lock);
+	lcd->fac_info = value;
+	mutex_unlock(&lcd->lock);
+
+	if (!lcd->fac_done) {
+		lcd->fac_done = 1;
+		smcdsd_abd_con_register(abd);
+		sysfs_update_group(&lcd->ld->dev.kobj, &lcd_sysfs_attr_group);
+	}
+
+	return size;
