-
-	n = scnprintf(msg, len,
-		     "power_saving:%d,rgb_bit_mode:%d,frm_start:%d,frm_end:%d,size_err:%d,sof_rst:%d\n",
-		     REG_FLD_VAL_GET(FLD_RSZ_POWER_SAVING, con2),
