-
-	DISP_REG_SET(handle, DISP_REG_OVL_L0_CON + Lx_base, value);
-
-	value = 0;
-	if (format == UFMT_RGBA1010102 || format == UFMT_PRGBA1010102)
-		value = 1;
-	else if (format == UFMT_RGBA_FP16 || format == UFMT_PRGBA_FP16)
