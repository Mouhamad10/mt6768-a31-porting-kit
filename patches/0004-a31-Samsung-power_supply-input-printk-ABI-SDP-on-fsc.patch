-int do_lcm_vdo_lp_read(struct dsi_cmd_desc *cmd_tab, unsigned int count)
-{
-	int ret = 0;
-	int i = 0;
-	int h = 0;
-	struct cmdqRecStruct *handle;
-	/*static cmdqBackupSlotHandle read_Slot;*/
-	cmdqBackupSlotHandle hSlot[4] = {0, 0, 0, 0};
