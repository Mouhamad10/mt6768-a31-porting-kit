-	if (!flg) {
-		dpmgr_map_event_to_irq(pgc->dpmgr_handle,
-				       DISP_PATH_EVENT_IF_VSYNC,
-				       DDP_IRQ_RDMA0_DONE);
-		dsi_enable_irq(DISP_MODULE_DSI0, NULL, 0);
-	} else {
