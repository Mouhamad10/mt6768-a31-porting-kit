-{
-	if (channel == AW3644_CHANNEL_CH1)
-		hrtimer_cancel(&aw3644_timer_ch1);
-	else if (channel == AW3644_CHANNEL_CH2)
-		hrtimer_cancel(&aw3644_timer_ch2);
-	else {
-		pr_info("Error channel\n");
-		return -1;
-	}
-
-	return 0;
-}
