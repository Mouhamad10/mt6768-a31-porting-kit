-void imgsensor_clk_disable_all(struct IMGSENSOR_CLK *pclk)
-{
-	int i;
-
-	pr_info("%s\n", __func__);
-	for (i = IMGSENSOR_CCF_MCLK_TG_MIN_NUM;
