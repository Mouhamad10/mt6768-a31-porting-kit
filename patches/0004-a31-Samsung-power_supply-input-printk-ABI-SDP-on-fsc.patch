+	i2c_lcd_bias_id[0].driver_data = (kernel_ulong_t)lcd;
+	i2c_add_driver(&i2c_lcd_bias_driver);
+
+	dev_info(&lcd->ld->dev, "- %s\n", __func__);
+
+	return 0;
