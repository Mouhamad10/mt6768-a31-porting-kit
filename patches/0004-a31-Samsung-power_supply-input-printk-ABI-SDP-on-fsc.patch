+			imgsensor_info.normal_video.pclk = 286000000;
+			imgsensor_info.normal_video.mipi_pixel_rate = 286000000;
+			imgsensor_info.normal_video.framelength = 2594;
+		} else {
+			pr_err("[%s] Wrong Scenario id : %d", __func__, scenario_id);
+			return -EIO;
