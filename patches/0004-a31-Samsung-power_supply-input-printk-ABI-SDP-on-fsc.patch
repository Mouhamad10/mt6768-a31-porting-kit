+static irqreturn_t s6e3fc3_invalid_handler(int id, void *dev_id)
+{
+	struct lcd_info *lcd  = (struct lcd_info *)dev_id;
+
+	lcd->total_invalid_cnt++;
+
+	return IRQ_HANDLED;
+}
