-			DSI_READREG32(UINT32*, &new_hstx_ckl_wc,
-				&DSI_REG[i]->DSI_HSTX_CKL_WC);
-			DISPCHECK("===>new HSTX_CKL_WC=0x%x, HFP_WC=0x%x\n",
