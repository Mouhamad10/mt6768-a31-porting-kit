+	write_cmos_sensor(0xf3, 0x12);
+
+	for (i = 0; i < length; i++) {
+		data[i] = read_cmos_sensor(0x6c);
+	}
+
+	write_cmos_sensor(0xf3, 0x00);
+}
+#endif
