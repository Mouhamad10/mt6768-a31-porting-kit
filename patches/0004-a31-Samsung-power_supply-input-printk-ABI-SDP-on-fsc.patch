+static void set_dummy(void)
+{
+	LOG_DBG("dummyline = %d, dummypixels = %d", imgsensor.dummy_line, imgsensor.dummy_pixel);
+
+	write_cmos_sensor(0x0340, imgsensor.frame_length);
+	write_cmos_sensor(0x0342, imgsensor.line_length);
+}
