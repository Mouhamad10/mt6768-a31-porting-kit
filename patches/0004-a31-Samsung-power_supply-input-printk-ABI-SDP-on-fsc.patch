-
-	if (is_ext_layer) {
-		Lx_base = baddr + cfg->ext_layer * OVL_LAYER_OFFSET;
-		Lx_base += (DISP_REG_OVL_EL0_CON - DISP_REG_OVL_L0_CON);
-
-		Lx_clr_base = baddr + cfg->ext_layer * 0x4;
-		Lx_clr_base += (DISP_REG_OVL_EL0_CLR - DISP_REG_OVL_L0_CLR);
