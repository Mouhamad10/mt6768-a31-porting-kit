-	if (disp_info->layer_num[disp_idx] <= 0)
-		return false;
-
-	*rsz_idx = -1;
-	for (i = 0; i < disp_info->layer_num[disp_idx] && i < 2; i++) {
-		c = &disp_info->input_config[disp_idx][i];
