+		phy_data = devm_kzalloc(dev,
+		     sizeof(*phy_data) + phy_data_cnt * sizeof(*phy_data),
+		     GFP_KERNEL);
+		if (!phy_data) {
+			pr_err("%s out of memory\n", __func__);
+			return;
