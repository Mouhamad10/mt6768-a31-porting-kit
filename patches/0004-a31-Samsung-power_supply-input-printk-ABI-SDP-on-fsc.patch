+static kal_uint16 gain2reg(const kal_uint16 gain)
+{
+	kal_uint16 reg_gain = gain << 2;
+
+	if (reg_gain < SENSOR_BASE_GAIN)
+		reg_gain = SENSOR_BASE_GAIN;
+	else if (reg_gain > SENSOR_MAX_GAIN)
+		reg_gain = SENSOR_MAX_GAIN;
+
+	return (kal_uint16)reg_gain;
+}
+
+/*************************************************************************
+ * FUNCTION
+ *	set_gain
+ *
+ * DESCRIPTION
+ *	This function is to set global gain to sensor.
+ *
+ * PARAMETERS
+ *	iGain : sensor global gain(base: 0x40)
+ *
+ * RETURNS
+ *	the actually gain set to sensor.
+ *
+ * GLOBALS AFFECTED
+ *
+ ************************************************************************/
+static kal_uint16 set_gain(kal_uint16 gain)
+{
+	kal_uint16 reg_gain;
+	kal_uint32 temp_gain;
+	kal_int16 gain_index;
+	kal_uint16 GC5035B_AGC_Param[MAX_GAIN_INDEX][2] = {
+		{  256,  0 },
+		{  302,  1 },
+		{  358,  2 },
+		{  425,  3 },
+		{  502,  8 },
+		{  599,  9 },
+		{  717, 10 },
+		{  845, 11 },
+		{ 998,  12 },
+		{ 1203, 13 },
+		{ 1434, 14 },
+		{ 1710, 15 },
+		{ 1997, 16 },
+		{ 2355, 17 },
+		{ 2816, 18 },
+		{ 3318, 19 },
+		{ 3994, 20 },
+	};
+
+	reg_gain = gain2reg(gain);
+
+	for (gain_index = E_GAIN_INDEX - 1; gain_index >= 0; gain_index--) {
+		if (reg_gain >= GC5035B_AGC_Param[gain_index][0])
+			break;
+	}
+
+	write_cmos_sensor(0xfe, 0x00);
+	write_cmos_sensor(0xb6, GC5035B_AGC_Param[gain_index][1]);
+	temp_gain = reg_gain * Dgain_ratio / GC5035B_AGC_Param[gain_index][0];
+	write_cmos_sensor(0xb1, (temp_gain >> 8) & 0x0f);
+	write_cmos_sensor(0xb2, temp_gain & 0xfc);
+	LOG_INF("Exit! GC5035B_AGC_Param[gain_index][1] = 0x%x, temp_gain = 0x%x, reg_gain = %d\n",
+		GC5035B_AGC_Param[gain_index][1], temp_gain, reg_gain);
+
+	return reg_gain;
+}
