-	DISP_REG_SET(handle, DISP_REG_OVL_L0_CLIP + Lx_base, value);
-
-	switch (cfg->yuv_range) {
-	case 0:
-		color_matrix = 4;
-		break; /* BT601_full */
-	case 1:
-		color_matrix = 6;
-		break; /* BT601 */
-	case 2:
-		color_matrix = 7;
-		break; /* BT709 */
