+struct mtkfb_fence_buf_info *mtkfb_init_buf_info(
+	struct mtkfb_fence_buf_info *buf)
+{
+	INIT_LIST_HEAD(&buf->list);
+	buf->fence = MTK_FB_INVALID_FENCE_FD;
+	buf->hnd = NULL;
+	buf->idx = 0;
+	buf->mva = 0;
+	buf->cache_sync = 0;
+	buf->layer_type = 0;
+	return buf;
+}
