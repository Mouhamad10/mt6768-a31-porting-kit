+static irqreturn_t ex_eint_handler(int irq, void *data)
+{
+	if (moisture_ver != 0x1)
+		return ex_eint_handler_01(irq, data);
+	else
+		return ex_eint_handler_00(irq, data);
+
+	return IRQ_HANDLED;
+}
