-void usb_phy_switch_to_usb(void)
-{
-	unsigned int val = 0;
-
-	/* GPIO Selection */
-	val = readl(ap_gpio_base);
-	writel(val & (~(GPIO_SEL_MASK)), ap_gpio_base);
-
-	/* clear force_uart_en */
-	USBPHY_CLR32(0x68, (0x1 << 26));
-
-	/* Set rg_uart_mode 0x11F4_0868[31:30] to 2'b00 */
-	USBPHY_CLR32(0x68, (0x3 << 30));
-
-	in_uart_mode = false;
-
-	usb_phy_poweron();
-}
