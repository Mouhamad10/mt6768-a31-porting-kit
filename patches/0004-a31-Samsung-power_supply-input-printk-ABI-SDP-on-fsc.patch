-
-	first_frame_done = 0;
-	rdmafpscnt = 0;
-	up(&hdmi_update_mutex);
-
-	mmprofile_log_ex(ddp_mmp_get_events()->Extd_State, MMPROFILE_FLAG_END,
-			 Plugout, 0);
