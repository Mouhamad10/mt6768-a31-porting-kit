-static char *wdma_get_state(unsigned int status)
-{
-	switch (status) {
-	case 0x1:
-		return "idle";
-	case 0x2:
-		return "clear";
-	case 0x4:
-		return "prepare1";
-	case 0x8:
-		return "prepare2";
-	case 0x10:
-		return "data_transmit";
-	case 0x20:
-		return "eof_wait";
-	case 0x40:
-		return "soft_reset_wait";
-	case 0x80:
-		return "eof_done";
-	case 0x100:
-		return "soft_reset_done";
-	case 0x200:
-		return "frame_complete";
-	}
-	return "unknown-state";
-}
