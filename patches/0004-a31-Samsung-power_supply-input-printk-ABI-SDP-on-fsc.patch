-static bool cmode_effect_on(void)
-{
-	bool effect = false;
-
-
-	/* CMODE CHECK */
-	if (cable_mode == CABLE_MODE_CHRG_ONLY /*||
-		(cable_mode == CABLE_MODE_HOST_ONLY &&
-			chg_type != CHARGING_HOST)*/)
-		effect = true;
