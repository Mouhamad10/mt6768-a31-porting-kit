-
-	DISP_REG_SET_FIELD(handle, GLOBAL_CON_FLD_SOFT_RESET,
-			   idx * DISP_RDMA_INDEX_OFFSET +
-			   DISP_REG_RDMA_GLOBAL_CON, 0);
-
-	DISP_REG_CMDQ_POLLING(handle, idx * DISP_RDMA_INDEX_OFFSET +
