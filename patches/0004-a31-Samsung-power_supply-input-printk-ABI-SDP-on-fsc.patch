-				print_layer_config_args(module, cfg,
-							&layer_partial_roi);
-				ovl_layer_config(module, cfg->phy_layer,
-						pConfig->rsz_src_roi,
-						has_sec_layer, cfg,
-						&pConfig->ovl_partial_roi,
-						&layer_partial_roi, handle);
-				cfg->layer_disable_by_partial_update = 0;
-			} else {
