+ */
+
+#define PFX "GC02M1_pdafotp"
+#define LOG_INF(format, args...) pr_debug(PFX "[%s] " format, __func__, ##args)
+
+
+#include <linux/videodev2.h>
+#include <linux/i2c.h>
+#include <linux/platform_device.h>
+#include <linux/delay.h>
+#include <linux/cdev.h>
+#include <linux/uaccess.h>
+#include <linux/fs.h>
+#include <linux/atomic.h>
+#include <linux/slab.h>
+
+#include "kd_camera_typedef.h"
+#include "kd_imgsensor.h"
+#include "kd_imgsensor_define.h"
+#include "kd_imgsensor_errcode.h"
+#include "gc02m1mipiraw_Sensor.h"
+
+
+#define Sleep(ms) mdelay(ms)
+
+#define GC02M1_EEPROM_READ_ID  0xA5
+#define GC02M1_EEPROM_WRITE_ID 0xA4
+#define GC02M1_I2C_SPEED       100
+#define GC02M1_MAX_OFFSET      0xFFFF
+
+
+#define MTK_IDENTITY_VALUE 0x010B00FF
+#define LRC_SIZE 384
+#define DCC_SIZE 96
+
+struct EEPROM_PDAF_INFO {
+	kal_uint16 LRC_addr;
+	unsigned int LRC_size;
+	kal_uint16 DCC_addr;
+	unsigned int DCC_size;
+};
+
+enum EEPROM_PDAF_INFO_FMT {
+	MTK_FMT = 0,
+	OP_FMT,
+	FMT_MAX
+};
+
+static struct EEPROM_PDAF_INFO eeprom_pdaf_info[] = {
+	{/* MTK_FMT */
+		.LRC_addr = 0x14FE,
+		.LRC_size = LRC_SIZE,
+		.DCC_addr = 0x763,
+		.DCC_size = DCC_SIZE
+	},
+	{/* OP_FMT */
+		.LRC_addr = 0x1620,
+		.LRC_size = LRC_SIZE,
+		.DCC_addr = 0x18D0,
+		.DCC_size = DCC_SIZE
+	},
+};
+
+static DEFINE_MUTEX(ggc02m1_eeprom_mutex);
+
+static bool selective_read_eeprom(kal_uint16 addr, BYTE *data)
+{
+	char pu_send_cmd[2] = { (char)(addr >> 8), (char)(addr & 0xFF) };
+
+	if (addr > GC02M1_MAX_OFFSET)
+		return false;
+
+	if (iReadRegI2C(pu_send_cmd, 2, (u8 *) data,
+			1, GC02M1_EEPROM_READ_ID) < 0) {
+		return false;
+	}
+	return true;
+}
+
+static bool read_gc02m1_eeprom(kal_uint16 addr, BYTE *data, int size)
+{
+	int i = 0;
+	int offset = addr;
+
+	/*LOG_INF("enter read_eeprom size = %d\n", size);*/
+	for (i = 0; i < size; i++) {
+		if (!selective_read_eeprom(offset, &data[i]))
+			return false;
+		/*LOG_INF("read_eeprom 0x%0x %d\n", offset, data[i]);*/
+		offset++;
+	}
+	return true;
+}
+
+static struct EEPROM_PDAF_INFO *get_eeprom_pdaf_info(void)
+{
+	static struct EEPROM_PDAF_INFO *pinfo;
+	BYTE read_data[4];
+
+	mutex_lock(&ggc02m1_eeprom_mutex);
+	if (pinfo == NULL) {
+		read_gc02m1_eeprom(0x1, read_data, 4);
+		if (((read_data[3] << 24) |
+		     (read_data[2] << 16) |
+		     (read_data[1] << 8) |
+		     read_data[0]) == MTK_IDENTITY_VALUE) {
+			pinfo = &eeprom_pdaf_info[MTK_FMT];
+		} else {
+			pinfo = &eeprom_pdaf_info[OP_FMT];
+		}
+	}
+	mutex_unlock(&ggc02m1_eeprom_mutex);
+
+	return pinfo;
+}
+
+unsigned int read_gc02m1_LRC(BYTE *data)
+{
+	static BYTE GC02M1_LRC_data[LRC_SIZE] = { 0 };
+	static unsigned int readed_size;
+	struct EEPROM_PDAF_INFO *pinfo = get_eeprom_pdaf_info();
+
+	LOG_INF("read gc02m1 LRC, addr = %d, size = %u\n",
+		pinfo->LRC_addr, pinfo->LRC_size);
+
+	mutex_lock(&ggc02m1_eeprom_mutex);
+	if ((readed_size == 0) &&
+	    read_gc02m1_eeprom(pinfo->LRC_addr,
+			       GC02M1_LRC_data, pinfo->LRC_size)) {
+		readed_size = pinfo->LRC_size;
+	}
+	mutex_unlock(&ggc02m1_eeprom_mutex);
+
+	memcpy(data, GC02M1_LRC_data, pinfo->LRC_size);
+	return readed_size;
+}
+
+
+unsigned int read_gc02m1_DCC(BYTE *data)
+{
+	static BYTE GC02M1_DCC_data[DCC_SIZE] = { 0 };
+	static unsigned int readed_size;
+	struct EEPROM_PDAF_INFO *pinfo = get_eeprom_pdaf_info();
+
+	LOG_INF("read gc02m1 DCC, addr = %d, size = %u\n",
+		pinfo->DCC_addr, pinfo->DCC_size);
+
+	mutex_lock(&ggc02m1_eeprom_mutex);
+	if ((readed_size == 0) &&
+	    read_gc02m1_eeprom(pinfo->DCC_addr,
+			       GC02M1_DCC_data, pinfo->DCC_size)) {
+		readed_size = pinfo->DCC_size;
+	}
+	mutex_unlock(&ggc02m1_eeprom_mutex);
+
+	memcpy(data, GC02M1_DCC_data, pinfo->DCC_size);
+	return readed_size;
+}
+
