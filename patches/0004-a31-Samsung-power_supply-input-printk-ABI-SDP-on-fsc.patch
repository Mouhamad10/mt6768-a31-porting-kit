-			    __func__, __LINE__, ret);
-		return -1;
-	}
-	/* Set fake cmdq engineflag for judge path scenario */
-	cmdqRecSetEngine(qhandle, ((1LL << CMDQ_ENG_DISP_OVL1) |
-				  (1LL << CMDQ_ENG_DISP_WDMA1)));
