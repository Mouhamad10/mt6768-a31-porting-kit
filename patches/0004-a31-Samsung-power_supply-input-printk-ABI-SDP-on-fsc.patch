-static void lcm_mdelay(UINT32 ms)
-{
-	if (ms < 10)
-		udelay(ms * 1000);
-	else if (ms <= 20)
-		usleep_range(ms*1000, (ms+1)*1000);
-	else
-		msleep(ms);
