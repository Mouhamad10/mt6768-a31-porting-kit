-static kal_uint16 gain2reg(const kal_uint16 gain)
-{
-	kal_uint16 reg_gain = gain << 4;
-
-	if (reg_gain < SC820CS_SENSOR_BASE_GAIN)
-		reg_gain = SC820CS_SENSOR_BASE_GAIN;
