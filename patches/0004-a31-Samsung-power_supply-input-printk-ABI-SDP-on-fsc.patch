-
-	if (disp_iommu.inited)
-		return &disp_iommu;
-
-	for (larb_idx = 0; larb_idx < DISP_LARB_COUNT; larb_idx++) {
-
-		larb_node[larb_idx] = of_parse_phandle(mydev.dev.of_node,
