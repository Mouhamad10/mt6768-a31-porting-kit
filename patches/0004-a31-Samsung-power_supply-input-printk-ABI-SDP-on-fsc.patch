+static int smcdsd_set_doze(int mode)
+{
+	int ret = 0;
+
+	dbg_info("%s + doze_mode: %s\n", __func__, mode ? "DOZE_SUSPEND" : "DOZE");
+
+	if (mode == MTKFB_AOD_DOZE)
+		primary_display_set_aod(0);
+	else if (mode == MTKFB_AOD_DOZE_SUSPEND)
+		primary_display_set_aod(1);
+
+	return ret;
