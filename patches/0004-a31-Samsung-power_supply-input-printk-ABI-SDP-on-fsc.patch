-				bufLen -= reqLen;
-				textBuf += reqLen;
-				/* arg_c_i */
-				if (arg_c_type != 0) {
-					reqLen = snprintf(textBuf, bufLen,
-						"Reg%d\n", arg_c_i);
-					bufLen -= reqLen;
