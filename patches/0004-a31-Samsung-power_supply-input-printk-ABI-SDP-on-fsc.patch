-	mutex_lock(&ctx->mutex_lock);
-	ctx->mutex_idx |= 1 << (mutex_idx - DISP_MUTEX_DDP_FIRST);
-	mutex_unlock(&ctx->mutex_lock);
-	DDPDBG("release mutex %d, left mutex 0x%x!\n", mutex_idx,
-		ctx->mutex_idx);
