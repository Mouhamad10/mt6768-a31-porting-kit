-		return;
-
-	if (lcm_mode_status == 0)
-		return;
-
-	dsi_force_config = forceconfig;
-	/* cv switch by resume */
-	if (_dsi_context[0].dsi_params.PLL_CK_CMD == 0)
-		_dsi_context[0].dsi_params.PLL_CK_CMD =
-					_dsi_context[0].dsi_params.PLL_CLOCK;
