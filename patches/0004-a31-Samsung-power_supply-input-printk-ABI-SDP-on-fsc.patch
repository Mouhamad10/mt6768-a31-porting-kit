+int of_gpio_get_value(const char *gpioname)
+{
+	int ret = 0, gpio = 0, gpio_level;
+
+	gpio = of_get_gpio_with_name(gpioname);
+	if (!gpio_is_valid(gpio))
+		return -EINVAL;
+
+	gpio_level = gpio_get_value(gpio);
+	ret = gpio_level;
+
+	return ret;
