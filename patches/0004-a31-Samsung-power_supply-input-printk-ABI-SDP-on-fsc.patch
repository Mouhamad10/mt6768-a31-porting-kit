+static int dvt_mutex_mod(void *handle, unsigned int hwmutex_id, int mode,
+		unsigned int num)
+{
+	if (num == 0)
+		DISP_REG_SET(handle, DISP_REG_CONFIG_MUTEX_MOD0(hwmutex_id),
+				mode);
+	return 0;
+}
