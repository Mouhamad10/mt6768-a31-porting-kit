+			of_property_read_u32(nn, "mask", &data->mask);
+			of_property_read_u32(nn, "value", &data->value);
+			of_property_read_u32(nn, "host", &data->host);
+
+			pr_info("%s %s : 0x%x 0x%x 0x%x 0x%x 0x%x\n",
+				__func__, data->name,
+				data->offset, data->shift,
