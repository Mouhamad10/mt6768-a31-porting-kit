-int dpmgr_wait_event_timeout(disp_path_handle dp_handle,
-			     enum DISP_PATH_EVENT event, int timeout)
-{
-	int ret = -1;
-	struct ddp_path_handle *phandle;
-	struct DPMGR_WQ_HANDLE *wq_handle;
-	unsigned long long cur_time;
-
-	ASSERT(dp_handle);
