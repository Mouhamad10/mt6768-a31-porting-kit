-void cmdq_long_string(char *buf, u32 *offset, s32 *max_size,
-	const char *string, ...)
-{
-	int msg_len;
-	va_list arg_ptr;
-	char *buffer;
-
-	if (*max_size <= 0)
-		return;
-
-	va_start(arg_ptr, string);
-	buffer = buf + (*offset);
-	msg_len = vsnprintf(buffer, *max_size, string, arg_ptr);
-	*max_size -= msg_len;
-	if (*max_size < 0)
-		*max_size = 0;
-	*offset += msg_len;
-	va_end(arg_ptr);
-}
