+static void gc8034_otp_dpc_table_autoload(void)
+{
+	kal_uint32 bad_pixel_cnt_1 = 0;
+	kal_uint32 bad_pixel_cnt_2 = 0;
+	//STEP 1
+	//OTP read initial setting
+	write_cmos_sensor(0xfc, 0x00);
+	write_cmos_sensor(0xf7, 0x97); //0xf7[1]: 1'b1
+	write_cmos_sensor(0xfc, 0x00);
+	write_cmos_sensor(0xfc, 0x00);
+
+	write_cmos_sensor(0xfc, 0xee);
+	write_cmos_sensor(0xf2, 0x01); //OTP clock enable
+	write_cmos_sensor(0xf4, 0x88); //OTP enable
+
+	//STEP 2
+	// check count of bad pixel for OTP DPC
+	write_cmos_sensor(0xfe, 0x00);
+	write_cmos_sensor(0xd4, 0x00); //high address[1:0]
+
+	write_cmos_sensor(0xd5, 0x60); //addr:0x60
+	write_cmos_sensor(0xf3, 0x20); //total number of bad pixel
+	bad_pixel_cnt_1 = read_cmos_sensor(0xd7);
+
+	write_cmos_sensor(0xd5, 0x68); //addr:0x68
+	write_cmos_sensor(0xf3, 0x20); //invalid number of bad pixel
+	bad_pixel_cnt_2 = read_cmos_sensor(0xd7);
+	pr_info("%s, bad pixel cnt [1]: %#x, [2]: %#x\n",
+		__func__, bad_pixel_cnt_1, bad_pixel_cnt_2);
+
+	//STEP 3
+	//Set total defect pixel number
+	write_cmos_sensor(0x7b, (bad_pixel_cnt_1 + bad_pixel_cnt_2));
+	write_cmos_sensor(0x7e, 0x00);
+	write_cmos_sensor(0x7f, 0x70);
+
+	write_cmos_sensor(0x6e, 0x01);
+	write_cmos_sensor(0xbd, 0xd4);
+	write_cmos_sensor(0xbe, 0x9c);
+	write_cmos_sensor(0xbf, 0xa0);
+
+	write_cmos_sensor(0xfe, 0x01);
+	write_cmos_sensor(0xbe, 0x00);
+	write_cmos_sensor(0xa9, 0x01); //clear ram juan add
+	//STEP 4
+	//start autoload
+	write_cmos_sensor(0xfe, 0x00);
+	write_cmos_sensor(0x79, 0x2e); //autoload enable
+	write_cmos_sensor(0xf2, 0x41); //autoload start
+
+	//STEP 5
+	// 5ms delay
+	usleep_range(5000, 5001);
+
+	//STEP 6
+	//DPC ON
+	write_cmos_sensor(0xfe, 0x01);
+	write_cmos_sensor(0xbe, 0x01); //SRAM enable
+
+	write_cmos_sensor(0xfe, 0x00);
+	write_cmos_sensor(0x79, 0x00); //autoload off
+
+	write_cmos_sensor(0xf2, 0x00); //otp off juan add
+	write_cmos_sensor(0xf4, 0x80); //otp off juan add
+	write_cmos_sensor(0xfc, 0x00);
+	write_cmos_sensor(0xf7, 0x95); //0xf7[1]: 1'b0
+
+	write_cmos_sensor(0xfc, 0x00);
+	write_cmos_sensor(0xfc, 0x00);
+	write_cmos_sensor(0xfc, 0xee);
+
+	write_cmos_sensor(0x80, 0x13); //DPC &dd ON  juan change
+
+}
