-
-	if (pin < IMGSENSOR_HW_PIN_PDN  ||
-	    pin > IMGSENSOR_HW_PIN_DVDD ||
-	    pin_state < IMGSENSOR_HW_PIN_STATE_LEVEL_0 ||
-	    pin_state > IMGSENSOR_HW_PIN_STATE_LEVEL_HIGH)
-		ret = IMGSENSOR_RETURN_ERROR;
