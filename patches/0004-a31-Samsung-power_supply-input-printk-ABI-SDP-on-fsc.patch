-		ovl2mem_setlayernum(0);
-		ext_disp_path_change(EXTD_OVL_IDLE_REQ, session);
-#ifdef EXTD_DUAL_PIPE_SWITCH_SUPPORT
-		/* Notify primary display can switch to dual pipe */
-		set_hrt_state(DISP_HRT_FORCE_DUAL_OFF, 0);
-#endif
-	}
