+	write_cmos_sensor(0xfe, 0x00);
+	write_cmos_sensor(0x41, (frame_length >> 8) & 0x3f);
+	write_cmos_sensor(0x42, frame_length & 0xff);
+	LOG_DBG("Exit! framelength = %d\n", frame_length);
+}
