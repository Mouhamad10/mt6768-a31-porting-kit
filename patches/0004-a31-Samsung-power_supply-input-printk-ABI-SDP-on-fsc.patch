-	_cmdq_flush_config_handle_mira(cmdq_handle, 1);
-
-	cmdqRecDestroy(cmdq_handle);
-	cmdq_handle = NULL;
-
-	DISPCHECK("%s return\n", __func__);
-
-	_primary_path_unlock(__func__);
-
-	return 0;
