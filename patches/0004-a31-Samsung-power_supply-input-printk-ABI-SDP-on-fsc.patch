-	if ((path_info.old_session[DEV_WFD] != DISP_SESSION_MEMORY ||
-	     path_info.old_mode[DEV_WFD] >=
-	     DISP_SESSION_DIRECT_LINK_MIRROR_MODE) &&
-	    to_mode < DISP_SESSION_DIRECT_LINK_MIRROR_MODE) {
