-		return 0;
-	}
-
-	if (enable) {
-		if (otg_enable_status) {
-			HDMI_LOG("return in %d\n", __LINE__);
-			return 0;
-		}
-		hdmi_power_on();
-	} else {
-		hdmi_power_off();
-		switch_set_state(&hdmi_switch_data, HDMI_STATE_NO_DEVICE);
-	}
-
-	return 0;
