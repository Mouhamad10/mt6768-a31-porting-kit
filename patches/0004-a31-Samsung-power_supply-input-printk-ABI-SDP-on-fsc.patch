-					pmqos_list_record->mdp_throughput =
-						(total_pixel / numerator) -
-						(total_pixel / denominator);
-				max_throughput =
-					pmqos_list_record->mdp_throughput;
-				mdp_data_size =
-					mdp_list_pmqos->mdp_total_datasize;
