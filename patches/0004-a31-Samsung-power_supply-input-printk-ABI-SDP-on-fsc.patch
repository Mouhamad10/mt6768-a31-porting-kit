+static kal_uint32 streaming_control(kal_bool enable)
+{
+	LOG_INF("streaming_enable(0=Sw Standby,1=streaming): %d\n", enable);
+	if (enable) {
+		write_cmos_sensor(0xfe, 0x00);
+		write_cmos_sensor(0x3e, 0x91);
+		mDELAY(10);
+	} else {
+		write_cmos_sensor(0xfe, 0x00);
+		write_cmos_sensor(0x3e, 0x01);
+		mDELAY(10);
+	}
+	return ERROR_NONE;
+}
