-		imgsensor.min_frame_length = imgsensor.frame_length;
-		pr_debug("shutter: %d, frame_length: %d, cap.framelength: %d dummy_line: %d\n",
-			shutter, imgsensor.frame_length,
-			imgsensor_info.cap.framelength,
