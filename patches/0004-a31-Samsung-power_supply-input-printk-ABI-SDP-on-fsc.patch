-void dump_reg_row(unsigned long baddr, unsigned long offset, unsigned int count)
-{
-	const int buf_len = 7 + count * 11;
-	char buf[buf_len];
-	int len = 0, ret = 0;
-	int i = 0;
-	unsigned int val = 0;
-
-	if (count > 4)
-		return;
-
-	len += scnprintf(buf, buf_len, "0x%03lx:", offset);
-
-	for (i = 0; i < count; i++) {
-		val = INREG32(baddr + offset + 0x4 * i);
-		if (val)
-			ret = scnprintf(buf + len, buf_len - len,
-				       "0x%08x", val);
-		else
-			ret = scnprintf(buf + len, buf_len - len, "%10x", val);
-		len += ret;
-
-		if (i < count - 1)
-			ret = scnprintf(buf + len, buf_len - len, " ");
-		else if (i == count - 1)
-			ret = scnprintf(buf + len, buf_len - len, "\n");
-		len += ret;
-
-	}
-
-	DDPDUMP("%s", buf);
-}
