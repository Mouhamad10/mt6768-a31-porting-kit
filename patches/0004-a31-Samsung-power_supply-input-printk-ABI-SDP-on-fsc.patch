-		primary_display_is_video_mode());
-
-	if (primary_display_is_support_ARR() && dynamic_fps_changed) {
-		change_dsi_vfp(pgc->cmdq_handle_config, pgc->dynamic_fps);
-		dynamic_fps_changed = 0;
