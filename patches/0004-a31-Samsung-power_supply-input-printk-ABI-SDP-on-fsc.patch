-	case DDP_PHY_CLK_CHANGE:
-		return "DDP_PHY_CLK_CHANGE";
-	case DDP_ENTER_ULPS:
-		return "DDP_ENTER_ULPS";
-	case DDP_EXIT_ULPS:
-		return "DDP_EXIT_ULPS";
-	case DDP_RDMA_GOLDEN_SETTING:
-		return "DDP_RDMA_GOLDEN_SETTING";
-	case DDP_OVL_GOLDEN_SETTING:
