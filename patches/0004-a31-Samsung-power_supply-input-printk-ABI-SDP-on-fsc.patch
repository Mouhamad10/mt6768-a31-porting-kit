-		DISPDBG("DSI_RX_STA	: 0x%08x\n",
-			  AS_UINT32(&DSI_REG[dsi_i]->DSI_TRIG_STA));
-		DISPDBG("DSI_CMDQ_SIZE	: %d\n",
