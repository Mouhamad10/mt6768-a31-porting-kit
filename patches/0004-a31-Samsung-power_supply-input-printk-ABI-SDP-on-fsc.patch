-	} else {
-		struct OVL_CONFIG_STRUCT ovl_config;
-
-		_convert_disp_input_to_ovl(&ovl_config, &(cfg->input_cfg[0]));
-		dprec_mmp_dump_ovl_layer(&ovl_config,
