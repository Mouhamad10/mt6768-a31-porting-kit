-	unsigned int id = 0;
-	unsigned char buffer[1];
-	unsigned int array[16];
-
-//	SET_RESET_PIN(1);
-//	SET_RESET_PIN(0);
-	MDELAY(1);
-
-//	SET_RESET_PIN(1);
-	MDELAY(20);
-
-	array[0] = 0x00013700;  /* read id return 1byte */
-	dsi_set_cmdq(array, 1, 1);
-
-	read_reg_v2(0xDA, buffer, 1);
-	id = buffer[0];     /* we only need ID */
-
-	LCM_LOGI("%s,ft8720 id = 0x%08x\n", __func__, id);
-
-	if (id == LCM_ID_FT8720)
-		return 1;
-	else
-		return 0;
-}
