-		hfp_byte = 4;
-		DISPMSG("hfp is too short!\n");
-//		return -2;
-	}
-
-	DISPINFO(
-		"%s, mode=0x%x, t_vsa=%d, t_vbp=%d, t_vfp=%d, hsa_byte=%d, hbp_byte=%d, hfp_byte=%d, bllp_byte=%d\n",
