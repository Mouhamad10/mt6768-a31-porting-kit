-void init_log_buffer(void)
-{
-	int i, j, buf_size, buf_idx;
-	char *temp_buf;
-
-	/* 1.allocate debug buffer. This buffer used to store the output data.*/
-	debug_buffer = kcalloc(debug_buffer_size(), sizeof(char), GFP_KERNEL);
-	if (!debug_buffer)
-		goto err;
-
-	/* 2.allocate Error, Fence, Debug and Dump log buffer slot */
-	for (i = 0; i < DPREC_LOGGER_PR_NUM; i++) {
-		char **ptr;
-
-		ptr = kcalloc(dprec_logger_buffer[i].count, sizeof(char *),
-			GFP_KERNEL);
-		if (!ptr)
-			goto err;
-		dprec_logger_buffer[i].buffer_ptr = ptr;
-	}
-
-	/* 3.allocate log ring buffer. */
-	buf_size = sizeof(char) * (debug_buffer_size() - 4096);
-	temp_buf = kzalloc(buf_size, GFP_KERNEL);
-	if (!temp_buf)
-		goto err;
-
-	/* 4.dispatch log ring buffer to each buffer slot */
-	buf_idx = 0;
-
-	for (i = 0; i < DPREC_LOGGER_PR_NUM; i++) {
-		for (j = 0; j < dprec_logger_buffer[i].count; j++) {
-			char **ptr = dprec_logger_buffer[i].buffer_ptr;
-
-			ptr[j] = (temp_buf + buf_idx * LOGGER_BUFFER_SIZE);
-			buf_idx++;
-		}
-	}
