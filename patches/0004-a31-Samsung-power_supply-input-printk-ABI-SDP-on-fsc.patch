-	if (!task->secData.ispMeta.ispBufs[0].size ||
-		!task->secData.ispMeta.ispBufs[1].size ||
-		!task->secData.ispMeta.ispBufs[2].size) {
-		memset(&iwc->command.isp_metadata, 0,
