+	write_cmos_sensor_8(0x702, 0); // FLL Lshift reset
+	write_cmos_sensor_8(0x704, 0); // CIT Lshift reset
+	write_cmos_sensor(0x0340, imgsensor.frame_length);
+	write_cmos_sensor(0x0342, imgsensor.line_length);
+}
