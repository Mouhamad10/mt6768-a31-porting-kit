-		ret = ovl_switch_to_sec(module, handle);
-	else
-		ret = ovl_switch_to_nonsec(module, NULL);
-
-	if (ret)
-		DDPAEE("[SVP]fail to %s: ret=%d\n",
-		       __func__, ret);
-
-	return has_sec_layer;
-}
