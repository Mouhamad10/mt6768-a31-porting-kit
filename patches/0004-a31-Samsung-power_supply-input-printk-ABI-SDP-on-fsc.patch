+#include "imx582mipiraw_Sensor.h"
+
+
+#define Sleep(ms) mdelay(ms)
+
+#define IMX582_EEPROM_READ_ID  0xA0
+#define IMX582_EEPROM_WRITE_ID 0xA1
+#define IMX582_I2C_SPEED       100
+#define IMX582_MAX_OFFSET      0xFFFF
+
+
+#define MTK_IDENTITY_VALUE 0x010B00FF
+#define LRC_SIZE 384
+#define DCC_SIZE 96
+
+struct EEPROM_PDAF_INFO {
+	kal_uint16 LRC_addr;
+	unsigned int LRC_size;
+	kal_uint16 DCC_addr;
+	unsigned int DCC_size;
+};
+
+enum EEPROM_PDAF_INFO_FMT {
+	MTK_FMT = 0,
+	OP_FMT,
+	FMT_MAX
+};
+
+static struct EEPROM_PDAF_INFO eeprom_pdaf_info[] = {
+	{/* MTK_FMT */
+		.LRC_addr = 0x14FE,
+		.LRC_size = LRC_SIZE,
+		.DCC_addr = 0x763,
+		.DCC_size = DCC_SIZE
+	},
+	{/* OP_FMT */
+		.LRC_addr = 0x1620,
+		.LRC_size = LRC_SIZE,
+		.DCC_addr = 0x18D0,
+		.DCC_size = DCC_SIZE
+	},
+};
+
+static DEFINE_MUTEX(gimx582_eeprom_mutex);
+
+static bool selective_read_eeprom(kal_uint16 addr, BYTE *data)
+{
+	char pu_send_cmd[2] = { (char)(addr >> 8), (char)(addr & 0xFF) };
+
+	if (addr > IMX582_MAX_OFFSET)
+		return false;
+
+	if (iReadRegI2C(pu_send_cmd, 2, (u8 *) data,
+			1, IMX582_EEPROM_READ_ID) < 0) {
+		return false;
+	}
+	return true;
+}
+
+static bool read_imx582_eeprom(kal_uint16 addr, BYTE *data, int size)
+{
+	int i = 0;
+	int offset = addr;
+
+	/*LOG_INF("enter read_eeprom size = %d\n", size);*/
+	for (i = 0; i < size; i++) {
+		if (!selective_read_eeprom(offset, &data[i]))
+			return false;
+		/*LOG_INF("read_eeprom 0x%0x %d\n", offset, data[i]);*/
+		offset++;
+	}
+	return true;
+}
+
+static struct EEPROM_PDAF_INFO *get_eeprom_pdaf_info(void)
+{
+	static struct EEPROM_PDAF_INFO *pinfo;
+	BYTE read_data[4];
+
+	mutex_lock(&gimx582_eeprom_mutex);
+	if (pinfo == NULL) {
+		read_imx582_eeprom(0x1, read_data, 4);
+		if (((read_data[3] << 24) |
+		     (read_data[2] << 16) |
+		     (read_data[1] << 8) |
+		     read_data[0]) == MTK_IDENTITY_VALUE) {
+			pinfo = &eeprom_pdaf_info[MTK_FMT];
+		} else {
+			pinfo = &eeprom_pdaf_info[OP_FMT];
+		}
+	}
+	mutex_unlock(&gimx582_eeprom_mutex);
+
+	return pinfo;
+}
+
+unsigned int read_imx582_LRC(BYTE *data)
+{
+	static BYTE IMX582_LRC_data[LRC_SIZE] = { 0 };
+	static unsigned int readed_size;
+	struct EEPROM_PDAF_INFO *pinfo = get_eeprom_pdaf_info();
+
+	LOG_INF("read imx582 LRC, addr = %d, size = %u\n",
+		pinfo->LRC_addr, pinfo->LRC_size);
+
+	mutex_lock(&gimx582_eeprom_mutex);
+	if ((readed_size == 0) &&
+	    read_imx582_eeprom(pinfo->LRC_addr,
+			       IMX582_LRC_data, pinfo->LRC_size)) {
+		readed_size = pinfo->LRC_size;
+	}
+	mutex_unlock(&gimx582_eeprom_mutex);
+
+	memcpy(data, IMX582_LRC_data, pinfo->LRC_size);
+	return readed_size;
+}
+
+
+unsigned int read_imx582_DCC(BYTE *data)
+{
+	static BYTE IMX582_DCC_data[DCC_SIZE] = { 0 };
+	static unsigned int readed_size;
+	struct EEPROM_PDAF_INFO *pinfo = get_eeprom_pdaf_info();
+
+	LOG_INF("read imx582 DCC, addr = %d, size = %u\n",
+		pinfo->DCC_addr, pinfo->DCC_size);
+
+	mutex_lock(&gimx582_eeprom_mutex);
+	if ((readed_size == 0) &&
+	    read_imx582_eeprom(pinfo->DCC_addr,
+			       IMX582_DCC_data, pinfo->DCC_size)) {
+		readed_size = pinfo->DCC_size;
+	}
+	mutex_unlock(&gimx582_eeprom_mutex);
+
+	memcpy(data, IMX582_DCC_data, pinfo->DCC_size);
+	return readed_size;
+}
+
