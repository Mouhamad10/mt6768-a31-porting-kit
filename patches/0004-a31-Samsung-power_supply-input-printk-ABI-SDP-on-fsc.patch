-		ret = __setup_ext_session(session, mode);
-	} else if (DISP_SESSION_TYPE(session) == DISP_SESSION_MEMORY &&
-		   EXTD_OVERLAY_CNT == 0) {
-		MULTI_COTRL_ERR("memory session and ovl time sharing!\n");
