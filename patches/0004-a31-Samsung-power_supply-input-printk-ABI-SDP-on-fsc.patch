+bool s5k4hayxf_select_otp_page(unsigned int page)
+{
+	unsigned int complete = 0;
+	int retry = 3;
+
+	write_cmos_sensor_8(0x0A02, page);
+	write_cmos_sensor_8(0x0A00, 0x01);
+
+	do {
+		if (!retry) {
+			LOG_ERR("[%s] Can't read OTP", __func__);
+			break;
+		}
+		usleep_range(1000, 1000);
+		complete = read_cmos_sensor_8(0x0A01) & 0x01;
+		retry--;
+	} while (!complete);
+
+	return complete;
+}
+
+void s5k4hayxf_otp_off_setting()
+{
+	write_cmos_sensor_8(0x0A00, 0x04);
+	write_cmos_sensor_8(0x0A00, 0x00);
+}
+
+int s5k4hayxf_read_otp_cal(unsigned int addr, unsigned char *data, unsigned int size)
+{
+	int const PAGE_START_ADDR = 0x0A04, PAGE_END_ADDR = 0x0A43;
+	int const BANK_PAGE_SIZE = 4;
+	int i, otp_addr, otp_page;
+	unsigned int bank;
+	int bank_page[BANK_PAGE_SIZE] = {-1, 17, -1, 35};
+
+	write_cmos_sensor_8(0x0100, 0x01);
+	msleep(50);
+	s5k4hayxf_select_otp_page(17);
+	bank = read_cmos_sensor_8(PAGE_START_ADDR);
+
+	if (bank >= BANK_PAGE_SIZE || bank_page[bank] == -1) {
+		LOG_ERR("[%s] Invalid bank data %d", __func__, bank);
+		s5k4hayxf_otp_off_setting();
+		return -1;
+	}
+
+	LOG_INF("[%s] otp bank: %d", __func__, bank);
+	otp_page = bank_page[bank];
+
+	if (!s5k4hayxf_select_otp_page(otp_page)) {
+		LOG_ERR("[%s] Failed to select OTP bank page: %d", __func__, otp_page);
+		s5k4hayxf_otp_off_setting();
+		return -1;
+	}
+	otp_addr = PAGE_START_ADDR + 4;
+
+	for (i = 0; i < size; i++) {
+		if (otp_addr > PAGE_END_ADDR) {
+			s5k4hayxf_select_otp_page(++otp_page);
+			otp_addr = PAGE_START_ADDR;
+		}
+		*(data + i) = read_cmos_sensor_8(otp_addr++);
+	}
+
+	s5k4hayxf_otp_off_setting();
+
+	return size;
+}
+
