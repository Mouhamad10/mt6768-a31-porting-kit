+
+extern int iReadRegI2C(u8 *a_pSendData, u16 a_sizeSendData,
+				u8 *a_pRecvData, u16 a_sizeRecvData, u16 i2cId);
+
+extern int iWriteRegI2C(u8 *a_pSendData, u16 a_sizeSendData, u16 i2cId);
