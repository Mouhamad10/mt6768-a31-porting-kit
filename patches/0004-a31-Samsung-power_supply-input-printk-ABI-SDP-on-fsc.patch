+	.update_status = panel_set_brightness,
+	.check_fb = panel_check_fb_brightness,
+};
+
+static int nt36525b_read_id(struct lcd_info *lcd)
+{
+	int i = 0, ret = 0;
+	struct mipi_dsi_lcd_common *pdata = lcd->pdata;
+	static char *LDI_BIT_DESC_ID[BITS_PER_BYTE * LDI_LEN_ID] = {
+		[0 ... 23] = "ID Read Fail",
+	};
+
+	lcd->id_info.value = 0;
+
+	for (i = 0; i < LDI_LEN_ID; i++) {
+		ret = smcdsd_dsi_rx_info(lcd, LDI_REG_ID + i, 1, &lcd->id_info.id[i]);
+		if (ret < 0)
+			break;
+	}
+
+	if (ret < 0 || !lcd->id_info.value) {
+		pdata->lcdconnected = lcd->connected = 0;
+		dev_info(&lcd->ld->dev, "%s: connected lcd is invalid\n", __func__);
+
+		if (lcdtype)
+			smcdsd_abd_save_bit(&pdata->abd, BITS_PER_BYTE * LDI_LEN_ID, cpu_to_be32(lcd->id_info.value), LDI_BIT_DESC_ID);
+	}
+
+	dev_info(&lcd->ld->dev, "%s: %x\n", __func__, cpu_to_be32(lcd->id_info.value));
+
+	return ret;
+}
+
+static int nt36525b_read_init_info(struct lcd_info *lcd)
+{
+	int ret = 0;
+
+	struct mipi_dsi_lcd_common *pdata = lcd->pdata;
+
+	pdata->lcdconnected = lcd->connected = lcdtype ? 1 : 0;
+
+	lcd->id_info.id[0] = (lcdtype & 0xFF0000) >> 16;
+	lcd->id_info.id[1] = (lcdtype & 0x00FF00) >> 8;
+	lcd->id_info.id[2] = (lcdtype & 0x0000FF) >> 0;
+
+	dev_info(&lcd->ld->dev, "%s: %x\n", __func__, cpu_to_be32(lcd->id_info.value));
+
+	if (!lcd->fac_info)
+		return ret;
+
+	nt36525b_read_id(lcd);
+
+	return ret;
+}
+
+static int nt36525b_exit(struct lcd_info *lcd)
+{
+	int ret = 0;
+
+	dev_info(&lcd->ld->dev, "%s\n", __func__);
+
+	/* DO NOT REMOVE: back to page 1 for setting DCS commands */
+	DSI_WRITE(SEQ_NT36525B_BACK_TO_PAGE_1_A, ARRAY_SIZE(SEQ_NT36525B_BACK_TO_PAGE_1_A));
+	DSI_WRITE(SEQ_NT36525B_BACK_TO_PAGE_1_B, ARRAY_SIZE(SEQ_NT36525B_BACK_TO_PAGE_1_B));
+
+	DSI_WRITE(SEQ_NT36525B_DISPLAY_OFF, ARRAY_SIZE(SEQ_NT36525B_DISPLAY_OFF));
+
+	msleep(20);
+
+	DSI_WRITE(SEQ_NT36525B_SLEEP_IN, ARRAY_SIZE(SEQ_NT36525B_SLEEP_IN));
+
+	return ret;
+}
+
+static int nt36525b_init(struct lcd_info *lcd)
+{
+	int ret = 0;
+
+	dev_info(&lcd->ld->dev, "%s\n", __func__);
+
+	nt36525b_read_init_info(lcd);
+
+	smcdsd_dsi_tx_set(lcd, LCD_SEQ_INIT_1, ARRAY_SIZE(LCD_SEQ_INIT_1));
+
+	/* DO NOT REMOVE: back to page 1 for setting DCS commands */
+	DSI_WRITE(SEQ_NT36525B_BACK_TO_PAGE_1_A, ARRAY_SIZE(SEQ_NT36525B_BACK_TO_PAGE_1_A));
+	DSI_WRITE(SEQ_NT36525B_BACK_TO_PAGE_1_B, ARRAY_SIZE(SEQ_NT36525B_BACK_TO_PAGE_1_B));
+
+	DSI_WRITE(SEQ_NT36525B_BRIGHTNESS, ARRAY_SIZE(SEQ_NT36525B_BRIGHTNESS));
+
+	DSI_WRITE(SEQ_NT36525B_SLEEP_OUT, ARRAY_SIZE(SEQ_NT36525B_SLEEP_OUT));
+	msleep(100);
+	DSI_WRITE(SEQ_NT36525B_DISPLAY_ON, ARRAY_SIZE(SEQ_NT36525B_DISPLAY_ON));
+
+	return ret;
+}
