-				  ALIGN_TO(MTK_FB_YRES, MTK_FB_ALIGNMENT) * 4));
-
-		session_input.setter = SESSION_USER_PANDISP;
-		primary_display_config_input_multiple(&session_input);
-		primary_display_trigger(1, NULL, 0);
-
-		return 0;
-	}
-	default:
-		DISP_PR_INFO(
