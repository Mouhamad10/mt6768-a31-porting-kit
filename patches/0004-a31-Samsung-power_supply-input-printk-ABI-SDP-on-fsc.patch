-					 (rdma_underflow_irq_cnt[index] << 24) |
-					 (index << 16) | reg_val, module);
-	} else if (irq == ddp_get_module_irq(DISP_MODULE_MUTEX)) {
-		/* mutex0: primary disp */
-		/* mutex1: sub disp */
-		/* mutex2: aal */
-		unsigned int m_id = 0;
-
-		module = DISP_MODULE_MUTEX;
-		reg_val = DISP_REG_GET(DISP_REG_CONFIG_MUTEX_INTSTA) &
