+
+	// get start addr of crosstalk cal
+	xtc_cal_base_addr = IMGSENSOR_GET_CAL_ADDR_BY_SENSOR_IDX(sensor_dev_id, GET_CAL_CROSSTALK);
+	if (xtc_cal_base_addr == NULL) {
