-	data64 = 0LL;
-	data64 = CMDQ_REG_GET64_GPR_PX(CMDQ_DATA_REG_PQ_COLOR_DST);
-	if (data64 != 0xbeefbeef) {
-		CMDQ_ERR(
-			"[Read 64 bit from GPR_Px]TEST FAIL: PQ_DST reg value is 0x%llx\n",
-			data64);
-	}
