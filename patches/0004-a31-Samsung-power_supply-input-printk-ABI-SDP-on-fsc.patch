-						gseninf_mclk_name[i].pctrl);
-		atomic_set(&pclk->enable_cnt[i], 0);
-
-		if (IS_ERR(pclk->mclk_sel[i])) {
-			PK_PR_ERR("cannot get %d clock\n", i);
-			return SENINF_RETURN_ERROR;
-		}
