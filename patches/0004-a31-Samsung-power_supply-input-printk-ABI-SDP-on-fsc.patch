+				return sprintf(buf, "%s\n", "NG");
+			} else {
+				return sprintf(buf, "%s\n", "OK");
+			}
+		} else {
+			pr_err("[%s] NG, crc check fail", __func__);
+			return sprintf(buf, "%s\n", "NG");
+		}
+	} else {
+		pr_err(" NG, fw ver crc check fail");
+		return sprintf(buf, "%s\n", "NG");
+	}
+}
