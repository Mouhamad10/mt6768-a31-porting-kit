+static int dvt_mutex_sof(void *handle, unsigned int hwmutex_id, int sof)
+{
+	DISP_REG_SET(handle, DISP_REG_CONFIG_MUTEX_SOF(hwmutex_id), sof);
+	return 0;
+}
