-void rsz_dump_analysis(enum DISP_MODULE_ENUM module)
-{
-	unsigned long baddr = rsz_base_addr(module);
-	u32 enable = 0;
-	u32 con1 = 0;
-	u32 con2 = 0;
-	u32 int_flag = 0;
-	u32 in_size = 0;
-	u32 out_size = 0;
-	u32 in_pos = 0;
