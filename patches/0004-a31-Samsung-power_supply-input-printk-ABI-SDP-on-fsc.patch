+	if ((iReg >= ANALOG_GAIN_1) && (iReg < ANALOG_GAIN_2)) {
+		write_cmos_sensor(0xfe, 0x00);
+		write_cmos_sensor(0xb6, 0x00);
+		temp = 1024 * iReg / ANALOG_GAIN_1;
+		write_cmos_sensor(0xb1, (temp >> 8) & 0x3f);
+		write_cmos_sensor(0xb2, (temp & 0xff));
