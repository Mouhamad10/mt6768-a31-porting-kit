-/*************************** fps calculate ************************/
-#define FPS_ARRAY_SZ	30
-
-struct fps_ctx_t {
-	unsigned long long last_trig;
-	unsigned int array[FPS_ARRAY_SZ];
-	unsigned int total;
-	unsigned int wnd_sz;
-	unsigned int cur_wnd_sz;
