+static int lcm_driver_probe(struct device *dev, void const *data)
+{
+	pr_notice("[KE/LCM] %s() enter\n", __func__);
+
+	lcm_get_vgp_supply(dev);
+	lcm_request_gpio_control(dev);
+
+	return 0;
+}
