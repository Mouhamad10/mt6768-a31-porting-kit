-			"mau_cfg: start=0x%x,end=0x%x,virt(%d),io(%d),wr(%d),s_b32(%d),e_b32(%d)\n",
-		 mau_cfg.start,
-		 mau_cfg.end, mau_cfg.virt,
-		 mau_cfg.io, mau_cfg.write_monitor,
-		 mau_cfg.start_bit32,
-		 mau_cfg.end_bit32);
-
-	} else
-		M4ULOG_MID("mau no assert in set %d\n", mau);
-
-	return 0;
-}
