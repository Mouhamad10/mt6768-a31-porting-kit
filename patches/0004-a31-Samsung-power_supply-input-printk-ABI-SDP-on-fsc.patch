-			"[SEC]execute: TEEC_InvokeCommand:%u err:%d memex:%s\n",
-			cmd, status, share_mem_ex ? "true" : "false");
-	else
-		CMDQ_MSG(
-			"[SEC]execute: TEEC_InvokeCommand:%u ret:%d memex:%s\n",
-			cmd, status, share_mem_ex ? "true" : "false");
-
-	return status;
-}
