+static void DSI_send_vm_cmd(struct cmdqRecStruct *cmdq,
+				enum DISP_MODULE_ENUM module,
+				unsigned char data_id, unsigned int cmd,
+				unsigned int count, unsigned char *para_list,
+				unsigned char force_update)
