-#ifdef MTK_FB_MMDVFS_SUPPORT
-	/* update bandwidth */
-	disp_pm_qos_set_ovl_bw(in_fps, out_fps, &bandwidth);
-	disp_pm_qos_update_bw(bandwidth);
