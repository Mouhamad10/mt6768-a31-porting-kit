-		tx_params->vertical_backporch, tx_params->vertical_frontporch,
-		hsa_byte, hbp_byte, hfp_byte, bllp_byte);
-
-	for (i = DSI_MODULE_BEGIN(module); i <= DSI_MODULE_END(module); i++) {
