-	MDELAY(10);
-
-	pinctrl_select_state(lcd_pinctrl1, lcd_disp_pwm_gpio);
-
-	lcm_set_gpio_output(GPIO_LCD_LED_EN, GPIO_OUT_ZERO);
-	MDELAY(2);
-	lcm_set_gpio_output(GPIO_LCD_RST, GPIO_OUT_ZERO);
-	lcm_set_gpio_output(GPIO_LCD_PWR_ENP, GPIO_OUT_ZERO);
-	MDELAY(1);
