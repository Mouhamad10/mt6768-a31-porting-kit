-static int primary_display_frame_update_kthread(void *data)
-{
-	struct sched_param param = {.sched_priority = 94 };
-
-	sched_setscheduler(current, SCHED_RR, &param);
-	for (;;) {
-		wait_event_interruptible(primary_display_frame_update_wq,
