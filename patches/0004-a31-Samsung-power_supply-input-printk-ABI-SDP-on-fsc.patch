-				DDP_PR_ERR("wdma%d reset timeout!\n", idx);
-				break;
-			}
-		}
-	} else {
-		/* add comdq polling */
-	}
-	/* trigger soft reset */
-	DISP_REG_SET(handle, offset + DISP_REG_WDMA_RST, 0x0);
