+int write_cmos_sensor(kal_uint16 addr, kal_uint16 para)
+{
+	char pusendcmd[4] = {
+		(char)(addr >> 8), (char)(addr & 0xFF),
+		(char)(para >> 8), (char)(para & 0xFF) };
+	int ret = 0;
+
+	ret = iWriteRegI2CTiming(pusendcmd, 4,
+		imgsensor.i2c_write_id, imgsensor_info.i2c_speed);
+	return ret;
+}
