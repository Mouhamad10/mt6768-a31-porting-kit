-static int write_cmos_sensor(kal_uint32 addr, kal_uint32 para)
-{
-	char pu_send_cmd[3] = {
-		(char)(addr >> 8), (char)(addr & 0xFF), (char)(para & 0xFF) };
-
-	return iWriteRegI2CTiming(
-	    pu_send_cmd, 3, imgsensor.i2c_write_id, imgsensor_info.i2c_speed);
-}
