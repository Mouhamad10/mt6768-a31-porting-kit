-		break;
-	case HAL_DATASPACE_TRANSFER_GAMMA2_6:
-	case HAL_DATASPACE_TRANSFER_GAMMA2_8:
-		DISP_PR_ERR("%s: ovl does not support gamma 2.6/2.8\n",
-			    __func__);
-		/* fall through */
-	case HAL_DATASPACE_TRANSFER_ST2084:
-	case HAL_DATASPACE_TRANSFER_HLG:
