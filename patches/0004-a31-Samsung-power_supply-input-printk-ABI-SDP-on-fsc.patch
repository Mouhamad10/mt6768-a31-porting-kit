-int ddp_get_module_num_l(int *module_list)
-{
-	unsigned int num = 0;
-
-	while (*(module_list + num) != -1) {
-		num++;
-
-		if (num == DDP_ENING_NUM)
-			break;
-	}
-	return num;
-}
