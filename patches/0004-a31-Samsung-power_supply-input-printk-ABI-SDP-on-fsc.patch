-static int alloc_buffer_from_dma(size_t size, struct test_buf_info *buf_info)
-{
-	int ret = 0;
-	unsigned long size_align;
-	unsigned int mva = 0;
-
-	size_align = round_up(size, PAGE_SIZE);
-
-	buf_info->buf_va = dma_alloc_coherent(disp_get_device(), size,
