-int debug_buffer_size(void)
-{
-#if defined(CONFIG_MT_ENG_BUILD) || !defined(CONFIG_MTK_GMO_RAM_OPTIMIZE)
-	static int size;
-
-	if (size == 0) {
-		int i;
-
-		size += 4096;
-		for (i = 0; i < DPREC_LOGGER_PR_NUM; i++)
-			size += dprec_logger_buffer[i].count *
-			    LOGGER_BUFFER_SIZE;
-	}
-	return size;
