-static void disc_threshold_to_max(int act)
-{
-	u32 val;
-
-	usb_prepare_enable_clock(true);
-
-	val = USBPHY_READ32(0x18);
-	DBG(0, "val<0x%x>\n", val);
-
-	/* 0x18, 7-4 RG_USB20_DISCTH, dft:1000 */
-	if (act == DO_IT) {
-		USBPHY_SET32(0x18, (0xf0<<0));
-	} else {
