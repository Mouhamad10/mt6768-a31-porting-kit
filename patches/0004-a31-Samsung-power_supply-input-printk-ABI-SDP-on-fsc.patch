-static int aw3644_i2c_probe(struct i2c_client *client,
-	const struct i2c_device_id *id)
-{
-	struct aw3644_chip_data *chip;
-	struct aw3644_platform_data *pdata = client->dev.platform_data;
-	int err;
-
-	pr_info("%s start.\n", __func__);
