+}
+
+static bool lcm_set_hbm_wait(bool wait)
+{
+	bool old = hbm_wait;
+
+	hbm_wait = wait;
+	return old;
+}
+
+static bool lcm_set_hbm_cmdq(bool en, void *qhandle)
+{
+	bool old = hbm_en;
+
+	if (hbm_en == en)
+		goto done;
+
+	if (en)
+		push_table(NULL, hbm_on, ARRAY_SIZE(hbm_on), 1);
+	else
+		push_table(NULL, hbm_off, ARRAY_SIZE(hbm_off), 1);
+
+	hbm_en = en;
+	lcm_set_hbm_wait(true);
+
+done:
+	return old;
+}
