+		.init = hdmi_factory_mode_init,
+		.deinit = NULL,
+		.enable = NULL,
+		.power_enable = NULL,
+		.set_audio_enable = NULL,
+		.set_resolution = NULL,
+		.get_dev_info = NULL,
+		.get_capability = NULL,
+		.get_edid = NULL,
+		.wait_vsync = NULL,
+		.fake_connect = NULL,
+		.factory_mode_test = hdmi_factory_mode_test,
+		.ioctl = NULL
+#else
+		.init = 0
+#endif
+	};
+
+	return &extd_factory_hdmi;
+}
