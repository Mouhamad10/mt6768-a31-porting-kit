+static kal_uint32 set_test_pattern_mode(kal_bool enable)
+{
+	LOG_INF("enable: %d\n", enable);
+
+	if (enable) {
+		write_cmos_sensor(0xfe, 0x01);
+		write_cmos_sensor(0x8c, 0x11);
+		write_cmos_sensor(0xfe, 0x00);
+	} else {
+		write_cmos_sensor(0xfe, 0x01);
