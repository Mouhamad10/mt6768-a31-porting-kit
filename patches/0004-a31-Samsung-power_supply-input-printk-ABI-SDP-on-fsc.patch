-	if (cmdq_first_err.flag == false)
-		return;
-
-	if (rowsize != 16 && rowsize != 32)
-		rowsize = 16;
-
-	for (i = 0; i < len; i += rowsize) {
-		linelen = min(remaining, rowsize);
-		remaining -= rowsize;
-
-		cmdq_core_hex_dump_to_buffer(ptr + i, linelen, rowsize,
