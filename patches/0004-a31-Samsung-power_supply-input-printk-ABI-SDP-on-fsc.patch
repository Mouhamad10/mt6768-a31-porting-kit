+		write_cmos_sensor(0xb2, (temp & 0xff));
+		LOG_DBG("analogic gain 2.0x, add pregain = %d\n", temp);
+	} else if ((iReg >= ANALOG_GAIN_6) && (iReg < ANALOG_GAIN_7)) {
+		write_cmos_sensor(0xfe, 0x00);
