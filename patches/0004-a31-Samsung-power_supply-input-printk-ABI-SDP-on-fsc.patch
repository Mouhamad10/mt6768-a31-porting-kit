+	write_cmos_sensor(0x0B00, 0x0100);
+	write_cmos_sensor(0x6000, 0x0085);
+
+	// 10 ms delay
+	usleep_range(10000, 10000);
+
+	//Datamode: 1 byte
+	write_cmos_sensor(0xFCFC, 0x4000);
+	write_cmos_sensor(0x6000, 0x0085);
+}
