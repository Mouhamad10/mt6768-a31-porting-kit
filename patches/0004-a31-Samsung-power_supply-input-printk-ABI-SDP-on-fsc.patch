-static unsigned int
-__disp_sync_query_buf_info(unsigned int session_id, unsigned int timeline_id,
-			   unsigned int fence_idx, unsigned long *mva,
-			   unsigned int *size, int need_sync)
-{
-	struct disp_sync_info *l_info = NULL;
