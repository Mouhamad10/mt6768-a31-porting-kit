-static void _primary_protect_mode_switch(void)
-{
-	int try_cnt = 50;
-
-	while ((--try_cnt) && atomic_read(&hwc_configing)) {
-		udelay(1000);
-		/* DISPCHECK("detecting protect mode switch\n"); */
-	}
-	if (try_cnt <= 0)
-		DISPCHECK("display warning:switch mode when hwc config\n");
-}
