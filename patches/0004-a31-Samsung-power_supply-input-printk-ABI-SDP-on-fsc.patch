-					 cfg, NULL, NULL, handle);
-
-			if (cfg->ext_layer == -1)
-				phy_fbdc_en &= ~(1 << cfg->phy_layer);
-			else
-				ext_fbdc_en &= ~(1 << (cfg->ext_layer + 4));
