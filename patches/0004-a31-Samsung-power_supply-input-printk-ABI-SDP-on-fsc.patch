-static int primary_display_trigger_nolock(int blocking, void *callback,
-					  int need_merge)
-{
-	int ret = 0;
-
-	DISPFUNC();
-
-	last_primary_trigger_time = sched_clock();
-	if (is_switched_dst_mode) {
-		/* switch to VDO mode if trigger disp */
-		primary_display_switch_dst_mode(1);
