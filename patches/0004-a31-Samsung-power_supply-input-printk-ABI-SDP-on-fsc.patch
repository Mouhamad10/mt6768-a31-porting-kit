-int DSI_check_roi(void)
-{
-	int ret = 0;
-	unsigned char read_buf[4] = { 1, 1, 1, 1 };
-	unsigned int data_array[16];
-	int count;
-	int x0;
-	int y0;
-
-	data_array[0] = 0x00043700; /* read id return two byte,version and id */
-	DSI_set_cmdq(DISP_MODULE_DSI0, NULL, data_array, 1, 1);
-	msleep(20);
