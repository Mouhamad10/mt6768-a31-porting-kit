+#include <linux/mutex.h>
+
+#define __my_wait_event_interruptible_timeout(wq, ret)          \
+do {                                                            \
+	DEFINE_WAIT(__wait);                                    \
+	prepare_to_wait(&wq, &__wait, TASK_INTERRUPTIBLE);      \
+	if (!signal_pending(current)) {                        \
+		ret = schedule_timeout(ret);			\
+		if (!ret)                                      \
+			break;					\
+	}                                                     \
+	ret = -ERESTARTSYS;                                     \
+	break;                                                  \
+	finish_wait(&wq, &__wait);                              \
+} while (0)
+
