+static irqreturn_t panel_conn_det_handler(int irq, void *dev_id)
+{
+	struct lcd_info *lcd = (struct lcd_info *)dev_id;
+
+	dev_info(&lcd->ld->dev, "%s\n", __func__);
+
+	queue_work(lcd->conn_workqueue, &lcd->conn_work);
+
+	lcd->conn_det_count++;
+
+	return IRQ_HANDLED;
+}
