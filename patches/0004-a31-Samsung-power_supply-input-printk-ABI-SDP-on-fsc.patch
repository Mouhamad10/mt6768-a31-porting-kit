+static void set_dummy(void)
+{
+	kal_uint32  vb = 40;
+	kal_uint32  basic_line = 2484;
+
+	LOG_INF("dummyline = %d, dummypixels = %d\n",
+			imgsensor.dummy_line, imgsensor.dummy_pixel);
+	vb = imgsensor.frame_length - basic_line;
+	vb = vb >> 1;
+	vb = vb << 1;
+	vb = vb < 40 ? 40 : vb;
+	vb = vb > 8190 ? 8190 : vb;
+	write_cmos_sensor(0xfe, 0x00);
+	write_cmos_sensor(0x07, (vb >> 8) & 0x1f);
+	write_cmos_sensor(0x08, vb & 0xfe);
+
+	LOG_INF("Exit! framelength = %d\n", imgsensor.frame_length);
+	LOG_INF("Exit! vertical blanking = %d\n", vb);
+}
