-			&pf_idx);
-		mtkfb_release_present_fence(primary_session_id,
-			pf_idx);
-		_primary_path_unlock(__func__);
-
-		if (atomic_read(&od_trigger_kick)) {
-			atomic_set(&od_trigger_kick, 0);
-			__primary_check_trigger();
-		}
-	}
-
-	return 0;
