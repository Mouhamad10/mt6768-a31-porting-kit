+		break;
+	case SENSOR_FEATURE_SET_AWB_GAIN:
+	LOG_INF("SENSOR_FEATURE_SET_AWB_GAIN = %d\n", feature_id);
+ #if defined(CONFIG_TRAN_CAMERA_SYNC_AWB_TO_KERNEL)
+		set_awbgain((UINT32)(*feature_data_32),
