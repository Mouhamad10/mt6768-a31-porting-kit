-	int array[4];
-
-	array[0] = 0x00013700;
-	dsi_set_cmdq(array, 1, 1);
-
-	read_reg_v2(0x0A, buffer, 1);
-
-	if (buffer[0] != 0x9C) {
-		pr_debug("[LCM ERROR] [0x53]=0x%02x\n", buffer[0]);
-		return TRUE;
-	}
-	pr_debug("[LCM NORMAL] [0x53]=0x%02x\n", buffer[0]);
-	return FALSE;
-}
