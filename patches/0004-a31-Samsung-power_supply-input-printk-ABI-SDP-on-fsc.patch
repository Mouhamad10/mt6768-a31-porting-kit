-/*************************************************************************
-* FUNCTION
-*	get_imgsensor_id
-*
-* DESCRIPTION
-*	This function get the sensor ID
-*
-* PARAMETERS
-*	*sensorID : return the sensor ID
-*
-* RETURNS
-*	None
-*
-* GLOBALS AFFECTED
-*
-*************************************************************************/
-static kal_uint32 get_imgsensor_id(UINT32 *sensor_id)
-{
-	kal_uint8 i = 0;
-
-	kal_uint8 retry = 2, vendor_id = 0;
-	vendor_id = get_vendor_id();
-	printk("8856ofilm------0x%x\n",vendor_id);
-    if (vendor_id != 0x07) {
-      pr_err("Vendor_id: 0x%x, this should be 0x07!\n", vendor_id);
-      *sensor_id = 0xFFFFFFFF;
-      return ERROR_SENSOR_CONNECT_FAIL;
-    }
-
-	/*sensor have two i2c address 0x6c 0x6d & 0x21 0x20, we should detect the module used i2c address*/
-	while (imgsensor_info.i2c_addr_table[i] != 0xff) {
-		spin_lock(&imgsensor_drv_lock);
-		imgsensor.i2c_write_id = imgsensor_info.i2c_addr_table[i];
-		spin_unlock(&imgsensor_drv_lock);
-		do {
-			*sensor_id = (((read_cmos_sensor(0x300B) << 8) | read_cmos_sensor(0x300C)))+1;
-			if (*sensor_id == imgsensor_info.sensor_id) {
-				pr_err("i2c write id: 0x%x, sensor id: 0x%x, ver = 0x%x<0xB1=r2a,0xB0=r1a>\n",
-					imgsensor.i2c_write_id, *sensor_id, read_cmos_sensor(0x302A));
-				return ERROR_NONE;
-			}
-			pr_err("Read sensor id fail,write_id:0x%x, id: 0x%x\n", imgsensor.i2c_write_id, *sensor_id);
-			retry--;
-		} while (retry > 0);
-		i++;
-		retry = 2;
-	}
-	if (*sensor_id != imgsensor_info.sensor_id) {
-		/* if Sensor ID is not correct, Must set *sensor_id to 0xFFFFFFFF */
-		*sensor_id = 0xFFFFFFFF;
-		return ERROR_SENSOR_CONNECT_FAIL;
-	}
-	return ERROR_NONE;
-}
