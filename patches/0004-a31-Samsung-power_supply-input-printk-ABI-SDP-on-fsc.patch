-	pte = imu_pte_offset_map(pgd, seed_mva);
-	backup = imu_pte_val(*pte);
-	if (!g4_mode) {
-		imu_pte_val(*pte) = 0x2;
-		fault_pa = 0;
-	} else {
-		imu_pte_val(*pte) = 0x10000002;
-		fault_pa = 0x10000000;
-	}
-#else
-	backup = imu_pgd_val(*pgd);
-	if (!g4_mode) {
-		imu_pgd_val(*pgd) = 0x2;
