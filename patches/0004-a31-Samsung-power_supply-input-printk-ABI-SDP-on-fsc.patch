+static void sensor_init(void)
+{
+	LOG_INF(" - E");
+	set_mode_setfile(IMGSENSOR_MODE_INIT);
+	LOG_INF(" - X");
+}				/*  s5k4hayxfMIPI_Sensor_Init  */
