-	if (!inited) {
-		INIT_DELAYED_WORK(&disconnect_check_work,
-			do_disconnect_check_work);
-		inited = 1;
-	}
-	queue_delayed_work(mtk_musb->st_wq, &disconnect_check_work, 0);
