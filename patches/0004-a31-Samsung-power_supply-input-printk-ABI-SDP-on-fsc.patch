-			CMDQ_VERBOSE("%s", long_msg);
-
-			*((u32 *)(pWriteAddr->va + offset)) = value;
-			break;
-		}
-	}
-	spin_unlock_irqrestore(&cmdq_write_addr_lock, flags);
-
-	return value;
-}
