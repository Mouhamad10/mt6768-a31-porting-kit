-	u32 size_to_read = size;
-
-	int ret = 0;
-
-	while (size_to_read > 0) {
-		u8 page = addr / PAGE_SIZE_;
-		u8 offset = addr % PAGE_SIZE_;
-		char *Buff = data;
-
-		if (iReadRegI2C(&offset, 1, (u8 *)Buff, 1,
-			i2c_id + (page << 1)) < 0) {
-			pr_debug("fail addr=0x%x 0x%x, P=%d, offset=0x%x",
