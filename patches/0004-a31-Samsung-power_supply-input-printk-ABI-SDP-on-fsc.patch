+{
+	int i = 0;
+
+	for (i = 0; i < data_size; i += 2)
+		LOG_INF("0x%04x", ((rom_cal_buf[i] << 8) & 0xFF00) | (rom_cal_buf[i + 1] & 0XFF));
+}
+#endif
