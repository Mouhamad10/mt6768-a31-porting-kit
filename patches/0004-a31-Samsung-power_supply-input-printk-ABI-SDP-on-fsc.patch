-#else
-#define DSI_OUTREGBIT(spi_en, cmdq, TYPE, REG, bit, value) \
-do { \
-	TYPE r; \
-	TYPE v; \
-	if (spi_en) { \
-		*(unsigned int *)(&r) = (0x00000000); \
-		r.bit = ~(r.bit); \
-		mtk_spi_mask_write((unsigned long)(&REG), AS_UINT32(&r), value); \
