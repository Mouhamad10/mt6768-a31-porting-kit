+		err = derive_fek_v1(ci->ci_inode, ci, derived_key, ci->ci_mode->keysize);
+		if (err) {
+			if (fscrypt_sdp_is_sensitive(ci)) {
+				cmd = sdp_fs_command_alloc(FSOP_AUDIT_FAIL_DECRYPT,
+						current->tgid, ci->ci_sdp_info->engine_id, -1,
+						ci->ci_inode->i_ino, err, GFP_NOFS);
+				if (cmd) {
+					sdp_fs_request(cmd, NULL);
+					sdp_fs_command_free(cmd);
+				}
+			}
+
+			goto out;
+		}
+
+		/* eMMC + F2FS security OTA only */
+		if (S_ISREG(ci->ci_inode->i_mode) &&
+			(ci->ci_policy.version == FSCRYPT_POLICY_V1) &&
+			ci->ci_policy.v1.contents_encryption_mode == 1) {
+			if (ci->ci_policy.v1.flags & FSCRYPT_POLICY_FLAG_IV_INO_LBLK_32) {
+				int res;
+				union {
+						siphash_key_t k;
+						u8 bytes[SHA256_DIGEST_SIZE];
+					} ino_hash_key;
+
+				/* hashed_ino = SipHash(key=SHA256(master_key), data=i_ino) */
+				res = derive_essiv_salt_v1(derived_key, ci->ci_mode->keysize,
+						ino_hash_key.bytes);
+				if (res)
+					goto out;
+
+				ci->ci_hashed_info = siphash_1u64(ci->ci_inode->i_ino, &ino_hash_key.k);
+			}
+		}
+
+		fscrypt_sdp_update_conv_status(ci);
+		err = fscrypt_set_per_file_enc_key(ci, derived_key);
+
