+		if (cable_mode != cmode) {
+			cable_mode = cmode;
+			mt_usb_reconnect();
+			/* let conection work do its job */
+			msleep(50);
+		}
+		if (mtk_musb)
+			up(&mtk_musb->musb_lock);
