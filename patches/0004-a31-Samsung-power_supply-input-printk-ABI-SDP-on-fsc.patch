-unsigned int mtkfb_fm_auto_test(void)
-{
-	unsigned int result = 0;
-	unsigned int i = 0;
-	unsigned long fbVirAddr;
-	UINT32 fbsize;
-	int ret = 0;
-	unsigned int *fb_buffer;
