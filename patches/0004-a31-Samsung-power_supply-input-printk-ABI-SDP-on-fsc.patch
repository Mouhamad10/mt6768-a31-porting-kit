-		PK_DBG("TOP_MUX_SENINF = %lu\n",
-			clk_get_rate(
-			pclk->mclk_sel[SENINF_CLK_IDX_SYS_TOP_MUX_SENINF]));
-	}
-	return mt_get_ckgen_freq(clk);
-#else
-	return 0;
-#endif
-}
