+		DSI_OUTREG32(cmdq, &read_data1,
+			AS_UINT32(&DSI_REG[d]->DSI_RX_DATA1));
+		DSI_OUTREG32(cmdq, &read_data2,
+			AS_UINT32(&DSI_REG[d]->DSI_RX_DATA2));
+		DSI_OUTREG32(cmdq, &read_data3,
+			AS_UINT32(&DSI_REG[d]->DSI_RX_DATA3));
