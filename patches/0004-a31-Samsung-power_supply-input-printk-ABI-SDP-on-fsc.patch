-
-			if (_is_lcm_cmd_mode(module)) {
-				struct DSI_T0_INS t0;
-
-				t0.CONFG = 0x09;
-				t0.Data_ID = 0x39;
-				t0.Data0 = 0x2c;
-				t0.Data1 = 0;
-
-				DSI_OUTREG32(cmdq, &DSI_CMDQ_REG[i]->data[0],
-					     AS_UINT32(&t0));
-				DSI_OUTREG32(cmdq, &DSI_REG[i]->DSI_CMDQ_SIZE,
