+	for (; i < readsize; i++) {
+		//OTP access address
+		write_otp(client, 0x17, OTP_addr_1);
+
+		OTP_addr = OTP_addr + 8;
+		OTP_addr_1 = OTP_addr&0xFF;
+
+		//OTP read pulse
+		write_otp(client, 0xf3, 0x34);
+		//Read
+		*(read_data+i) = read_otp(client, 0x19);
+	}
+	return size;
+}
