-	if (DISP_SESSION_DEV(session) == DEV_EINK + 1)
-		pgc->suspend_config = 1;
-
-	pgc->state = EXTD_SUSPEND;
-
-	_ext_disp_path_unlock();
-
-	mmprofile_log_ex(ddp_mmp_get_events()->Extd_State, MMPROFILE_FLAG_PULSE,
