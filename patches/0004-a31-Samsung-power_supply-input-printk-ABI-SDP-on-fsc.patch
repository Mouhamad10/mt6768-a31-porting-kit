+	if (IMGSENSOR_GET_CAL_BUF_BY_SENSOR_IDX(sensor_dev_id, &rom_cal_buf) < 0) {
+		LOG_ERR("cal data is NULL, sensor_dev_id: %d", sensor_dev_id);
+		return;
