+	kal_uint8 isp_driving_current;	//mclk driving current
+	kal_uint8 sensor_interface_type;	//sensor_interface_type
+	//0,MIPI_OPHY_NCSI2; 1,MIPI_OPHY_CSI2, default is NCSI2,
