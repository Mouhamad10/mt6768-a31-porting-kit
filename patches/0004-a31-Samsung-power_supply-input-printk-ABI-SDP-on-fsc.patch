-			*(unsigned int *)(&v) = (0x00000000); \
-			v.bit = value; \
-			DISP_REG_MASK(cmdq, &REG, AS_UINT32(&v), AS_UINT32(&r)); \
-		} else { \
-			DSI_SET_VAL(NULL, &r, INREG32(&REG)); \
-			r.bit = (value); \
-			DISP_REG_SET(cmdq, &REG, DSI_GET_VAL(&r)); \
-		} \
