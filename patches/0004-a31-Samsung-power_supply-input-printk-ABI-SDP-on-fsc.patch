-		return 0;
-	}
-
-	cmdqRecCreate(CMDQ_SCENARIO_PRIMARY_DISP, &cmdq_handle);
-	cmdqRecReset(cmdq_handle);
-
-	_cmdq_insert_wait_frame_done_token_mira(cmdq_handle);
