+				LOG_INF("module info Check sum %d error!! check sum = %d, sum = %d\n",
+					index + 1, info[MODULE_INFO_SIZE - 1], (check % 255 + 1));
+			break;
+		case 0x08:
+		case 0x0c:
+			LOG_INF("module info group %d is invalid!!\n", index + 1);
+			break;
+		default:
+			break;
+		}
+}
