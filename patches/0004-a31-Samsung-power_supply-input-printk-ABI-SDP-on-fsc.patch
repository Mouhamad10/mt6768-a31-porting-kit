+UINT32 GC02M1B_MIPI_MONO_SensorInit(struct SENSOR_FUNCTION_STRUCT **pfFunc)
+{
+	/* To Do : Check Sensor status here */
+	if (pfFunc != NULL)
+		*pfFunc =  &sensor_func;
+	return ERROR_NONE;
+}	/*	GC02M1B_MIPI_RAW_SensorInit	*/
