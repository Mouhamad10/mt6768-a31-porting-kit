-		read_spc_flag = TRUE;
-		return;
-	}
-
-	for (i = 0; i < 126; i++) {
-		write_cmos_sensor(start_reg, imx398_SPC_data[i]);
-		start_reg++;
-	}
-	start_reg = 0x7f00;
-	for (i = 0; i < 126; i++) {
-		write_cmos_sensor(start_reg, imx398_SPC_data[i]);
-
-		start_reg++;
-	}
-
