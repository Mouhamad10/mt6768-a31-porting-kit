-
-	DISP_REG_SET(handle, ovl_base + DISP_REG_OVL_LC_OFFSET,
-		((lc_y << 16) | lc_x));
-
-	DISP_REG_SET(handle, ovl_base + DISP_REG_OVL_LC_SRC_SIZE,
-		((lc_h << 16) | lc_w));
-
-	DDPMSG("%s_lc:(%d,%d,%dx%d)\n",
-		ddp_get_module_name(module), lc_x, lc_y, lc_w, lc_h);
-
-	return 0;
