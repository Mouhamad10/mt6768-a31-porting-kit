-
-	session_id = cfg->session_id;
-
-	if (session_info) {
-		input_event = &session_info->event_setinput;
-		output_event = &session_info->event_setoutput;
-		trigger_event = &session_info->event_trigger;
-	} else {
-		input_event = output_event = trigger_event = NULL;
-	}
-
