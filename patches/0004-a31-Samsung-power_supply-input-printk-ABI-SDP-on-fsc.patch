+	kal_uint8 ae_ispGain_delay_frame;//isp gain delay frame for AE cycle
+	kal_uint8 ihdr_support;	//1, support; 0,not support
+	kal_uint8 ihdr_le_firstline;	//1,le first ; 0, se first
