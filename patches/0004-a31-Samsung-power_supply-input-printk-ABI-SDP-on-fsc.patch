-	dal_fb_addr = (void *)layerVA;
-	dal_fb_pa = layerPA;
-	DAL_CHECK_MFC_RET(MFC_Open(&mfc_handle, dal_fb_addr, DAL_WIDTH,
-				   DAL_HEIGHT, DAL_BPP, DAL_FG_COLOR,
-				   DAL_BG_COLOR));
