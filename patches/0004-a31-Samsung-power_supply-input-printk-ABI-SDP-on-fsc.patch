-static unsigned int lcm_compare_id(void)
-{
-	unsigned int id = 0;
-	unsigned char buffer[2];
-	unsigned int array[16];
-
-	SET_RESET_PIN(1);
-	SET_RESET_PIN(0);
-	MDELAY(1);
-
-	SET_RESET_PIN(1);
-	MDELAY(20);
-
-	array[0] = 0x00023700; /* read id return two byte, version and id */
