+static void panel_conn_uevent(struct lcd_info *lcd)
+{
+	char *uevent_conn_str[3] = {"CONNECTOR_NAME=UB_CONNECT", "CONNECTOR_TYPE=HIGH_LEVEL", NULL};
+
+	if (!lcd->fac_info)
+		return;
+
+	if (!lcd->conn_det_enable)
