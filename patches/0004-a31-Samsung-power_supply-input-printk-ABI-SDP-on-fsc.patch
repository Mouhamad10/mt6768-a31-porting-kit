+static void lcm_setbacklight_cmdq(void *handle, unsigned int level)
+{
+
+	pr_debug("[LCM]%s,nt35595 backlight: level = %d\n", __func__, level);
+
+	bl_level[0].para_list[0] = level;
+
+	push_table(bl_level,
+		sizeof(bl_level) / sizeof(struct LCM_setting_table), 1);
+}
