-#define BIT_TO_VALUE(TYPE, bit)				\
-do {							\
-	TYPE r;						\
-	*(unsigned long *)(&r) = (0x00000000U);		\
-	r.bit = ~(r.bit);				\
-	r;						\
-} while (0)
