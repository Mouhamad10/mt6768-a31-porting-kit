-	if (!disp_helper_get_option(DISP_OPT_OVL_WCG) && is_ovl_wcg(ds))
-		return ret;
-
-	switch (std) {
-	case HAL_DATASPACE_STANDARD_BT2020:
-	case HAL_DATASPACE_STANDARD_BT2020_CONSTANT_LUMINANCE:
