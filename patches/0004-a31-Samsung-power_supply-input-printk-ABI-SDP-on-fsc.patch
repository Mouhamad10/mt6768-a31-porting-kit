+	const char *name;
+	unsigned int count;
+	unsigned int lcdon_flag;
+
+	struct str_log log[ABD_LOG_MAX];
+};
+
+struct pin_log {
+	u64 stamp;
+	u64 ktime;
+
+	/* pin */
+	unsigned int level;
+	unsigned int state;
+	unsigned int onoff;
+};
+
+struct abd_pin {
+	const char *name;
+	unsigned int count;
+	unsigned int lcdon_flag;
+
+	struct pin_log log[ABD_LOG_MAX];
+};
