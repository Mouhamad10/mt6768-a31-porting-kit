+static void panel_conn_work(struct work_struct *work)
+{
+	struct lcd_info *lcd = container_of(work, struct lcd_info, conn_work);
+
+	dev_info(&lcd->ld->dev, "%s\n", __func__);
+
+	panel_conn_uevent(lcd);
+}
