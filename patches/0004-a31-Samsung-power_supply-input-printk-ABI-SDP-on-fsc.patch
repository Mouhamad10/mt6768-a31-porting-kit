-void usb_rev6_setting(int value)
-{
-	static int direct_return;
-
-	if (direct_return)
-		return;
-
-	/* RG_USB20_PHY_REV[7:0] = 8'b01000000 */
-	USBPHY_CLR32(0x18, (0xFF << 24));
-
-	if (value)
-		USBPHY_SET32(0x18, (value << 24));
-	else
-		direct_return = 1;
-}
