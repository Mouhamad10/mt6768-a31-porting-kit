+static int s6e3fc3_read_rdnumpe(struct lcd_info *lcd)
+{
+	int ret = 0;
+	unsigned char buf[LDI_LEN_RDNUMPE] = {0, };
+
+	ret = smcdsd_panel_read_bit_info(lcd, LDI_BIT_ENUM_RDNUMPE, buf);
+	if (ret < 0)
+		dev_info(&lcd->ld->dev, "%s: fail\n", __func__);
