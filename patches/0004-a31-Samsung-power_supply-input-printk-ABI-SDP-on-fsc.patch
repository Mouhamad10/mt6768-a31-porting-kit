-/**
- * check if it's decouple mode
- *
- * mutex_id  |  decouple  |  direct-link
- * -------------------------------------
- * OVL_Path  |      1     |       0
- * RDMA_Path |      0     |       X
- *
- */
-int dpp_disp_is_decouple(void)
-{
-	if (ddp_is_moudule_in_mutex(0, DISP_MODULE_OVL0) ||
-	    ddp_is_moudule_in_mutex(0, DISP_MODULE_OVL0_2L))
