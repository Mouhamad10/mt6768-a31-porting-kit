+#define ANALOG_GAIN_6 3626	// 3.541
+#define ANALOG_GAIN_7 4148	// 4.05x
+#define ANALOG_GAIN_8 4593	// 4.485x
+#define ANALOG_GAIN_9 5095	// 4.9759
+#define ANALOG_GAIN_10 5696	// 5.563x
