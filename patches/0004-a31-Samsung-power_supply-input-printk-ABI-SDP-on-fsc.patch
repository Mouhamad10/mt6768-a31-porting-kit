-	if (pListHead == &(client->mvaList)) {
-		ret = NULL;
-	} else {
-		if (del)
-			list_del(pListHead);
-		ret = pList;
-	}
-
-	mutex_unlock(&(client->dataMutex));
-
-	return ret;
