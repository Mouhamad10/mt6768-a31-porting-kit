-	is_ccu_port = (pMvaInfo->port == M4U_PORT_CAM_CCUI) ||
-	(pMvaInfo->port == M4U_PORT_CAM_CCUG)
-			|| (pMvaInfo->port == M4U_PORT_CAM_CCUO);
