+static void set_mode_setfile(enum IMGSENSOR_MODE mode)
+{
+	if (mode >= IMGSENSOR_MODE_MAX) {
+		LOG_ERR("%s(), invalid mode: %d\n", __func__, mode);
+		return;
+	}
+	LOG_INF(" - E");
+	LOG_INF("%s(), mode: %s\n", __func__, s5k4hayxf_setfile_info[mode].name);
+
+	table_write_cmos_sensor(s5k4hayxf_setfile_info[mode].setfile, s5k4hayxf_setfile_info[mode].size);
+	LOG_INF(" - X");
+}
