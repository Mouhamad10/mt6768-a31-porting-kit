-static bool is_RPO(struct disp_layer_info *disp_info, int disp_idx,
-		   int *rsz_idx)
-{
-	int i = 0;
-	struct layer_config *c = NULL;
-	int gpu_rsz_idx = 0;
-	struct layer_config *ref_layer = NULL;
-	struct disp_rect src_layer_roi = { 0 };
