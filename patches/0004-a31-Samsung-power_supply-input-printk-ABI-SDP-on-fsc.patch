-		     REG_FLD_VAL_GET(FLD_RSZ_FRAME_START, int_flag),
-		     REG_FLD_VAL_GET(FLD_RSZ_FRAME_END, int_flag),
-		     REG_FLD_VAL_GET(FLD_RSZ_SIZE_ERR, int_flag),
