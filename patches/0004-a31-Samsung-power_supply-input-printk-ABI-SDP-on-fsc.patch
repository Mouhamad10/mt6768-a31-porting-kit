-			 __func__);
-		return;
-	}
-
-	hdmi_drv->power_off();
-	ext_disp_suspend(MHL_SESSION_ID);
-	p->is_clock_on = false;
-	SET_HDMI_OFF();
-	up(&hdmi_update_mutex);
-
-	switch_set_state(&hdmires_switch_data, 0);
-	hdmi_enable_dvfs(false);
