diff --git a/drivers/misc/mediatek/include/mt-plat/mtk_tinysys_ipi.h b/drivers/misc/mediatek/include/mt-plat/mtk_tinysys_ipi.h
new file mode 100644
index 000000000..3ccf074ec
--- /dev/null
+++ b/drivers/misc/mediatek/include/mt-plat/mtk_tinysys_ipi.h
@@ -0,0 +1,144 @@
+/*
+ * Copyright (C) 2019 MediaTek Inc.
+ *
+ * This program is free software; you can redistribute it and/or modify
+ * it under the terms of the GNU General Public License version 2 as
+ * published by the Free Software Foundation.
+ *
