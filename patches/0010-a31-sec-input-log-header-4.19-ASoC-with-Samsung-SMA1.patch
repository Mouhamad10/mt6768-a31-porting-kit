+typedef int (*dai_register_cb)(struct mtk_base_afe *);
+static const dai_register_cb dai_register_cbs[] = {
+	mt6781_dai_adda_register,
+	mt6781_dai_i2s_register,
+	mt6781_dai_hw_gain_register,
+	mt6781_dai_src_register,
+	mt6781_dai_pcm_register,
+	mt6781_dai_hostless_register,
+	mt6781_dai_memif_register,
+};
