+static const struct of_device_id mt6873_afe_pcm_dt_match[] = {
+	{ .compatible = "mediatek,mt6873-sound", },
+	{},
+};
+MODULE_DEVICE_TABLE(of, mt6873_afe_pcm_dt_match);
+
+static const struct dev_pm_ops mt6873_afe_pm_ops = {
+	SET_RUNTIME_PM_OPS(mt6873_afe_runtime_suspend,
+			   mt6873_afe_runtime_resume, NULL)
+};
+
+static struct platform_driver mt6873_afe_pcm_driver = {
+	.driver = {
+		   .name = "mt6873-audio",
+		   .of_match_table = mt6873_afe_pcm_dt_match,
+#ifdef CONFIG_PM
+		   .pm = &mt6873_afe_pm_ops,
+#endif
+	},
+	.probe = mt6873_afe_pcm_dev_probe,
+	.remove = mt6873_afe_pcm_dev_remove,
+};
+
+module_platform_driver(mt6873_afe_pcm_driver);
