+
+static const struct snd_kcontrol_new mt6785_afe_bargein_controls[] = {
+	SOC_SINGLE_EXT("Vow_bargein_echo_ref", SND_SOC_NOPM, 0, 0x1, 0,
+		       mt6785_afe_vow_bargein_get,
+		       mt6785_afe_vow_bargein_set),
+};
