+static int get_dsp_dram_sement_by_id(struct audio_dsp_dram *buffer, int id)
+{
+	int ret = 0;
+
+	buffer->phy_addr =
+		scp_get_reserve_mem_phys(dsp_daiid_to_scp_reservedid(id));
