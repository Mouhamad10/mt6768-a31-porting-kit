+	Afe_Set_Reg(AFE_ADDA2_TOP_CON0, 0x0, 0x3 << 1);
+	Afe_Set_Reg(AFE_ADDA2_TOP_CON0, 0x0,
+		    0x7 << 4); /* adda2_anc_dl_input_mode:260k */
+	Afe_Set_Reg(AFE_ADDA2_TOP_CON0, 0x1 << 3,
+		    0x1 << 3); /* afe adda2_dl_src_on */
