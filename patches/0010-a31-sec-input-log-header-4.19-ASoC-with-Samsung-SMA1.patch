diff --git a/sound/soc/mediatek/mt6785/mt6785-afe-control.c b/sound/soc/mediatek/mt6785/mt6785-afe-control.c
new file mode 100644
index 000000000..c69ff3411
--- /dev/null
+++ b/sound/soc/mediatek/mt6785/mt6785-afe-control.c
@@ -0,0 +1,332 @@
+// SPDX-License-Identifier: GPL-2.0
+//
+// MediaTek ALSA SoC Audio Control
+//
+// Copyright (c) 2018 MediaTek Inc.
+// Author: Eason Yen <eason.yen@mediatek.com>
+
+#include "mt6785-afe-common.h"
+#include <linux/pm_runtime.h>
+
+#include "../common/mtk-sp-afe-external.h"
+#include "../common/mtk-sram-manager.h"
+
+#ifdef CONFIG_MTK_AUDIODSP_SUPPORT
+#include "adsp_helper.h"
+#include "adsp_platform.h"
+#endif
+
+/* don't use this directly if not necessary */
+static struct mtk_base_afe *local_afe;
+
+int mt6785_set_local_afe(struct mtk_base_afe *afe)
+{
+	local_afe = afe;
+	return 0;
+}
+
+enum {
+	MTK_AFE_RATE_8K = 0,
+	MTK_AFE_RATE_11K = 1,
+	MTK_AFE_RATE_12K = 2,
+	MTK_AFE_RATE_384K = 3,
+	MTK_AFE_RATE_16K = 4,
+	MTK_AFE_RATE_22K = 5,
+	MTK_AFE_RATE_24K = 6,
+	MTK_AFE_RATE_130K = 7,
+	MTK_AFE_RATE_32K = 8,
+	MTK_AFE_RATE_44K = 9,
+	MTK_AFE_RATE_48K = 10,
+	MTK_AFE_RATE_88K = 11,
+	MTK_AFE_RATE_96K = 12,
+	MTK_AFE_RATE_176K = 13,
+	MTK_AFE_RATE_192K = 14,
+	MTK_AFE_RATE_260K = 15,
+};
+
+enum {
+	MTK_AFE_DAI_MEMIF_RATE_8K = 0,
+	MTK_AFE_DAI_MEMIF_RATE_16K = 1,
+	MTK_AFE_DAI_MEMIF_RATE_32K = 2,
+	MTK_AFE_DAI_MEMIF_RATE_48K = 3,
+};
+
+enum {
+	MTK_AFE_PCM_RATE_8K = 0,
+	MTK_AFE_PCM_RATE_16K = 1,
+	MTK_AFE_PCM_RATE_32K = 2,
+	MTK_AFE_PCM_RATE_48K = 3,
+};
+
+unsigned int mt6785_general_rate_transform(struct device *dev,
+					   unsigned int rate)
+{
+	switch (rate) {
+	case 8000:
+		return MTK_AFE_RATE_8K;
+	case 11025:
+		return MTK_AFE_RATE_11K;
+	case 12000:
+		return MTK_AFE_RATE_12K;
+	case 16000:
+		return MTK_AFE_RATE_16K;
+	case 22050:
+		return MTK_AFE_RATE_22K;
+	case 24000:
+		return MTK_AFE_RATE_24K;
+	case 32000:
+		return MTK_AFE_RATE_32K;
+	case 44100:
+		return MTK_AFE_RATE_44K;
+	case 48000:
+		return MTK_AFE_RATE_48K;
+	case 88200:
+		return MTK_AFE_RATE_88K;
+	case 96000:
+		return MTK_AFE_RATE_96K;
+	case 130000:
+		return MTK_AFE_RATE_130K;
+	case 176400:
+		return MTK_AFE_RATE_176K;
+	case 192000:
+		return MTK_AFE_RATE_192K;
+	case 260000:
+		return MTK_AFE_RATE_260K;
+	default:
+		dev_warn(dev, "%s(), rate %u invalid, use %d!!!\n",
+			 __func__,
+			 rate, MTK_AFE_RATE_48K);
+		return MTK_AFE_RATE_48K;
+	}
+}
+
+static unsigned int dai_memif_rate_transform(struct device *dev,
+					     unsigned int rate)
+{
+	switch (rate) {
+	case 8000:
+		return MTK_AFE_DAI_MEMIF_RATE_8K;
+	case 16000:
+		return MTK_AFE_DAI_MEMIF_RATE_16K;
+	case 32000:
+		return MTK_AFE_DAI_MEMIF_RATE_32K;
+	case 48000:
+		return MTK_AFE_DAI_MEMIF_RATE_48K;
+	default:
+		dev_warn(dev, "%s(), rate %u invalid, use %d!!!\n",
+			 __func__,
+			 rate, MTK_AFE_DAI_MEMIF_RATE_16K);
+		return MTK_AFE_DAI_MEMIF_RATE_16K;
+	}
+}
+
+static unsigned int pcm_rate_transform(struct device *dev,
+				       unsigned int rate)
+{
+	switch (rate) {
+	case 8000:
+		return MTK_AFE_PCM_RATE_8K;
+	case 16000:
+		return MTK_AFE_PCM_RATE_16K;
+	case 32000:
+		return MTK_AFE_PCM_RATE_32K;
+	case 48000:
+		return MTK_AFE_PCM_RATE_48K;
+	default:
+		dev_warn(dev, "%s(), rate %u invalid, use %d!!!\n",
+			 __func__,
+			 rate, MTK_AFE_PCM_RATE_32K);
+		return MTK_AFE_PCM_RATE_32K;
+	}
+}
+
+unsigned int mt6785_rate_transform(struct device *dev,
+				   unsigned int rate, int aud_blk)
+{
+	switch (aud_blk) {
+	case MT6785_MEMIF_DAI:
+	case MT6785_MEMIF_MOD_DAI:
+		return dai_memif_rate_transform(dev, rate);
+	case MT6785_DAI_PCM_1:
+	case MT6785_DAI_PCM_2:
+		return pcm_rate_transform(dev, rate);
+	default:
+		return mt6785_general_rate_transform(dev, rate);
+	}
+}
+
+int mt6785_enable_dc_compensation(bool enable)
+{
+	if (!local_afe)
+		return -EPERM;
+
+	if (pm_runtime_status_suspended(local_afe->dev))
+		dev_warn(local_afe->dev, "%s(), status suspended\n", __func__);
+
+
+	pm_runtime_get_sync(local_afe->dev);
+	regmap_update_bits(local_afe->regmap,
+			   AFE_ADDA_DL_SDM_DCCOMP_CON,
+			   AUD_DC_COMP_EN_MASK_SFT,
+			   (enable ? 1 : 0) << AUD_DC_COMP_EN_SFT);
+	pm_runtime_put(local_afe->dev);
+	return 0;
+}
+
+int mt6785_set_lch_dc_compensation(int value)
+{
+	if (!local_afe)
+		return -EPERM;
+
+	if (pm_runtime_status_suspended(local_afe->dev))
+		dev_warn(local_afe->dev, "%s(), status suspended\n", __func__);
+
+	pm_runtime_get_sync(local_afe->dev);
+	regmap_write(local_afe->regmap,
+		     AFE_ADDA_DL_DC_COMP_CFG0,
+		     value);
+	pm_runtime_put(local_afe->dev);
+	return 0;
+}
+
+int mt6785_set_rch_dc_compensation(int value)
+{
+	if (!local_afe)
+		return -EPERM;
+
+	if (pm_runtime_status_suspended(local_afe->dev))
+		dev_warn(local_afe->dev, "%s(), status suspended\n", __func__);
+
+	pm_runtime_get_sync(local_afe->dev);
+	regmap_write(local_afe->regmap,
+		     AFE_ADDA_DL_DC_COMP_CFG1,
+		     value);
+	pm_runtime_put(local_afe->dev);
+	return 0;
+}
+
+int mt6785_adda_dl_gain_control(bool mute)
+{
+	unsigned int dl_2_gain_ctl;
+
+	if (!local_afe)
+		return -EPERM;
+
+	if (pm_runtime_status_suspended(local_afe->dev))
+		dev_warn(local_afe->dev, "%s(), status suspended\n", __func__);
+
+	pm_runtime_get_sync(local_afe->dev);
+
+	if (mute)
+		dl_2_gain_ctl = MTK_AFE_ADDA_DL_GAIN_MUTE;
+	else
+		dl_2_gain_ctl = MTK_AFE_ADDA_DL_GAIN_NORMAL;
+
+	regmap_update_bits(local_afe->regmap,
+			   AFE_ADDA_DL_SRC2_CON1,
+			   DL_2_GAIN_CTL_PRE_MASK_SFT,
+			   dl_2_gain_ctl << DL_2_GAIN_CTL_PRE_SFT);
+
+	dev_info(local_afe->dev, "%s(), adda_dl_gain %x\n",
+		 __func__, dl_2_gain_ctl);
+
+	pm_runtime_put(local_afe->dev);
+	return 0;
+}
+
+int mt6785_dai_set_priv(struct mtk_base_afe *afe, int id,
+			int priv_size, const void *priv_data)
+{
+	struct mt6785_afe_private *afe_priv = afe->platform_priv;
+	void *temp_data;
+
+	temp_data = devm_kzalloc(afe->dev,
+				 priv_size,
+				 GFP_KERNEL);
+	if (!temp_data)
+		return -ENOMEM;
+
+	if (priv_data)
+		memcpy(temp_data, priv_data, priv_size);
+
+	afe_priv->dai_priv[id] = temp_data;
+
+	return 0;
+}
+
+/* api for other modules */
+static int request_sram_count;
+int mtk_audio_request_sram(dma_addr_t *phys_addr,
+			   unsigned char **virt_addr,
+			   unsigned int length,
+			   void *user)
+{
+	int ret;
+
+	dev_info(local_afe->dev, "%s(), user = %p, length = %d, count = %d\n",
+		 __func__, user, length, request_sram_count);
+
+	pm_runtime_get_sync(local_afe->dev);
+
+	ret = mtk_audio_sram_allocate(local_afe->sram, phys_addr, virt_addr,
+				      length, user,
+				      SNDRV_PCM_FORMAT_S16_LE, true);
+	if (ret) {
+		dev_warn(local_afe->dev, "%s(), allocate sram fail, ret %d\n",
+			 __func__, ret);
+		pm_runtime_put(local_afe->dev);
+		return ret;
+	}
+
+	request_sram_count++;
+
+
+	dev_info(local_afe->dev, "%s(), return 0, count = %d\n",
+		 __func__, request_sram_count);
+	return 0;
+}
+EXPORT_SYMBOL(mtk_audio_request_sram);
+
+void mtk_audio_free_sram(void *user)
+{
+	dev_info(local_afe->dev, "%s(), user = %p, count = %d\n",
+		 __func__, user, request_sram_count);
+
+	mtk_audio_sram_free(local_afe->sram, user);
+	pm_runtime_put(local_afe->dev);
+	request_sram_count--;
+
+	dev_info(local_afe->dev, "%s(), return, count = %d\n",
+		 __func__, request_sram_count);
+}
+EXPORT_SYMBOL(mtk_audio_free_sram);
+
+bool mtk_audio_condition_enter_suspend(void)
+{
+	struct mt6785_afe_private *afe_priv = local_afe->platform_priv;
+
+	if (afe_priv->dai_on[MT6785_DAI_CONNSYS_I2S])
+		return false;
+
+#ifdef CONFIG_MTK_AUDIODSP_SUPPORT
+	if (is_adsp_ready(ADSP_A_ID))
+		return false;
+#endif
+
+	if (request_sram_count)
+		return false;
+
+	return true;
+}
+EXPORT_SYMBOL(mtk_audio_condition_enter_suspend);
+
+bool mtk_get_speech_status(void)
+{
+	int speech_en = 0;
+
+	regmap_read(local_afe->regmap,
+		    PCM2_INTF_CON, &speech_en);
+
+	return (speech_en & PCM2_EN_MASK_SFT) ? true : false;
+}
+EXPORT_SYMBOL(mtk_get_speech_status);
diff --git a/sound/soc/mediatek/mt6785/mt6785-afe-gpio.c b/sound/soc/mediatek/mt6785/mt6785-afe-gpio.c
new file mode 100644
index 000000000..e39b9647a
--- /dev/null
+++ b/sound/soc/mediatek/mt6785/mt6785-afe-gpio.c
@@ -0,0 +1,251 @@
+// SPDX-License-Identifier: GPL-2.0
+//
+// mt6785-afe-gpio.c  --  Mediatek 6785 afe gpio ctrl
+//
+// Copyright (c) 2018 MediaTek Inc.
+// Author: Eason Yen <eason.yen@mediatek.com>
+
+#include <linux/gpio.h>
+#include <linux/pinctrl/consumer.h>
+
+#include "mt6785-afe-common.h"
+#include "mt6785-afe-gpio.h"
+
+struct pinctrl *aud_pinctrl;
+
+enum mt6785_afe_gpio {
+	MT6785_AFE_GPIO_DAT_MISO_OFF,
+	MT6785_AFE_GPIO_DAT_MISO_ON,
+	MT6785_AFE_GPIO_DAT_MOSI_OFF,
+	MT6785_AFE_GPIO_DAT_MOSI_ON,
+	MT6785_AFE_GPIO_DAT_MISO_CH34_OFF,
+	MT6785_AFE_GPIO_DAT_MISO_CH34_ON,
+	MT6785_AFE_GPIO_DAT_MOSI_CH34_OFF,
+	MT6785_AFE_GPIO_DAT_MOSI_CH34_ON,
+	MT6785_AFE_GPIO_I2S0_OFF,
+	MT6785_AFE_GPIO_I2S0_ON,
+	MT6785_AFE_GPIO_I2S1_OFF,
+	MT6785_AFE_GPIO_I2S1_ON,
+	MT6785_AFE_GPIO_I2S2_OFF,
+	MT6785_AFE_GPIO_I2S2_ON,
+	MT6785_AFE_GPIO_I2S3_OFF,
+	MT6785_AFE_GPIO_I2S3_ON,
+	MT6785_AFE_GPIO_I2S5_OFF,
+	MT6785_AFE_GPIO_I2S5_ON,
+	MT6785_AFE_GPIO_VOW_DAT_OFF,
+	MT6785_AFE_GPIO_VOW_DAT_ON,
+	MT6785_AFE_GPIO_VOW_CLK_OFF,
+	MT6785_AFE_GPIO_VOW_CLK_ON,
+	MT6785_AFE_GPIO_GPIO_NUM
+};
+
+struct audio_gpio_attr {
+	const char *name;
+	bool gpio_prepare;
+	struct pinctrl_state *gpioctrl;
+};
+
+static struct audio_gpio_attr aud_gpios[MT6785_AFE_GPIO_GPIO_NUM] = {
+	[MT6785_AFE_GPIO_DAT_MISO_OFF] = {"aud_dat_miso_off", false, NULL},
+	[MT6785_AFE_GPIO_DAT_MISO_ON] = {"aud_dat_miso_on", false, NULL},
+	[MT6785_AFE_GPIO_DAT_MOSI_OFF] = {"aud_dat_mosi_off", false, NULL},
+	[MT6785_AFE_GPIO_DAT_MOSI_ON] = {"aud_dat_mosi_on", false, NULL},
+	[MT6785_AFE_GPIO_I2S0_OFF] = {"aud_gpio_i2s0_off", false, NULL},
+	[MT6785_AFE_GPIO_I2S0_ON] = {"aud_gpio_i2s0_on", false, NULL},
+	[MT6785_AFE_GPIO_I2S1_OFF] = {"aud_gpio_i2s1_off", false, NULL},
+	[MT6785_AFE_GPIO_I2S1_ON] = {"aud_gpio_i2s1_on", false, NULL},
+	[MT6785_AFE_GPIO_I2S2_OFF] = {"aud_gpio_i2s2_off", false, NULL},
+	[MT6785_AFE_GPIO_I2S2_ON] = {"aud_gpio_i2s2_on", false, NULL},
+	[MT6785_AFE_GPIO_I2S3_OFF] = {"aud_gpio_i2s3_off", false, NULL},
+	[MT6785_AFE_GPIO_I2S3_ON] = {"aud_gpio_i2s3_on", false, NULL},
+	[MT6785_AFE_GPIO_I2S5_OFF] = {"aud_gpio_i2s5_off", false, NULL},
+	[MT6785_AFE_GPIO_I2S5_ON] = {"aud_gpio_i2s5_on", false, NULL},
+	[MT6785_AFE_GPIO_VOW_DAT_OFF] = {"vow_dat_miso_off", false, NULL},
+	[MT6785_AFE_GPIO_VOW_DAT_ON] = {"vow_dat_miso_on", false, NULL},
+	[MT6785_AFE_GPIO_VOW_CLK_OFF] = {"vow_clk_miso_off", false, NULL},
+	[MT6785_AFE_GPIO_VOW_CLK_ON] = {"vow_clk_miso_on", false, NULL},
+	[MT6785_AFE_GPIO_DAT_MISO_CH34_OFF] = {"aud_dat_miso_ch34_off",
+					       false, NULL},
+	[MT6785_AFE_GPIO_DAT_MISO_CH34_ON] = {"aud_dat_miso_ch34_on",
+					      false, NULL},
+	[MT6785_AFE_GPIO_DAT_MOSI_CH34_OFF] = {"aud_dat_mosi_ch34_off",
+					       false, NULL},
+	[MT6785_AFE_GPIO_DAT_MOSI_CH34_ON] = {"aud_dat_mosi_ch34_on",
+					      false, NULL},
+};
+
+static DEFINE_MUTEX(gpio_request_mutex);
+
+int mt6785_afe_gpio_init(struct mtk_base_afe *afe)
+{
+	int ret;
+	int i = 0;
+
+	aud_pinctrl = devm_pinctrl_get(afe->dev);
+	if (IS_ERR(aud_pinctrl)) {
+		ret = PTR_ERR(aud_pinctrl);
+		dev_err(afe->dev, "%s(), ret %d, cannot get aud_pinctrl!\n",
+			__func__, ret);
+		return -ENODEV;
+	}
+
+	for (i = 0; i < ARRAY_SIZE(aud_gpios); i++) {
+		aud_gpios[i].gpioctrl = pinctrl_lookup_state(aud_pinctrl,
+							     aud_gpios[i].name);
+		if (IS_ERR(aud_gpios[i].gpioctrl)) {
+			ret = PTR_ERR(aud_gpios[i].gpioctrl);
+			dev_err(afe->dev, "%s(), pinctrl_lookup_state %s fail, ret %d\n",
+				__func__, aud_gpios[i].name, ret);
+		} else {
+			aud_gpios[i].gpio_prepare = true;
+		}
+	}
+
+	/* gpio status init */
+	mt6785_afe_gpio_request(afe, false, MT6785_DAI_ADDA, 0);
+	mt6785_afe_gpio_request(afe, false, MT6785_DAI_ADDA, 1);
+
+	return 0;
+}
+
+static int mt6785_afe_gpio_select(struct mtk_base_afe *afe,
+				  enum mt6785_afe_gpio type)
+{
+	int ret = 0;
+
+	if (type < 0 || type >= MT6785_AFE_GPIO_GPIO_NUM) {
+		dev_err(afe->dev, "%s(), error, invaild gpio type %d\n",
+			__func__, type);
+		return -EINVAL;
+	}
+
+	if (!aud_gpios[type].gpio_prepare) {
+		dev_warn(afe->dev, "%s(), error, gpio type %d not prepared\n",
+			 __func__, type);
+		return -EIO;
+	}
+
+	ret = pinctrl_select_state(aud_pinctrl,
+				   aud_gpios[type].gpioctrl);
+	if (ret) {
+		dev_err(afe->dev, "%s(), error, can not set gpio type %d\n",
+		       __func__, type);
+		AUDIO_AEE("can not set gpio type");
+	}
+	return ret;
+}
+
+static int mt6785_afe_gpio_adda_dl(struct mtk_base_afe *afe, bool enable)
+{
+	if (enable) {
+		return mt6785_afe_gpio_select(afe,
+					      MT6785_AFE_GPIO_DAT_MOSI_ON);
+	} else {
+		return mt6785_afe_gpio_select(afe,
+					      MT6785_AFE_GPIO_DAT_MOSI_OFF);
+	}
+}
+
+static int mt6785_afe_gpio_adda_ul(struct mtk_base_afe *afe, bool enable)
+{
+	if (enable) {
+		return mt6785_afe_gpio_select(afe,
+					      MT6785_AFE_GPIO_DAT_MISO_ON);
+	} else {
+		return mt6785_afe_gpio_select(afe,
+					      MT6785_AFE_GPIO_DAT_MISO_OFF);
+	}
+}
+
+static int mt6785_afe_gpio_adda_ch34_dl(struct mtk_base_afe *afe, bool enable)
+{
+	if (enable) {
+		return mt6785_afe_gpio_select(afe,
+			MT6785_AFE_GPIO_DAT_MOSI_CH34_ON);
+	} else {
+		return mt6785_afe_gpio_select(afe,
+			MT6785_AFE_GPIO_DAT_MOSI_CH34_OFF);
+	}
+}
+
+static int mt6785_afe_gpio_adda_ch34_ul(struct mtk_base_afe *afe, bool enable)
+{
+	if (enable) {
+		return mt6785_afe_gpio_select(afe,
+			MT6785_AFE_GPIO_DAT_MISO_CH34_ON);
+	} else {
+		return mt6785_afe_gpio_select(afe,
+			MT6785_AFE_GPIO_DAT_MISO_CH34_OFF);
+	}
+}
+
+int mt6785_afe_gpio_request(struct mtk_base_afe *afe, bool enable,
+			    int dai, int uplink)
+{
+	mutex_lock(&gpio_request_mutex);
+	switch (dai) {
+	case MT6785_DAI_ADDA:
+		if (uplink)
+			mt6785_afe_gpio_adda_ul(afe, enable);
+		else
+			mt6785_afe_gpio_adda_dl(afe, enable);
+		break;
+	case MT6785_DAI_ADDA_CH34:
+		if (uplink)
+			mt6785_afe_gpio_adda_ch34_ul(afe, enable);
+		else
+			mt6785_afe_gpio_adda_ch34_dl(afe, enable);
+		break;
+	case MT6785_DAI_I2S_0:
+		if (enable)
+			mt6785_afe_gpio_select(afe, MT6785_AFE_GPIO_I2S0_ON);
+		else
+			mt6785_afe_gpio_select(afe, MT6785_AFE_GPIO_I2S0_OFF);
+		break;
+	case MT6785_DAI_I2S_1:
+		if (enable)
+			mt6785_afe_gpio_select(afe, MT6785_AFE_GPIO_I2S1_ON);
+		else
+			mt6785_afe_gpio_select(afe, MT6785_AFE_GPIO_I2S1_OFF);
+		break;
+	case MT6785_DAI_I2S_2:
+		if (enable)
+			mt6785_afe_gpio_select(afe, MT6785_AFE_GPIO_I2S2_ON);
+		else
+			mt6785_afe_gpio_select(afe, MT6785_AFE_GPIO_I2S2_OFF);
+		break;
+	case MT6785_DAI_I2S_3:
+		if (enable)
+			mt6785_afe_gpio_select(afe, MT6785_AFE_GPIO_I2S3_ON);
+		else
+			mt6785_afe_gpio_select(afe, MT6785_AFE_GPIO_I2S3_OFF);
+		break;
+	case MT6785_DAI_I2S_5:
+		if (enable)
+			mt6785_afe_gpio_select(afe, MT6785_AFE_GPIO_I2S5_ON);
+		else
+			mt6785_afe_gpio_select(afe, MT6785_AFE_GPIO_I2S5_OFF);
+		break;
+	case MT6785_DAI_VOW:
+		if (enable) {
+			mt6785_afe_gpio_select(afe,
+					       MT6785_AFE_GPIO_VOW_CLK_ON);
+			mt6785_afe_gpio_select(afe,
+					       MT6785_AFE_GPIO_VOW_DAT_ON);
+		} else {
+			mt6785_afe_gpio_select(afe,
+					       MT6785_AFE_GPIO_VOW_CLK_OFF);
+			mt6785_afe_gpio_select(afe,
+					       MT6785_AFE_GPIO_VOW_DAT_OFF);
+		}
+		break;
+	default:
+		mutex_unlock(&gpio_request_mutex);
+		dev_warn(afe->dev, "%s(), invalid dai %d\n", __func__, dai);
+		AUDIO_AEE("invalid dai");
+		return -EINVAL;
+	}
+	mutex_unlock(&gpio_request_mutex);
+	return 0;
+}
+
diff --git a/sound/soc/mediatek/mt6785/mt6785-afe-gpio.h b/sound/soc/mediatek/mt6785/mt6785-afe-gpio.h
