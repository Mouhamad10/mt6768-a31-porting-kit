+				   G_SRC_COEFF_SRAM_ADR_MASK_SFT,
+				   0x0);
+
+		for (i = 0; i < iir_coeff_num; i++) {
+			regmap_read(afe->regmap, AFE_GENERAL2_ASRC_2CH_CON12,
