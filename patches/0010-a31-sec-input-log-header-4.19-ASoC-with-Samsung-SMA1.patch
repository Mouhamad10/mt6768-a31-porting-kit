+/* dai id support dsp <==> afe */
+bool mtk_adsp_dai_id_support_share_mem(int dai_id)
+{
+	switch (dai_id) {
+	case MT6873_MEMIF_DL1:
+	case MT6873_MEMIF_DL12:
+	case MT6873_MEMIF_DL2:
+	case MT6873_MEMIF_DL3:
+	case MT6873_MEMIF_DL4:
+	case MT6873_MEMIF_DL5:
+	case MT6873_MEMIF_DL6:
+	case MT6873_MEMIF_DL7:
+	case MT6873_MEMIF_DL8:
+	case MT6873_MEMIF_VUL12:
+	case MT6873_MEMIF_VUL2:
+	case MT6873_MEMIF_VUL3:
+	case MT6873_MEMIF_VUL4:
+	case MT6873_MEMIF_VUL5:
+	case MT6873_MEMIF_VUL6:
+	case MT6873_MEMIF_AWB:
+	case MT6873_MEMIF_AWB2:
+	case MT6873_MEMIF_NUM:
+		return true;
+	case MT6873_MEMIF_DAI:
+	case MT6873_MEMIF_DAI2:
+	case MT6873_MEMIF_MOD_DAI:
+	case MT6873_MEMIF_HDMI:
+		return false;
+	default:
+		return false;
+	}
