+static int mt6785_dai_memif_register(struct mtk_base_afe *afe)
+{
+	struct mtk_base_afe_dai *dai;
+
+	dai = devm_kzalloc(afe->dev, sizeof(*dai), GFP_KERNEL);
+	if (!dai)
+		return -ENOMEM;
+
+	list_add(&dai->list, &afe->sub_dais);
+
+	dai->dai_drivers = mt6785_memif_dai_driver;
+	dai->num_dai_drivers = ARRAY_SIZE(mt6785_memif_dai_driver);
+
+	dai->controls = mt6785_pcm_kcontrols;
+	dai->num_controls = ARRAY_SIZE(mt6785_pcm_kcontrols);
+	dai->dapm_widgets = mt6785_memif_widgets;
+	dai->num_dapm_widgets = ARRAY_SIZE(mt6785_memif_widgets);
+	dai->dapm_routes = mt6785_memif_routes;
+	dai->num_dapm_routes = ARRAY_SIZE(mt6785_memif_routes);
+	return 0;
+}
