+		   .of_match_table = mt6785_afe_pcm_dt_match,
+#ifdef CONFIG_PM
+		   .pm = &mt6785_afe_pm_ops,
+#endif
+	},
+	.probe = mt6785_afe_pcm_dev_probe,
+	.remove = mt6785_afe_pcm_dev_remove,
+};
