+	snd_soc_add_component_controls(component,
+				      mt6873_afe_debug_controls,
+				      ARRAY_SIZE(mt6873_afe_debug_controls));
+
+	snd_soc_add_component_controls(component,
+				      mt6873_afe_usb_controls,
+				      ARRAY_SIZE(mt6873_afe_usb_controls));
+
+	snd_soc_add_component_controls(component,
