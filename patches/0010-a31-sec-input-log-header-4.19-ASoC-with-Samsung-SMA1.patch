+
+	/* unsigned char *md32_data_image={0}; */
+	/* unsigned char *md32_program_image={0}; */
+	/* unsigned char *d_buf, *p_buf; */
+	p_sz = get_md32_img_sz(MD32_PROGRAM_IMAGE_PATH);
