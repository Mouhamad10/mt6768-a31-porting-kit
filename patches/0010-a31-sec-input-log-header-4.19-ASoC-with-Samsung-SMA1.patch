+
+	regmap_write(afe->regmap,
+		     AFE_GENERAL2_ASRC_2CH_CON5, 0x003f5986);
+	regmap_write(afe->regmap,
+		     AFE_GENERAL2_ASRC_2CH_CON5, 0x003f5987);
+	regmap_write(afe->regmap,
+		     AFE_GENERAL2_ASRC_2CH_CON6, 0x00001fbd);
+	regmap_write(afe->regmap,
+		     AFE_GENERAL2_ASRC_2CH_CON2, 0x00000000);
+
+	/* set iir if in_rate > out_rate */
+	if (rate_in > rate_out) {
+		int i;
+#ifdef DEBUG_COEFF
