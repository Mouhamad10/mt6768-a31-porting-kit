+int mt6873_get_apll_rate(struct mtk_base_afe *afe, int apll)
+{
+	return (apll == MT6873_APLL1) ? 180633600 : 196608000;
+}
+
+int mt6873_get_apll_by_rate(struct mtk_base_afe *afe, int rate)
+{
+	return ((rate % 8000) == 0) ? MT6873_APLL2 : MT6873_APLL1;
+}
