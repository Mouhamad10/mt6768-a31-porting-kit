+static int get_i2s_id_by_name(struct mtk_base_afe *afe,
+			      const char *name)
+{
+	if (strncmp(name, "I2S0", 4) == 0)
+		return MT6873_DAI_I2S_0;
+	else if (strncmp(name, "I2S1", 4) == 0)
+		return MT6873_DAI_I2S_1;
+	else if (strncmp(name, "I2S2", 4) == 0)
+		return MT6873_DAI_I2S_2;
+	else if (strncmp(name, "I2S3", 4) == 0)
+		return MT6873_DAI_I2S_3;
+	else if (strncmp(name, "I2S5", 4) == 0)
+		return MT6873_DAI_I2S_5;
+	else if (strncmp(name, "I2S6", 4) == 0)
+		return MT6873_DAI_I2S_6;
+	else if (strncmp(name, "I2S7", 4) == 0)
+		return MT6873_DAI_I2S_7;
+	else if (strncmp(name, "I2S8", 4) == 0)
+		return MT6873_DAI_I2S_8;
+	else if (strncmp(name, "I2S9", 4) == 0)
+		return MT6873_DAI_I2S_9;
+	else
+		return -EINVAL;
+}
+
+static struct mtk_afe_i2s_priv *get_i2s_priv_by_name(struct mtk_base_afe *afe,
+						     const char *name)
+{
+	struct mt6873_afe_private *afe_priv = afe->platform_priv;
+	int dai_id = get_i2s_id_by_name(afe, name);
+
+	if (dai_id < 0)
+		return NULL;
+
+	return afe_priv->dai_priv[dai_id];
+}
