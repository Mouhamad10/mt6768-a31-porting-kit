+int mt6779_get_apll_by_name(struct mtk_base_afe *afe, const char *name)
+{
+	if (strcmp(name, APLL1_W_NAME) == 0)
+		return MT6779_APLL1;
+	else
+		return MT6779_APLL2;
+}
