+	int port;
+	int virt;
+	int sec;
+	int distance;
+	int direction;
+};
+
+struct m4u_buf_param {
+	int port;
+	unsigned int mva;
+	unsigned int size;
+	unsigned long long pa;
+};
+
+#define TZ_M4U_MAX_MEM_CHUNK_NR 4
+
