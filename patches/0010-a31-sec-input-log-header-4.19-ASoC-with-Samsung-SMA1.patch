+static int mt6785_afe_suspend(struct device *dev)
+{
+	struct mtk_base_afe *afe = dev_get_drvdata(dev);
+
+	dev_info(afe->dev, "%s()\n", __func__);
+
+	mt6785_afe_suspend_clock(afe);
+
+	return 0;
+}
+
+static int mt6785_afe_resume(struct device *dev)
+{
+	struct mtk_base_afe *afe = dev_get_drvdata(dev);
+
+	dev_info(afe->dev, "%s()\n", __func__);
+
+	mt6785_afe_resume_clock(afe);
+
+	return 0;
+}
