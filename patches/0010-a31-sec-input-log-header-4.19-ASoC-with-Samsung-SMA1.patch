+	MD32_BASE_REG = 0x0; /* turn off md32 */
+	do {
+		if (p_sz > 0)
+			ret = load_md32(MD32_PROGRAM_IMAGE_PATH,
+					MD32_PTCM_VIRTUAL_ADDR);
+
+		if (d_sz > 0)
