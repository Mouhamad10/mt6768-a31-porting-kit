+		ipi_payload_buf[0] = param1;
+		ipi_payload_buf[1] = param2;
+		ret = sizeof(unsigned int) * 2;
+		break;
+	default:
+		pr_debug("%s msg_id not support\n", __func__);
+		break;
 	}
+
+	return ret;
 }
 
