+	dev_info(afe->dev, "%s(), end\n", __func__);
+	mt6785_afe_gpio_request(afe, false, MT6785_DAI_VOW, 0);
+
+	/* restore to fool ASoC */
+	for_each_rtdcom(rtd, rtdcom) {
+		comp = rtdcom->component;
+		pm_runtime_get_sync(comp->dev);
+	}
+}
