+#define F_SMI_SEC_MMU_EN(en)	F_BIT_VAL(en, 0)
+#define F_SMI_SEC_EN(sec)	F_BIT_VAL(sec, 1)
+#define F_SMI_DOMN(domain)	F_VAL(domain, 8, 4)
+#define F_SMI_DOMN_VAL(regval)	F_MSK_SHIFT(regval, 8, 4)
+#endif
+#endif
