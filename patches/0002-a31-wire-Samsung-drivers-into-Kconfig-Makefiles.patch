+# --- A31 port: IST4050 ---
+obj-$(CONFIG_TOUCHSCREEN_IST4050)	+= imagis/ist4050/
diff --git a/drivers/mfd/Kconfig b/drivers/mfd/Kconfig
index 65c97dd7d..43f1284ea 100644
--- a/drivers/mfd/Kconfig
+++ b/drivers/mfd/Kconfig
@@ -1956,5 +1956,17 @@ config RAVE_SP_CORE
 	  Select this to get support for the Supervisory Processor
 	  device found on several devices in RAVE line of hardware.
 
+
+# --- A31 port: S2MU106 MFD ---
+config MFD_S2MU106
+	bool "SAMSUNG Electronics IF PMIC Series Support"
+	depends on I2C=y
+	select MFD_CORE
+	help
+	  Support for the Samsung Electronics MFD series.
+	  This driver provides common support for accessing the device,
+	  additional drivers must be enabled in order to use the functionality
+	  of the device
+
 endmenu
 endif
diff --git a/drivers/nfc/Kconfig b/drivers/nfc/Kconfig
index 66acf7182..6671d63be 100644
--- a/drivers/nfc/Kconfig
+++ b/drivers/nfc/Kconfig
@@ -59,4 +59,17 @@ source "drivers/nfc/st-nci/Kconfig"
 source "drivers/nfc/nxp-nci/Kconfig"
 source "drivers/nfc/s3fwrn5/Kconfig"
 source "drivers/nfc/st95hf/Kconfig"
+
+# --- A31 port: sec_nfc ---
+config SEC_NFC
+	bool "Samsung NFC driver"
+	default n
+	help
+	  SAMSUNG NFC Driver.
+	  This driver provides support for SAMSUNG NFC products.
+	  You should select your NFC product and interface.
+
+	  Say Y here to compile support for SAMSUNG NFC driver into the
+	  kernel.
+
 endmenu
