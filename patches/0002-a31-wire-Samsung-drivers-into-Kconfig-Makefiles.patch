diff --git a/drivers/input/Kconfig b/drivers/input/Kconfig
index 663466260..33c831b4a 100644
--- a/drivers/input/Kconfig
+++ b/drivers/input/Kconfig
@@ -212,5 +212,19 @@ source "drivers/input/gameport/Kconfig"
 
 endmenu
 
+
+# --- A31 port: sec_cmd/tclm ---
+config INPUT_TOUCHSCREEN_TCLMV2
+	bool "touchscreen tclmv2"
+	depends on I2C
+	help
+	  Say Y here if you need to use tclm.
+
+	  If unsure, say N.
+
+config SEC_DEBUG_TSP_LOG
+	tristate "Support for tsp_msg"
+	default n
+
 endmenu
 
diff --git a/drivers/input/Makefile b/drivers/input/Makefile
index 8ba735782..1a51a0bd9 100644
--- a/drivers/input/Makefile
+++ b/drivers/input/Makefile
@@ -30,3 +30,8 @@ obj-$(CONFIG_MTK_FINGERPRINT_SUPPORT)	+= fingerprint/
 obj-$(CONFIG_INPUT_APMPOWER)	+= apm-power.o
 
 obj-$(CONFIG_RMI4_CORE)		+= rmi4/
+
+# --- A31 port: sec_cmd/tclm ---
+obj-$(CONFIG_INPUT_TOUCHSCREEN)	+= sec_cmd.o
+obj-$(CONFIG_SEC_DEBUG_TSP_LOG) += sec_tsp_log.o
