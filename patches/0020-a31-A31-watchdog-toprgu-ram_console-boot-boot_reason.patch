+static unsigned long long wk_tsk_bind_time[16] = { 0 };	/* max cpu 16 */
+static unsigned long long wk_tsk_kick_time[16] = { 0 };	/* max cpu 16 */
+static char wk_tsk_buf[128] = { 0 };
