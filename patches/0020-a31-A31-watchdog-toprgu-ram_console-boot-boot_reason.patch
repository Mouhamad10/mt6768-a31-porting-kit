+
+void wk_cpu_update_bit_flag(int cpu, int plug_status)
+{
+	if (plug_status == 1) {	/* plug on */
+		spin_lock(&lock);
+		cpus_kick_bit |= (1 << cpu);
+		kick_bit = 0;
+		g_hang_detected = 0;
+		lasthpg_cpu = cpu;
+		lasthpg_act = plug_status;
+		lasthpg_t = sched_clock();
+		spin_unlock(&lock);
+	}
+	if (plug_status == 0) {	/* plug off */
+		spin_lock(&lock);
+		cpus_kick_bit &= (~(1 << cpu));
+		kick_bit = 0;
+		g_hang_detected = 0;
+		lasthpg_cpu = cpu;
+		lasthpg_act = plug_status;
+		lasthpg_t = sched_clock();
+		wk_tsk_bind[cpu] = 0;
+		spin_unlock(&lock);
+	}
+}
