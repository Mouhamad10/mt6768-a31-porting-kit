+static int __init ram_console_save_old(struct ram_console_buffer *buffer,
+		size_t buffer_size)
+{
+	ram_console_old = kmalloc(buffer_size, GFP_KERNEL);
+	if (ram_console_old == NULL) {
+		pr_notice("ram_console: failed to allocate old buffer\n");
+		return -1;
