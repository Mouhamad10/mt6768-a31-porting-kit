+/*
+ * Query if SYSRST has happened.
+ *
+ * Return:
+ * 1: Happened.
+ * 0: Not happened.
+ */
+int mtk_rgu_status_is_sysrst(void)
+{
+	return
+	(__raw_readl(MTK_WDT_STATUS) & MTK_WDT_STATUS_SYSRST_RST) ? 1 : 0;
