export ARCH=arm64 LLVM=1 LLVM_IAS=1 CROSS_COMPILE=aarch64-linux-gnu- CROSS_COMPILE_ARM32=arm-linux-gnueabi-
export KCFLAGS="-Werror=implicit-function-declaration -Werror=implicit-int -Werror=int-conversion -Werror=incompatible-pointer-types -Werror=return-type -Wno-unused-variable -Wno-unused-function -Wno-unused-but-set-variable -Wno-unused-const-variable -Wno-missing-prototypes -Wno-strict-prototypes -Wno-pointer-sign -Wno-sign-compare -Wno-misleading-indentation -Wno-unused-label -Wno-unused-value -Wno-format -Wno-tautological-compare -Wno-parentheses-equality -Wno-gnu-variable-sized-type-not-at-end -Wno-single-bit-bitfield-constant-conversion -Wno-unused-result -Wno-deprecated-non-prototype -Wno-null-pointer-subtraction -Wno-frame-address"
