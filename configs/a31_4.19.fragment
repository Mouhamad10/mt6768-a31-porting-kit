# A31 on 4.19: platform options introduced in the MTK 4.19 tree (values from fire_defconfig)
CONFIG_ENERGY_MODEL=y
CONFIG_MTK_CM_MGR_LEGACY=y
CONFIG_MTK_DEVINFO=y
CONFIG_MTK_LEGACY_THERMAL=y
CONFIG_MTK_PBM=y
CONFIG_MTK_PERF_COMMON=y
CONFIG_MTK_SCHED_BIG_TASK_MIGRATE=y
CONFIG_MTK_SCHED_CPU_PREFER=y
CONFIG_MTK_SCHED_EXTENSION=y
CONFIG_MTK_SCHED_LB_ENHANCEMENT=y
CONFIG_MTK_UART_APDMA=y
CONFIG_PMIC_LBAT_SERVICE=y
CONFIG_MTK_MUSB_DUAL_ROLE=y
CONFIG_MTK_EXTRA_CONN_DRV_BUILD_IN=y
CONFIG_WLAN_DRV_BUILD_IN=y
CONFIG_EXFAT_FS=y
CONFIG_XDP_SOCKETS=y
# Disabled: hang right after "jump to linux kernel" / not needed (see KERNEL_INFO.md)
# CONFIG_UH is not set
# CONFIG_UH_RKP is not set
# CONFIG_RKP_KDP is not set
# CONFIG_KPERFMON is not set
# CONFIG_SAMSUNG_TUI is not set
# Build settings for this toolchain
# CONFIG_WERROR is not set
# CONFIG_LTO_CLANG is not set
CONFIG_LTO_NONE=y
# CONFIG_CFI_CLANG is not set
# CONFIG_TRIM_UNUSED_KSYMS is not set
CONFIG_LOCALVERSION="-a31-4.19"
# CONFIG_LOCALVERSION_AUTO is not set
CONFIG_SECURITY_SELINUX_DEVELOP=y
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y
# MTK 4.19 platform core (fire_defconfig choices)
CONFIG_GENERIC_PHY=y
CONFIG_CPU_THERMAL=y
CONFIG_MTK_HWMON=y
CONFIG_ARM64_ERRATUM_843419=y
CONFIG_ARM64_LSE_ATOMICS=y
CONFIG_ARM64_MODULE_PLTS=y
CONFIG_ARM64_VHE=y
CONFIG_DM_VERITY_AVB=y
CONFIG_HAVE_MTK_ENABLE_GENIEZONE=y
CONFIG_MTK_ENABLE_GENIEZONE=y
CONFIG_HAVE_MTK_GZ_LOG=y
CONFIG_MTK_GZ_MAIN=y
CONFIG_MTK_GZ_LOG=y
CONFIG_MTK_GZ_VIRTIO=y
CONFIG_MTK_GZ_VIRTIO_IPC=y
CONFIG_MTK_GZ_IRQ=y
CONFIG_TRUSTY_INTERRUPT_MAP=y
CONFIG_TRUSTY_INTERRUPT_FIQ_ONLY=y
CONFIG_MTK_AAL_SUPPORT=y
CONFIG_MTK_FPSGO_V3=y
CONFIG_MTK_TASK_TURBO=y
CONFIG_MTK_LOAD_TRACKER=y
CONFIG_MTK_CPU_CTRL_CFP=y
CONFIG_TRUSTONIC_TEE_SUPPORT=y
CONFIG_TRUSTONIC_TEE_VERSION="410"
CONFIG_TRUSTONIC_TRUSTED_UI=y
CONFIG_MTK_TEE_GP_SUPPORT=y
CONFIG_SEC_NFC=y
CONFIG_SUPPORT_WAKEUP_REGISTER=y
# eMMC: MediaTek proprietary host driver (as stock A31)
# CONFIG_MMC_MTK is not set
CONFIG_MMC_MTK_PRO=y
CONFIG_NFC=y
CONFIG_ALWAYS_PERMISSIVE=y
CONFIG_STACKPROTECTOR=y
CONFIG_STACKPROTECTOR_STRONG=y
CONFIG_A31_LEGACY_TIMER_API=y
# CONFIG_MTK_EMMC_HW_CQ is not set
# CONFIG_SEC_DEBUG_AUTO_COMMENT is not set
# CONFIG_MTK_CM_MGR is not set
# CONFIG_MEDIATEK_WATCHDOG is not set
# CONFIG_EXTCON_MTK_USB is not set
# CONFIG_MMC_CQHCI is not set
# CONFIG_SEC_DEBUG_INIT_LOG is not set
CONFIG_MEDIATEK_SOLUTION=y
CONFIG_MTK_WATCHDOG=y
CONFIG_MTK_WATCHDOG_COMMON=y
CONFIG_MTK_WATCHDOG_COMMON_V2=y
CONFIG_MTK_WD_KICKER=y
CONFIG_MTK_RAM_CONSOLE=y
CONFIG_MTK_BOOT=y
CONFIG_MTK_BOOT_REASON=y
CONFIG_MTK_CHIP=y
# CONFIG_MTK_AEE_HANGDET is not set
